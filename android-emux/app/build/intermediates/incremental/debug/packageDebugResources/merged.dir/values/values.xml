    <string name="bootstrap_prompt">Install the Linux environment (Alpine minirootfs, ~3 MB)? Runs once; scheduled when charging or idle.</string>
    <string name="bootstrap_prompt_fresh">Install %1$s (%2$s)? Runs once — the built-in X11 desktop installs with it.</string>
    <string name="bootstrap_prompt_switch">Install %1$s (%2$s)? Your other installed distro(s) stay on disk: %3$s. The active distro powers both the Terminal and Desktop tabs.</string>
