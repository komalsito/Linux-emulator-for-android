#!/system/bin/sh
# emux-x11 WM — start Xvfb (or real Xorg under root) + window manager inside distro.
WM="${1:-openbox}"
RES="${EMUX_X_RES:-720x1280x24}"
export HOME="${HOME:-/root}"
# v0.1.22 BUGFIX (desktop helpers could NEVER exec at all — black pane forever):
# this script starts with #!/system/bin/sh because it runs OUTSIDE the chroot,
# but musl binaries (Xvfb, openbox, xwd…) executed from here died instantly with
#   CANNOT LINK EXECUTABLE: cannot locate symbol "__sF"…
# The minirootfs ships its libc as lib/ld-musl-*.so.1 — a combined LOADER+libc
# that bionic's linker cannot satisfy directly. Alpine's standard trick: create
# /lib/ld-musl-*.so.1 -> ../usr/lib/libc.so symlinks so the PT_INTERP resolves
# through the real loader. We can't write to Android's /lib, so we build the
# equivalent bridge inside the rootfs and point every child at it via
# LD_LIBRARY_PATH. Without this, EVERY desktop launch failed regardless of the
# earlier PATH/rootfs-path fixes.
ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  for L in "$ROOT"/lib/ld-musl-*.so.1; do
    [ -e "$L" ] || continue
    B=$(basename "$L")
    [ -e "$ROOT/lib/$B" ] || ln -sf ../usr/lib/libc.so "$ROOT/lib/$B" 2>/dev/null
  done
  export LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ "$(id -u)" = "0" ] && [ -x /usr/bin/Xorg ]; then
  Xorg :0 -config /etc/X11/emux-xorg.conf &
else
  # v0.1.21 BUGFIX (black desktop forever): the old guard was `[ -x /usr/bin/Xvfb ]`
  # — but these helper scripts run OUTSIDE any chroot, so that path is ANDROID's
  # /usr (which never exists on Android), making the check ALWAYS false. Every
  # single desktop launch therefore ran `apk add --no-cache xorg-server-xvfb
  # openbox xterm` first: apk cannot install into a non-bootstrapped Android
  # view of the world, usually hung on its own network call for tens of seconds
  # and then silently failed (output redirected to /dev/null) → Xvfb exec'd,
  # died with "not found", port 6000 never opened, pane stayed black. Test the
  # REAL target: the binary inside the distro rootfs.
  XVFB="$ROOT/usr/bin/Xvfb"
  [ -n "$ROOT" ] || ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
  [ -x "$XVFB" ] || XVFB="${ROOT}/usr/bin/Xvfb"
  if [ ! -x "$XVFB" ]; then
    echo "emux-x11: Xvfb missing in $ROOT/usr/bin — installing (needs network, may take a minute)" >&2
    apk add --no-cache xorg-server-xvfb openbox xterm >&2
  fi
  # v0.1.17 BUGFIX (desktop blank): "-nolisten tcp" made Xvfb refuse TCP, but the
  # Android-side X11Client talks over loopback TCP :6000 — waitForPort(6000) could
  # therefore NEVER succeed and the desktop died in State.ERROR every time.
  # "-listen tcp" enables it (loopback-only server; no external exposure).
  mkdir -p /tmp/.X11-unix
  # v0.1.20 BUGFIX (control plane refused): "-auth /tmp/xauth" pointed at an
  # EMPTY file, so X required a MIT-MAGIC-COOKIE the Android X11Client never
  # sends → setup reply was "Access denied" even though TCP :6000 opened and
  # waitForPort succeeded. "-ac" disables access control entirely (safe: the
  # server is only reachable from this device's own loopback). Also clear a
  # stale lock left by a killed previous attempt, which makes Xvfb exit with
  # "server already running" forever after any crash.
  rm -f /tmp/.X0-lock 2>/dev/null
  "$XVFB" :0 -screen 0 "$RES" -listen tcp -ac >/tmp/xvfb.log 2>&1 &
fi
XPID=$!
# v0.1.22 BUGFIX (black desktop): the old wait loop tested /tmp/.X11-unix/X0 —
# but these helpers run OUTSIDE any chroot, so that's ANDROID's /tmp, where the
# DISTRO Xvfb never creates a socket (it writes $ROOT/tmp/.X11-unix/X0). The
# loop always burned its full 15 s and then continued blindly even when Xvfb
# had died seconds earlier ("Address already in use" from a stale lock, or a
# musl link error) — every later step failed silently. Wait on the REAL socket
# path under TMPDIR, and fail loudly with the captured xvfb.log if it never
# appears so the terminal tab shows the actual reason instead of a black pane.
XD="${TMPDIR:-/tmp}"
mkdir -p "$XD/.X11-unix" 2>/dev/null
i=0; while [ ! -e "$XD/.X11-unix/X0" ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); done
if [ ! -e "$XD/.X11-unix/X0" ]; then
  echo "emux-x11: Xvfb did not create $XD/.X11-unix/X0 within 15s — log follows:" >&2
  cat /tmp/xvfb.log "$ROOT/tmp/xvfb.log" 2>/dev/null | tail -20 >&2
fi
export DISPLAY=:0
# enable local connections for the Android-side X11 client (loopback only)
for c in "$ROOT/usr/bin/xhost" /usr/bin/xhost "$(command -v xhost 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$c" +local: >/dev/null 2>&1; break; }
done
# v0.1.17: if the configured WM is missing (fresh rootfs has no openbox), fall
# back through installed WMs to xterm so SOMETHING always draws on screen.
# v0.1.21 BUGFIX (black desktop): command -v looked in ANDROID's PATH (outside
# chroot) — openbox/twm/icewm were NEVER found, and the fallback exec'd bare
# `xterm` which also does not exist on Android, so NOTHING ever drew on the
# X server even though Xvfb was up. Resolve each candidate inside the rootfs
# first, and make sure SOMETHING is displayed: when no WM is installed we grab
# the root window directly (xwd works without any client) and install a minimal
# xterm login shell only if that package really exists in the distro.
run_wm() {
  for c in "$ROOT/usr/bin/$1" "/usr/bin/$1" "$(command -v "$1" 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$c" >/tmp/wm.log 2>&1 & return 0; }
  done
  return 1
}
ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-$ROOT}}"
# v0.1.22 BUGFIX (black desktop): the WM check `[ $i -lt 150 ]` loop above now
# fails loudly, but we ALSO must not skip the WM when Xvfb came up: previously a
# missing openbox silently fell through to xterm which was also absent → nothing
# ever drew on the root window and capture streamed a black frame forever. When
# no WM exists at all, draw SOMETHING ourselves via a distro xterm if present;
# otherwise print a clear hint (openbox/xterm can be installed with apk) so the
# user knows why the pane is empty instead of guessing.
run_wm "$WM" || run_wm openbox || run_wm twm || run_wm icewm || {
  XT=""
  for c in "$ROOT/usr/bin/xterm" /usr/bin/xterm "$(command -v xterm 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { XT="$c"; break; }
  done
  if [ -n "$XT" ]; then
    LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$XT" -e /bin/sh -l >/tmp/wm.log 2>&1 &
  else
    echo "emux-x11: no window manager found ($WM/openbox/twm/icewm) and no xterm — install one with: apk add openbox xterm" >&2
  fi
}
wait $XPID
