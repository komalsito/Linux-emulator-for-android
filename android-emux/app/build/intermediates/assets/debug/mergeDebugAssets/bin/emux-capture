#!/bin/sh
# emux-capture HOST:PORT — push framebuffer frames to the Android UI.
# v0.1.17 REWRITE (desktop showed nothing): the previous version was a literal
# pseudocode stub — its loop body contained "..." so it NEVER sent a single
# frame byte; `nc -q0` closed the socket right after the header, and W/H were
# parsed from a combined "WxH" string. The Kotlin reader blocked forever in
# accept()/readFully with zero frames. This implementation is real end-to-end:
#   header : 'EMUX' | width u16 LE | height u16 LE | format u8 | flags u8
#   frame  : seq u32 LE | dirtyW u16 | dirtyH u16 | x u16 | y u16 | rgb565 rows
TARGET="${1:-127.0.0.1:7001}"
HOST="${TARGET%%:*}"; PORT="${TARGET##*:}"
export DISPLAY="${DISPLAY:-:0}"

# --- wait for the X server (emux-x11 starts it asynchronously) ---------------
i=0
while [ ! -e /tmp/.X11-unix/X0 ] && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done

# --- toolchain ----------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }
if ! have ffmpeg || ! have xdpyinfo; then
  apk add --no-cache ffmpeg x11-utils >/dev/null 2>&1
fi
if ! have ffmpeg; then
  echo "emux-capture: ffmpeg unavailable" >&2; exit 1
fi

# --- geometry -----------------------------------------------------------------
GEOM=$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}')
W=$(echo "$GEOM" | cut -dx -f1); H=$(echo "$GEOM" | cut -dx -f2)
[ -n "$W" ] && [ -n "$H" ] || { echo "emux-capture: cannot read display geometry" >&2; exit 1; }

# --- connect to the Android frame listener ------------------------------------
# busybox ash (Alpine /bin/sh) supports exec N<>/dev/tcp/HOST/PORT. If this
# shell variant doesn't, fall back to netcat kept OPEN through a named pipe
# (the old code's `nc -q0` closed the socket immediately — that path is gone).
FIFO=/tmp/emux_cap_fifo
ok=0
if eval 'exec 3<>"/dev/tcp/$HOST/$PORT"' 2>/dev/null; then ok=1
else
  i=0
  until eval 'exec 3<>"/dev/tcp/$HOST/$PORT"' 2>/dev/null; do
    i=$((i+1))
    if [ $i -gt 25 ]; then break; fi
    sleep 0.2
  done
  [ "$i" -le 25 ] && ok=1
fi
if [ "$ok" = 0 ]; then
  rm -f "$FIFO"; mkfifo "$FIFO" || { echo "emux-capture: no tcp transport" >&2; exit 1; }
  nc "$HOST" "$PORT" < "$FIFO" >/dev/null 2>&1 &
  exec 3>"$FIFO"
fi

# --- little-endian byte writers ------------------------------------------------
# Pure-busybox-safe: build a printf FORMAT STRING containing \xHH escapes, then
# emit it. busybox printf interprets \xHH inside formats; the format string is
# generated by sh arithmetic so no bashism is involved anywhere.
u16le() { printf "$(printf '\\x%02x\\x%02x' $(($1 & 255)) $((($1 >> 8) & 255)))"; }
u32le() { printf "$(printf '\\x%02x\\x%02x\\x%02x\\x%02x' \
  $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"; }

# --- header: EMUX + W/H LE + format(0=rgb565) + flags(0) -----------------------
{ printf 'EMUX'; u16le "$W"; u16le "$H"; printf '\x00\x00'; } >&3 || exit 0

# --- frame pump ---------------------------------------------------------------
TMP=/tmp/emux_frame.rgb
seq=0
while :; do
  # grab one full-frame RGB565LE image straight off the X display
  if ! ffmpeg -hide_banner -loglevel error -f x11grab -video_size "${W}x${H}" \
       -i "$DISPLAY" -frames:v 1 -pix_fmt rgb565le -f rawvideo "$TMP" 2>/dev/null; then
    sleep 0.3; continue
  fi
  [ -s "$TMP" ] || { sleep 0.3; continue; }
  { u32le "$seq"; u16le "$W"; u16le "$H"; u16le 0; u16le 0; cat "$TMP"; } >&3 || exit 0
  seq=$((seq+1))
  sleep 0.1   # ~10 fps cap — plenty for a WM desktop, battery-friendly
done
