#!/bin/sh
# emux-capture HOST:PORT — push framebuffer frames to the Android UI.
# v0.1.17 REWRITE (desktop showed nothing): the previous version was a literal
# pseudocode stub — its loop body contained "..." so it NEVER sent a single
# frame byte; `nc -q0` closed the socket right after the header, and W/H were
# parsed from a combined "WxH" string. The Kotlin reader blocked forever in
# accept()/readFully with zero frames. This implementation is real end-to-end:
#   header : 'EMUX' | width u16 LE | height u16 LE | format u8 | flags u8
#   frame  : seq u32 LE | dirtyW u16 | dirtyH u16 | x u16 | y u16 | rgb565 rows
TARGET="${1:-127.0.0.1:7001}"
HOST="${TARGET%%:*}"; PORT="${TARGET##*:}"
export DISPLAY="${DISPLAY:-:0}"

# v0.1.20 BUGFIX (desktop showed nothing): the Android-side frame reader parses
# a 10-byte frame header (seq u32 | dw u16 | dh u16 | x u16 | y u16) followed by
# exactly dw*dh*2 payload bytes. The old pump emitted a 12-byte prefix and then
# FULL-FRAME payloads even for partial dirty rects → every read desynchronized,
# dw/dh decoded as garbage, and the loop `continue`d forever on black frames.
# The protocol is now FIXED-SIZE end-to-end: always W,H from the stream header,
# always W*H*2 payload bytes per frame. (The Kotlin reader was updated to match.)

# --- wait for the X server (emux-x11 starts it asynchronously) ---------------
i=0
while [ ! -e /tmp/.X11-unix/X0 ] && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done

# --- toolchain ----------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }
# v0.1.20: ffmpeg is NOT in Alpine's main repo (it lives in community), so the
# old "apk add ffmpeg" silently failed on fresh rootfs and capture exited with
# "ffmpeg unavailable" — zero frames, black pane, no explanation. We now use the
# much smaller `xwd` (x11-apps) + netpbm `pnmtoplainpnm`, and fall back through
# several candidates before giving up loudly.
if ! have xwd || ! have pnmtoplainpnm; then
  apk add --no-cache x11-apps netpbm >/dev/null 2>&1
fi
if ! have xwd; then
  # last resort: try ffmpeg again (some images ship it via community)
  apk add --no-cache ffmpeg >/dev/null 2>&1
fi
if ! have xwd && ! have ffmpeg; then
  echo "emux-capture: no grabber available (apk add x11-apps netpbm failed)" >&2
  exit 1
fi

# --- geometry -----------------------------------------------------------------
GEOM=$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}')
W=$(echo "$GEOM" | cut -dx -f1); H=$(echo "$GEOM" | cut -dx -f2)
[ -n "$W" ] && [ -n "$H" ] || { echo "emux-capture: cannot read display geometry" >&2; exit 1; }

# --- connect to the Android frame listener ------------------------------------
ok=0
i=0
until eval 'exec 3<>"/dev/tcp/$HOST/$PORT"' 2>/dev/null; do
  i=$((i+1))
  if [ $i -gt 150 ]; then break; fi
  sleep 0.2
done
[ $i -le 150 ] && ok=1
if [ "$ok" = 0 ]; then
  echo "emux-capture: cannot reach Android frame port $PORT" >&2; exit 1
fi

# --- little-endian byte writers ------------------------------------------------
u16le() { printf "$(printf '\\x%02x\\x%02x' $(($1 & 255)) $((($1 >> 8) & 255)))"; }
u32le() { printf "$(printf '\\x%02x\\x%02x\\x%02x\\x%02x' \\
  $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"; }

# --- header: EMUX + W/H LE + format(0=rgb565) + flags(0) -----------------------
{ printf 'EMUX'; u16le "$W"; u16le "$H"; printf '\\x00\\x00'; } >&3 || exit 0

# --- frame pump (FIXED-SIZE protocol, v0.1.20) ---------------------------------
# Every frame is exactly: seq u32 | W u16 | H u16 | 0 u16 | 0 u16  (10 bytes)
# followed by exactly W*H*2 bytes of RGB565 little-endian pixels.
# Grab path: xwd -root -silent | pnmtoplainpnm -> PPM text -> tiny awk converter
# to raw rgb565le. If xwd/pnm unavailable, fall back to ffmpeg single-frame grab.
TMP=/tmp/emux_frame.ppm
RAW=/tmp/emux_frame.rgb
seq=0
grab_frame() {
  if have xwd && have pnmtoplainpnm; then
    xwd -root -silent 2>/dev/null | pnmtoplainpnm 2>/dev/null > "$TMP" || return 1
    [ -s "$TMP" ] || return 1
    # P6 conversion from P3 plain PPM: parse header, emit rgb565le raw bytes.
    awk -v OFS=' ' '
      BEGIN{FS=" "; mode=0}
      mode==0 && /^P3$/{mode=1; next}
      mode==1 { getline_max=NF; if(NF>=3){W=$1;H=$2;MX=$3;mode=2;next} }
      mode==2 {
        for(i=1;i<=NF;i++){
          r=$i; g=$(i+1); b=$(i+2); i+=2
          v=((r*31/255)<<11)|((g*63/255)<<5)|((b*31)/255)
          printf "%c%c", v%256, int(v/256)%256
        }
      }
    ' "$TMP" > "$RAW" 2>/dev/null
    [ "$(wc -c < "$RAW")" -eq $((W*H*2)) ] || return 1
    return 0
  fi
  ffmpeg -hide_banner -loglevel error -f x11grab -video_size "${W}x${H}"     -i "$DISPLAY" -frames:v 1 -pix_fmt rgb565le -f rawvideo "$RAW" 2>/dev/null
  [ "$(wc -c < "$RAW")" -eq $((W*H*2)) ]
}

while :; do
  if ! grab_frame; then sleep 0.3; continue; fi
  { u32le "$seq"; u16le "$W"; u16le "$H"; u16le 0; u16le 0; cat "$RAW"; } >&3 || exit 0
  seq=$((seq+1))
  sleep 0.1   # ~10 fps cap — plenty for a WM desktop, battery-friendly
done
