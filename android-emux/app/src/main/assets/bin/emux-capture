#!/bin/sh
# emux-capture HOST:PORT - push framebuffer frames to the Android UI.
#
# v0.1.28 REWRITE. Three verified bug classes fixed:
#  1. PROTOCOL: stream header is now EXACTLY 8 bytes (EMUX + w u16le + h u16le)
#     matching DesktopService.beginFrameLoop, which reads ByteArray(8). The old
#     script sent 4+2+2 plus a pad written as printf '\\x00\\x00' - the DOUBLE
#     backslashes made toybox printf emit the 8 ASCII characters \x00\xx00, so
#     the header was 16 bytes on the wire and every frame desynchronized
#     (black desktop forever).
#  2. CONVERTER: busybox awk REJECTS bitwise operators (<< and |) with
#     "Unexpected token" (verified against Alpine 3.20 busybox 1.36.1) - the old
#     P3->RGB565 awk could never run. Replaced with pure arithmetic
#     (r5*2048 + g6*32 + b5) and %c byte emission (verified: busybox awk prints
#     raw bytes incl. NUL for numeric %c).
#  3. PARSER: pnmtoplainpnm (pamtopnm -plain) emits "W H" and the maxval on
#     SEPARATE lines and 4 pixels per line - the old line-oriented header
#     parser (NF>=3 on one line) never matched and ate the first pixel row.
#     The new parser is a proper token stream (verified byte-exact against a
#     synthetic P3, including NUL pixels).
#
# Wire protocol (fixed-size frames, little-endian):
#   stream header : 'EMUX' | width u16 | height u16                     (8 B)
#   frame         : seq u32 | w u16 | h u16 | x u16 | y u16            (12 B)
#                   + w*h*2 bytes of RGB565 (R11 G6 B5, LE per pixel)
#
# Runs INSIDE the distro (proot/chroot). Host-mode invocation re-execs via the
# bundled proot, exactly like emux-x11.
TARGET="${1:-127.0.0.1:7001}"
HOST="${TARGET%%:*}"; PORT="${TARGET##*:}"

ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  NB="${EMUX_NATIVE_BRIDGE:-}"
  if [ -x "$NB/proot" ]; then
    mkdir -p "$ROOT/tmp" 2>/dev/null
    LD_LIBRARY_PATH="$NB" HOME=/root PROOT_TMP_DIR="$ROOT/tmp" \
    PROOT_LOADER="$NB/loader" exec "$NB/proot" -0 -r "$ROOT" \
      -b /dev -b /proc -b /sys -w /root \
      /bin/sh -l -c "unset EMUX_ROOTFS EMUX_ROOT EMUX_NATIVE_BRIDGE; exec /usr/local/bin/emux-capture $HOST:$PORT"
  fi
  echo "emux-capture: bundled proot missing at $NB/proot - tap Install to re-seed (or use root chroot mode)." >&2
  exit 1
fi

# ---------------- inside the distro (proot / chroot) ----------------
export DISPLAY="${DISPLAY:-:0}"
export TMPDIR=/tmp

# wait for the X server socket (emux-x11 starts it asynchronously)
i=0
while [ ! -e /tmp/.X11-unix/X0 ] && [ "$i" -lt 300 ]; do sleep 0.1; i=$((i+1)); done
[ -e /tmp/.X11-unix/X0 ] || { echo "emux-capture: X socket /tmp/.X11-unix/X0 never appeared" >&2; exit 1; }

# toolchain: xwd (grab) + pnmtoplainpnm (PPM text) + awk (RGB565) + nc (push)
XWD=""; PNM=""; NC=""
for c in /usr/bin/xwd /usr/local/bin/xwd; do [ -x "$c" ] && { XWD="$c"; break; }; done
for c in /usr/bin/pnmtoplainpnm /usr/local/bin/pnmtoplainpnm; do [ -x "$c" ] && { PNM="$c"; break; }; done
for c in /bin/nc /usr/bin/nc; do [ -x "$c" ] || [ -L "$c" ] && { NC="$c"; break; }; done
if [ -z "$XWD" ] || [ -z "$PNM" ]; then
  # v0.1.47 multi-distro: xwd lives in x11-apps on Debian/Ubuntu (xwd pkg on
  # Alpine); pnmtoplainpnm is netpbm on both families.
  echo "emux-capture: installing xwd+netpbm via the distro package manager (one time, needs network)" >&2
  if command -v apt-get >/dev/null 2>&1; then
    # v0.1.57: heal dpkg FIRST (the old bare configure -a cannot fix a dirty
    # journal or the proot link(2) backup bug, so this install used to die
    # and the desktop sat at "waiting for X frames" with Xvfb running fine).
    if [ -x /usr/local/bin/emux-apt-repair ]; then
      emux-apt-repair >&2 || true
    else
      dpkg --configure -a >&2 || true
    fi
    apt-get update >&2
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends x11-apps netpbm >&2
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed xorg-xwd netpbm >&2
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y --skip-broken install xorg-x11-apps netpbm >&2
  else
    apk add --no-cache xwd netpbm >&2
  fi
  [ -x /usr/bin/xwd ] && XWD=/usr/bin/xwd
  [ -x /usr/bin/pnmtoplainpnm ] && PNM=/usr/bin/pnmtoplainpnm
fi
if [ -z "$XWD" ] || [ -z "$PNM" ]; then
  echo "emux-capture: no grabber available (xwd/pnmtoplainpnm missing, apk add failed)" >&2
  exit 1
fi
if [ -z "$NC" ]; then
  # v0.1.47 multi-distro: netcat-openbsd exists under the same name on Alpine
  # and Debian/Ubuntu; apt installs it via alternatives to /usr/bin/nc.
  if command -v apt-get >/dev/null 2>&1; then
    [ -x /usr/local/bin/emux-apt-repair ] && emux-apt-repair >&2 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y netcat-openbsd >&2
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed openbsd-netcat >&2
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y install nmap-ncat >&2
  else
    apk add --no-cache netcat-openbsd >&2
  fi
  for c in /usr/bin/nc /bin/nc; do { [ -x "$c" ] || [ -L "$c" ]; } && { NC="$c"; break; }; done
fi
[ -n "$NC" ] || { echo "emux-capture: no TCP client (nc) available" >&2; exit 1; }

TMPF=/tmp/emux_frame.p3
RAW=/tmp/emux_frame.rgb

grab_frame() {
  "$XWD" -root -silent 2>/dev/null | "$PNM" 2>/dev/null > "$TMPF" || return 1
  [ -s "$TMPF" ] || return 1
  awk '
    BEGIN{ st=0; hn=0; px=0; MX=255 }
    /^#/{ next }
    {
      for(i=1;i<=NF;i++){
        t=$i
        if(st==0){ if(t=="P3") st=1; continue }
        if(st==1){
          hn++
          if(hn==1) W=t+0
          else if(hn==2) H=t+0
          else { MX=t+0; if(MX<1) MX=255; st=2 }
          continue
        }
        buf[px++]=t+0
        if(px==3){
          v = int(buf[0]*31/MX)*2048 + int(buf[1]*63/MX)*32 + int(buf[2]*31/MX)
          printf "%c%c", v%256, int(v/256)
          px=0
        }
      }
    }' "$TMPF" > "$RAW" 2>/dev/null || return 1
  [ -s "$RAW" ] || return 1
  return 0
}

# first successful grab defines the TRUE geometry (parsed from the P3 header,
# so an EMUX_X_RES mismatch can never desync the size check below)
tries=0
until grab_frame; do
  tries=$((tries+1))
  [ $tries -ge 100 ] && { echo "emux-capture: initial grab failed 100x - is DISPLAY=$DISPLAY alive?" >&2; exit 1; }
  sleep 0.3
done
DIMS=$(sed -e '/^#/d' "$TMPF" | awk 'NR==1{next} NF>=2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {print $1" "$2; exit}')
W="${DIMS% *}"; H="${DIMS#* }"
case "$W$H" in (*[!0-9]*|"") echo "emux-capture: cannot read display geometry from P3 header" >&2; exit 1;; esac

# persistent push channel: ONE background nc draining a FIFO (the Android side
# accepts a SINGLE connection for the whole session)
FIFO=/tmp/emux_cap.fifo
rm -f "$FIFO" 2>/dev/null
mkfifo "$FIFO" 2>/dev/null || FIFO=""
if [ -n "$FIFO" ]; then
  "$NC" "$HOST" "$PORT" <"$FIFO" >/dev/null 2>&1 &
  PUMPID=$!
  exec 3>"$FIFO"
  SINK=3
else
  SINK=0   # per-frame mode (degraded; the single-accept server may drop frames)
fi

send_bytes() {
  if [ "$SINK" = 3 ]; then cat >&3; else "$NC" "$HOST" "$PORT" 2>/dev/null; fi
}

# little-endian byte writers: the INNER printf builds an octal-escape format
# (\NNN), the OUTER printf emits the raw bytes (v0.1.26 technique, verified).
u16le() { printf "$(printf '\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)))"; }
u32le() { printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \
  $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"; }

# stream header: EXACTLY 8 bytes
{ printf EMUX; u16le "$W"; u16le "$H"; } | send_bytes || true

seq=0
fails=0
while :; do
  if ! grab_frame; then
    fails=$((fails+1))
    [ $fails -ge 50 ] && { echo "emux-capture: 50 consecutive frame grabs failed - is DISPLAY=$DISPLAY alive?" >&2; exit 1; }
    sleep 0.3; continue
  fi
  fails=0
  if [ "$(wc -c < "$RAW")" -ne $((W*H*2)) ]; then sleep 0.3; continue; fi
  { u32le "$seq"; u16le "$W"; u16le "$H"; u16le 0; u16le 0; cat "$RAW"; } | send_bytes || {
    [ "$SINK" = 3 ] && { echo "emux-capture: push channel closed (Android side gone)" >&2; exit 0; }
  }
  seq=$((seq+1))
  sleep 0.1   # ~10 fps cap - plenty for a WM desktop, battery-friendly
done
