#!/bin/sh
# emux-capture HOST:PORT - push framebuffer frames to the Android UI.
#
# v0.1.28 REWRITE. Three verified bug classes fixed:
#  1. PROTOCOL: stream header is now EXACTLY 8 bytes (EMUX + w u16le + h u16le)
#     matching DesktopService.beginFrameLoop, which reads ByteArray(8). The old
#     script sent 4+2+2 plus a pad written as printf '\\x00\\x00' - the DOUBLE
#     backslashes made toybox printf emit the 8 ASCII characters \x00\xx00, so
#     the header was 16 bytes on the wire and every frame desynchronized
#     (black desktop forever).
#  2. CONVERTER: busybox awk REJECTS bitwise operators (<< and |) with
#     "Unexpected token" (verified against Alpine 3.20 busybox 1.36.1) - the old
#     P3->RGB565 awk could never run. Replaced with pure arithmetic
#     (r5*2048 + g6*32 + b5) and %c byte emission (verified: busybox awk prints
#     raw bytes incl. NUL for numeric %c).
#  3. PARSER: pnmtoplainpnm (pamtopnm -plain) emits "W H" and the maxval on
#     SEPARATE lines and 4 pixels per line - the old line-oriented header
#     parser (NF>=3 on one line) never matched and ate the first pixel row.
#     The new parser is a proper token stream (verified byte-exact against a
#     synthetic P3, including NUL pixels).
#
# Wire protocol (fixed-size frames, little-endian):
#   stream header : 'EMUX' | width u16 | height u16                     (8 B)
#   frame         : seq u32 | w u16 | h u16 | x u16 | y u16            (12 B)
#                   + w*h*2 bytes of RGB565 (R11 G6 B5, LE per pixel)
#
# Runs INSIDE the distro (proot/chroot). Host-mode invocation re-execs via the
# bundled proot, exactly like emux-x11.
# v0.1.81: PATH sanity (same lesson as emux-x11): a capture session that
# starts mid-dpkg-transaction sources /etc/profile while coreutils files
# are being swapped ("/bin/sh: 12: id: not found" pane noise) and can
# inherit a garbled PATH; pin the distro dirs so xwd/pnm/nc always resolve.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH
TARGET="${1:-127.0.0.1:7001}"
# v0.2.76: mailbox mode - third arg "mail": write /tmp/emux_frame.rgb
# and publish, but NEVER nc-push (the push is the stage that wedged proot
# sockets for ten versions; the Android side reads the file directly).
MAILMODE=$([ "$3" = "mail" ] && echo 1 || echo 0)
HOST="${TARGET%%:*}"; PORT="${TARGET##*:}"

ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  NB="${EMUX_NATIVE_BRIDGE:-}"
  if [ -x "$NB/proot" ]; then
    mkdir -p "$ROOT/tmp" 2>/dev/null
    LD_LIBRARY_PATH="$NB" HOME=/root PROOT_TMP_DIR="$ROOT/tmp" \
    PROOT_LOADER="$NB/loader" exec "$NB/proot" -0 -r "$ROOT" \
      -b /dev -b /proc -b /sys -w /root \
      /bin/sh -l -c "unset EMUX_ROOTFS EMUX_ROOT EMUX_NATIVE_BRIDGE; exec /usr/local/bin/emux-capture $HOST:$PORT ${2:-0} ${3:-}"
  fi
  echo "emux-capture: bundled proot missing at $NB/proot - tap Install to re-seed (or use root chroot mode)." >&2
  exit 1
fi

# ---------------- inside the distro (proot / chroot) ----------------
# v0.2.5 FIELD FIX: display number from the app (2nd arg); the preflight
# below tries the SESSION display FIRST so frames can never be grabbed
# from a stale zombie server left on :0 by an earlier app life.
DN="${2:-0}"
# v0.2.6 FIELD FIX: the session may have rotated displays (occupied
# sockets from unkillable zombies); emux-x11 publishes the display it
# actually runs on. Trust the file over the launch argument.
if [ -r /tmp/emux_display_num ]; then
  FD="$(tr -dc '0-9' < /tmp/emux_display_num 2>/dev/null)"
  [ -n "$FD" ] && DN="$FD"
fi
XP=$((6000 + DN))
export DISPLAY="${DISPLAY:-:$DN}"
export TMPDIR=/tmp

# wait for the X server (emux-x11 starts it asynchronously).
# v0.1.92: accept tcp 6000 as well as the X0 socket - since v0.1.86 Xvfb can
# run tcp-ONLY (-nolisten unix), in which case /tmp/.X11-unix/X0 NEVER
# exists and this wait spun out its whole 30 s (300 proot'd sleep 0.1 execs)
# and died, respawn after respawn, while X served happily: black pane with
# a healthy server (v0.1.91 field). 1 s granularity also cuts proot exec
# overhead 10x while waiting.
cap_tcp_open() {
  if command -v nc >/dev/null 2>&1; then nc -z 127.0.0.1 "$XP" 2>/dev/null; return $?; fi
  if [ -x /bin/bash ]; then /bin/bash -c "exec 3<>/dev/tcp/127.0.0.1/$XP" 2>/dev/null; return $?; fi
  return 1
}
cap_x_up() { [ -e /tmp/.X11-unix/X$DN ] || cap_tcp_open; }
i=0
while ! cap_x_up && [ "$i" -lt 90 ]; do sleep 1; i=$((i + 1)); done
if ! cap_x_up; then
  echo "emux-capture: X never reachable (no /tmp/.X11-unix/X$DN, tcp $XP closed)" >&2
  exit 1
fi
echo "emux-capture: X reachable - starting frame pipeline" >&2

# toolchain: xwd (grab) + pnmtoplainpnm (PPM text) + awk (RGB565) + nc (push)
XWD=""; PNM=""; NC=""
for c in /usr/bin/xwd /usr/local/bin/xwd; do [ -x "$c" ] && { XWD="$c"; break; }; done
for c in /usr/bin/pnmtoplainpnm /usr/local/bin/pnmtoplainpnm; do [ -x "$c" ] && { PNM="$c"; break; }; done
# v0.1.60 CRITICAL: xwd emits XWD format, which pnmtoplainpnm CANNOT read
# ("pamtopnm: bad magic number") - the converter xwdtopnm (same netpbm
# package) must sit between them. Without it grab_frame produced 0 bytes,
# nc never connected and the pane sat at "waiting for X frames" forever
# even with a perfectly healthy X server (sandbox-verified on the pinned
# Ubuntu noble image).
X2P=""
for c in /usr/bin/xwdtopnm /usr/local/bin/xwdtopnm; do [ -x "$c" ] && { X2P="$c"; break; }; done
for c in /bin/nc /usr/bin/nc; do [ -x "$c" ] || [ -L "$c" ] && { NC="$c"; break; }; done
if [ -z "$XWD" ] || [ -z "$PNM" ]; then
  # v0.1.47 multi-distro: xwd lives in x11-apps on Debian/Ubuntu (xwd pkg on
  # Alpine); pnmtoplainpnm is netpbm on both families.
  echo "emux-capture: installing xwd+netpbm via the distro package manager (one time, needs network)" >&2
  # v0.1.58: wait out a foreign dpkg/apt first - installing against a live
  # transaction is what corrupts journals and produces "dpkg was interrupted".
  i=0
  while [ "$i" -lt 30 ]; do
    BUSTY=0
    for f in /proc/[0-9]*/cmdline; do
      c=$(tr "\0" " " < "$f" 2>/dev/null)
      case "$c" in *dpkg*|*apt-get*) BUSTY=1; break ;; esac
    done
    [ "$BUSTY" = 0 ] && break
    i=$((i + 1)); sleep 5
  done
  if command -v apt-get >/dev/null 2>&1; then
    # v0.1.57: heal dpkg FIRST (the old bare configure -a cannot fix a dirty
    # journal or the proot link(2) backup bug, so this install used to die
    # and the desktop sat at "waiting for X frames" with Xvfb running fine).
    if [ -x /usr/local/bin/emux-apt-repair ]; then
      emux-apt-repair >&2 || true
    else
      dpkg --configure -a >&2 || true
    fi
    apt-get update >&2
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends x11-apps netpbm >&2
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed xorg-xwd netpbm >&2
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y --skip-broken install xorg-x11-apps netpbm >&2
  else
    apk add --no-cache xwd netpbm >&2
  fi
  [ -x /usr/bin/xwd ] && XWD=/usr/bin/xwd
  [ -x /usr/bin/pnmtoplainpnm ] && PNM=/usr/bin/pnmtoplainpnm
  [ -x /usr/bin/xwdtopnm ] && X2P=/usr/bin/xwdtopnm
fi
if [ -z "$XWD" ] || [ -z "$PNM" ]; then
  echo "emux-capture: no grabber available (xwd/pnmtoplainpnm missing, apk add failed)" >&2
  exit 1
fi
if [ -z "$NC" ]; then
  # v0.1.47 multi-distro: netcat-openbsd exists under the same name on Alpine
  # and Debian/Ubuntu; apt installs it via alternatives to /usr/bin/nc.
  if command -v apt-get >/dev/null 2>&1; then
    [ -x /usr/local/bin/emux-apt-repair ] && emux-apt-repair >&2 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y netcat-openbsd >&2
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm --needed openbsd-netcat >&2
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y install nmap-ncat >&2
  else
    apk add --no-cache netcat-openbsd >&2
  fi
  for c in /usr/bin/nc /bin/nc; do { [ -x "$c" ] || [ -L "$c" ]; } && { NC="$c"; break; }; done
fi
[ -n "$NC" ] || { echo "emux-capture: no TCP client (nc) available" >&2; exit 1; }

# v0.2.4 FIELD FIX: pick a DISPLAY that xwd can actually OPEN. On the field
# device the server was up (-ac, tcp 6000 listening, nc -z 127.0.0.1 6000 ok)
# yet `xwd -root` died with "unable to open display ':0'" - the tcp X
# handshake is the broken path on this ROM/libX11. Probe every spelling with
# a throwaway grab and export the winner BEFORE the real pipeline starts,
# so a unix-socket-less server can still be reached over inet.
# v0.2.67 FIX (input-dead audit, round 2): the probe list USED to end with
# ":0" and "127.0.0.1:0" as a last resort. That fallback is the split-brain
# generator behind ten versions of "desktop shows but nothing is clickable":
# one transient failure on the SESSION display at capture start (server
# restarting after an LMK kill, unix socket not created yet, proot socket
# race) pinned the stream to :0 FOR THE WHOLE SESSION - and :0 is precisely
# the display a zombie Xvfb from a previous app life keeps answering on
# forever (see emux-x11's adopt-don't-fight history). The pane then filmed
# the zombie's old desktop (icons, no panel, zero damage = "LIVE 0.5 fps")
# while the control plane injected into the real session server
# ("proof=ok touch=18 inj=36" over a desktop that opens nothing). recheck
# below compares the marker with $DN, not with the DISPLAY actually in use,
# so the split never healed. Now: probe ONLY spellings of the session
# display, and WAIT for it - a capture that cannot reach its own server
# must fail loudly (the app respawns it) instead of silently filming a
# desktop nobody can click.
CAPD=""
i=0
while [ "$i" -lt 40 ]; do
  for d in ":$DN" "127.0.0.1:$DN"; do
    if DISPLAY="$d" "$XWD" -root -silent >/dev/null 2>>/tmp/emux_cap.err; then
      export DISPLAY="$d"; CAPD="${d##*:}"; break 2
    fi
  done
  i=$((i + 1)); sleep 0.5
done
[ -n "$CAPD" ] || { echo "emux-capture: session display :$DN never openable for xwd - NOT falling back to another display (v0.2.67)" >&2; exit 1; }
echo "emux-capture: display=$DISPLAY after xwd preflight" >&2
# v0.2.67: publish "<display> <epoch>" every loop; the Android control plane
# reads it and refuses to stay on a different display than the one being
# streamed (the capture plane is the truth of what the user sees).
publish_cap_display() { echo "${DISPLAY##*:} $(date +%s)" > /tmp/emux_cap_display 2>/dev/null; }
publish_cap_display

TMPF=/tmp/emux_frame.p3
RAW=/tmp/emux_frame.rgb
# v0.1.95: native converter (mawk on Debian/Ubuntu drops NUL bytes from awk
# %c - black pixels are NULs - so the awk path desyncs the stream silently).
CONV=/usr/local/lib/emux/emux-rgb565
echo "emux-capture: converter=$([ -x "$CONV" ] && echo native || echo fallback-chain)" >&2
# v0.2.12 FIELD FIX: selftest the native converter at start, and fall back
# LOUDLY. v0.2.14 field round showed WHY the fallback matters even more
# than expected: with the native converter dead, busybox awk encodes a
# 1280x840 P3 (~3.2 M pixel tokens) in MANY SECONDS per frame - the
# "black desktop for a moment" was a real frame arriving at ~0.05 fps.
# v0.2.15: perl (perl-base is essential on Ubuntu/Debian, NUL-safe via
# pack("v"), ~10x faster) becomes the middle fallback, and the native
# selftest goes VERBOSE (rc + bytes + stderr) so the freestanding
# binary's on-device failure can finally be diagnosed.
AWKCMD="awk"
ENC=none
perl_encode() {
  perl -e 'my $d=do{local $/;<STDIN>}; $d=~s/#[^\n]*//g; my @t=split /\s+/, $d; shift @t if @t and $t[0] eq "P3"; my($w,$h,$mx)=splice @t,0,3; $mx=255 unless $mx; my $o=""; for(my $i=0;$i+2<@t;$i+=3){ my $v=int($t[$i]*31/$mx)*2048+int($t[$i+1]*63/$mx)*32+int($t[$i+2]*31/$mx); $o.=pack("v",$v);} print $o;'
}
if [ -x "$CONV" ]; then
  CS=$("$CONV" -s 4 4 2>>/tmp/emux_cap.err | wc -c)
  echo "emux-capture: conv selftest header=$CS bytes (want 8)" >&2
  if [ "$CS" = 8 ]; then
    ENC=native
  else
    "$CONV" -s 4 4 >/tmp/conv_probe.bin 2>/tmp/conv_probe.err
    PRC=$?
    echo "emux-capture: conv probe rc=$PRC bytes=$(wc -c < /tmp/conv_probe.bin 2>/dev/null) err=$(head -c 120 /tmp/conv_probe.err 2>/dev/null)" >&2
    CONV=""
  fi
fi
if [ "$ENC" = none ]; then
  if command -v perl >/dev/null 2>&1; then
    ENC=perl
    echo "emux-capture: encoder = perl (NUL-safe, fast)" >&2
  elif command -v busybox >/dev/null 2>&1 && [ "$(busybox awk 'BEGIN{printf "%c",0}' | wc -c)" = 1 ]; then
    ENC=busyboxawk; AWKCMD="busybox awk"
    echo "emux-capture: encoder = busybox awk (NUL-safe, SLOW)" >&2
  else
    [ -x /usr/local/bin/emux-apt-repair ] && emux-apt-repair >&2 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y busybox >&2 || apk add --no-cache busybox >&2 || true
    if command -v busybox >/dev/null 2>&1; then
      ENC=busyboxawk; AWKCMD="busybox awk"
      echo "emux-capture: encoder = busybox awk (installed, SLOW)" >&2
    else
      ENC=awk
      echo "emux-capture: WARNING - mawk fallback (NUL pixels may desync)" >&2
    fi
  fi
fi

grab_frame() {
  # v0.1.60: XWD -> (xwdtopnm) -> plain PNM; the middle step is mandatory
  # v0.1.98 (field audit): grab errors used to go to /dev/null, so the pane
  # never said WHY capture was waiting. Keep them in a file and surface the
  # tail on repeated failures.
  # v0.2.9 FIELD FIX: bound every stage. A hung X client (server alive
  # but not servicing, proot socket stall) used to block grab_frame
  # FOREVER - capture then sat silent after "converter=native" with the
  # process alive and zero frames (field v0.2.8 process table).
  # v0.2.11 FIELD FIX: NO timeout(1) in the grab path. Field v0.2.10:
  # "stage xwd FAILED (rc=0)" with an EMPTY cap.err while the identical
  # PREFLIGHT xwd - the same binary, same flags, same DISPLAY, but with
  # NO timeout wrapper - succeeded every time. The wrapper itself was
  # the silent failure under proot + the linkfix shim (and v0.2.9's
  # "timeouts" were almost certainly this, misread). Bound stages with a
  # background killer subshell + wait (plain shell jobs, proot-safe) and
  # report the REAL exit code (137 = our killer = genuine timeout).
  GX=/tmp/emux_frame.xwd
  "$XWD" -root -silent >"$GX" 2>>/tmp/emux_cap.err &
  GPID=$!
  ( sleep 8; kill -9 "$GPID" 2>/dev/null ) &
  KPID=$!
  wait "$GPID"; GRC=$?
  kill "$KPID" 2>/dev/null
  if [ "$GRC" = 137 ]; then
    echo "emux-capture: stage xwd TIMEOUT >8s (DISPLAY=$DISPLAY)" >&2; return 1
  fi
  if [ "$GRC" != 0 ]; then
    echo "emux-capture: stage xwd FAILED rc=$GRC (DISPLAY=$DISPLAY) - see cap.err" >&2; return 1
  fi
  [ -s "$GX" ] || { echo "emux-capture: stage xwd produced EMPTY file" >&2; return 1; }
  if [ -n "$X2P" ]; then
    "$X2P" <"$GX" 2>>/tmp/emux_cap.err | "$PNM" 2>>/tmp/emux_cap.err >"$TMPF" &
    CPID=$!
    ( sleep 8; kill -9 "$CPID" 2>/dev/null ) &
    K2=$!
    wait "$CPID"; CRC=$?
    kill "$K2" 2>/dev/null
    [ "$CRC" = 0 ] || { echo "emux-capture: stage convert FAILED rc=$CRC (137=timeout)" >&2; return 1; }
  else
    "$PNM" <"$GX" 2>>/tmp/emux_cap.err >"$TMPF" || { echo "emux-capture: stage pnmtoplainpnm FAILED" >&2; return 1; }
  fi
  [ -s "$TMPF" ] || { echo "emux-capture: stage convert produced EMPTY PNM" >&2; return 1; }
  if [ "$ENC" = native ]; then
    "$CONV" < "$TMPF" > "$RAW" 2>>/tmp/emux_cap.err
    VRC=$?
    if [ "$VRC" != 0 ]; then
      echo "emux-capture: stage conv (emux-rgb565) FAILED rc=$VRC" >&2
      return 1
    fi
  elif [ "$ENC" = perl ]; then
    perl_encode < "$TMPF" > "$RAW" 2>>/tmp/emux_cap.err || { echo "emux-capture: stage perl-conv FAILED" >&2; return 1; }
  else
  $AWKCMD '
    BEGIN{ st=0; hn=0; px=0; MX=255 }
    /^#/{ next }
    {
      for(i=1;i<=NF;i++){
        t=$i
        if(st==0){ if(t=="P3") st=1; continue }
        if(st==1){
          hn++
          if(hn==1) W=t+0
          else if(hn==2) H=t+0
          else { MX=t+0; if(MX<1) MX=255; st=2 }
          continue
        }
        buf[px++]=t+0
        if(px==3){
          v = int(buf[0]*31/MX)*2048 + int(buf[1]*63/MX)*32 + int(buf[2]*31/MX)
          printf "%c%c", v%256, int(v/256)
          px=0
        }
      }
    }' "$TMPF" > "$RAW" 2>>/tmp/emux_cap.err || { echo "emux-capture: stage awk-conv FAILED" >&2; return 1; }
  fi
  [ -s "$RAW" ] || { echo "emux-capture: stage conv produced EMPTY rgb" >&2; return 1; }
  return 0
}

# first successful grab defines the TRUE geometry (parsed from the P3 header,
# so an EMUX_X_RES mismatch can never desync the size check below)
tries=0
until grab_frame; do
  tries=$((tries+1))
  # v0.2.9: never be silent while failing - the pane tail is the field's
  # only window and a quiet retry loop reads as "hung".
  [ $((tries % 10)) = 0 ] && echo "emux-capture: grab retry #$tries (grab timed out or empty; DISPLAY=$DISPLAY)" >&2
  [ $tries -ge 100 ] && { echo "emux-capture: initial grab failed 100x - is DISPLAY=$DISPLAY alive?" >&2; exit 1; }
  sleep 0.3
done
echo "emux-capture: first grab ok - reading geometry" >&2
DIMS=$(sed -e '/^#/d' "$TMPF" | awk 'NR==1{next} NF>=2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {print $1" "$2; exit}')
W="${DIMS% *}"; H="${DIMS#* }"
case "$W$H" in (*[!0-9]*|"") echo "emux-capture: cannot read display geometry from P3 header" >&2; exit 1;; esac

# persistent push channel: ONE background nc draining a FIFO (the Android side
# accepts a SINGLE connection for the whole session)
# v0.2.9 FIELD FIX: per-frame connections, no FIFO pump. The pump's
# `exec 3>"$FIFO"` blocks FOREVER when the background nc dies before
# reading it (connect refused / killed mid-churn) - capture then hung
# silent right after "converter=native" (field v0.2.8: process alive,
# no output, no frames). The Android reader re-accepts since v0.2.7, so
# one short-lived nc per frame is simpler and cannot block anywhere.
FIFO=""
SINK=0
echo "emux-capture: push mode = per-frame nc to $HOST:$PORT" >&2

send_bytes() {
  if [ "$SINK" = 3 ]; then cat >&3; else "$NC" "$HOST" "$PORT" 2>/dev/null; fi
}

# little-endian byte writers: the INNER printf builds an octal-escape format
# (\NNN), the OUTER printf emits the raw bytes (v0.1.26 technique, verified).
u16le() { printf "$(printf '\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)))"; }
u32le() { printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \
  $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"; }

# v0.2.14 FIELD FIX: PER-CONNECTION stream header. In per-frame nc mode
# (SINK=0, the only mode since the FIFO pump left in v0.2.9) every frame
# travels on its OWN connection - but the 8-byte stream header used to go
# out once on a separate connection: the Android reader accepted that one,
# read the header, hit EOF, re-accepted (v0.2.7 loop) and then parsed
# FRAME bytes as a header -> "bad capture magic" -> re-accept forever.
# Frames were arriving and being discarded as malformed headers - exactly
# the v0.2.13 field state ("first grab ok", "push mode = per-frame nc",
# zero frames). The header now prefixes every connection.
stream_header() {
  # EXACTLY 8 bytes. v0.1.96: from C when available - dash printf TRUNCATES
  # the format string at the first NUL (1280 = 0x0500 -> u16le starts with
  # 0x00), so the shell path sent a 6-byte header and desynced the reader.
  if [ "$ENC" = native ]; then "$CONV" -s "$W" "$H"; else printf EMUX; u16le "$W"; u16le "$H"; fi
}

seq=0
fails=0
MM=0
IDLE=0
# v0.2.52 FIELD FIX: follow display rotations LIVE. emux-x11's self-heal
# can rotate the display a few seconds AFTER capture pinned its number
# (field: tint2/pcmanfm alive on :N while the stream filmed the old,
# windowless display = "black desktop with a running panel"). Re-read the
# published marker each loop; on change, re-export DISPLAY and keep going.
recheck_display() {
  ND=$(tr -dc '0-9' < /tmp/emux_display_num 2>/dev/null)
  # v0.2.67 FIX: compare the marker with the DISPLAY ACTUALLY IN USE, not
  # with the $DN variable. Before this, a preflight fallback (the old ":0"
  # last resort) left DISPLAY and DN disagreeing forever: the marker equalled
  # DN, so this function never fired and the stream kept filming a display
  # the control plane was not on.
  CUR="${DISPLAY##*:}"
  if [ -n "$ND" ] && [ "$ND" != "$CUR" ]; then
    DN="$ND"; XP=$((6000 + DN))
    if [ -e /tmp/.X11-unix/X$DN ]; then NDISP=":$DN"; else NDISP="127.0.0.1:$DN"; fi
    # only follow if the new display actually opens - never trade a living
    # stream for a marker that points at a dead server.
    if DISPLAY="$NDISP" "$XWD" -root -silent >/dev/null 2>>/tmp/emux_cap.err; then
      echo "emux-capture: display rotated - following to $NDISP (was $DISPLAY)" >&2
      export DISPLAY="$NDISP"
    else
      echo "emux-capture: marker says :$ND but it is not openable - staying on $DISPLAY" >&2
    fi
  fi
  publish_cap_display
}
PREV=/tmp/emux_frame.prev
rm -f "$PREV" 2>/dev/null
while :; do
  recheck_display
  if ! grab_frame; then
    fails=$((fails+1))
    # v0.1.98: surface the grab error tail on the 1st and every 10th failure
    if [ "$fails" = 1 ] || [ $((fails % 10)) = 0 ]; then
      echo "emux-capture: grab failure #$fails: $(tail -2 /tmp/emux_cap.err 2>/dev/null | tr '\n' ' ')" >&2
    fi
    [ $fails -ge 50 ] && { echo "emux-capture: 50 consecutive frame grabs failed - is DISPLAY=$DISPLAY alive?" >&2; exit 1; }
    sleep 0.3; continue
  fi
  fails=0
  # v0.2.12: the old size check `continue`d SILENTLY - a second way a
  # bad conv could read as a mystery retry loop. First three mismatches
  # now say so with both sizes.
  RB=$(wc -c < "$RAW")
  if [ "$RB" -ne $((W*H*2)) ]; then
    MM=$((MM + 1))
    [ "$MM" -le 3 ] && echo "emux-capture: size mismatch raw=$RB want=$((W*H*2)) (W=$W H=$H)" >&2
    sleep 0.3; continue
  fi
  if [ "$MAILMODE" = 1 ]; then
    # v0.2.76 MAILBOX: grab -> convert -> file -> publish -> next loop.
    # The Android mail reader polls this file outside proot; no socket,
    # no wedge, no respawn churn. Damage pacing kept: unchanged frame
    # still sleeps longer so a static desktop costs ~2.5 xwd/s.
    publish_cap_display
    seq=$((seq+1))
    [ "$IDLE_PREV" = 0 ] 2>/dev/null || true
    sleep 0.2
    continue
  fi
  if [ "$seq" = 0 ]; then echo "emux-capture: frame 1 pushed ($(wc -c < "$RAW") bytes)" >&2; fi
  # v0.2.25 FIELD FIX: damage-driven pacing (the header comment promised
  # it since v0.1.28; the loop never did it). A static desktop used to
  # grab+encode+push 10x/s FOREVER - on a proot-backed phone that is ten
  # xwd round-trips and ten tcp connections per second for pixels that
  # never changed, crowding the very pipeline we spent twenty builds
  # fixing. Now: unchanged frame -> no push, poll at ~2.5 fps, and one
  # keepalive push every ~2 s so the Android reader's accept loop (and
  # any watcher) still sees a live stream.
  if [ -s "$PREV" ] && cmp -s "$RAW" "$PREV"; then
    IDLE=$((IDLE + 1))
  else
    IDLE=0
    cp "$RAW" "$PREV" 2>/dev/null
  fi
  if [ "$IDLE" = 0 ] || [ $((IDLE % 5)) = 0 ]; then
    if [ "$ENC" = native ]; then
      { stream_header; "$CONV" -F "$seq" "$W" "$H" < "$RAW"; } | send_bytes || {
        if [ "$SINK" = 3 ]; then echo "emux-capture: push channel closed (Android side gone)" >&2; exit 0;
        else echo "emux-capture: push of frame $seq FAILED (nc to $HOST:$PORT)" >&2; fi
      }
    else
      { stream_header; u32le "$seq"; u16le "$W"; u16le "$H"; u16le 0; u16le 0; cat "$RAW"; } | send_bytes || {
        if [ "$SINK" = 3 ]; then echo "emux-capture: push channel closed (Android side gone)" >&2; exit 0;
        else echo "emux-capture: push of frame $seq FAILED (nc to $HOST:$PORT)" >&2; fi
      }
    fi
  fi
  seq=$((seq+1))
  [ "$IDLE" = 0 ] && sleep 0.1 || sleep 0.4
done
