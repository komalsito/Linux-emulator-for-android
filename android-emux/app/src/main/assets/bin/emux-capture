#!/system/bin/sh
# emux-capture HOST:PORT — push framebuffer frames to the Android UI.
# v0.1.17 REWRITE (desktop showed nothing): the previous version was a literal
# pseudocode stub — its loop body contained "..." so it NEVER sent a single
# frame byte; `nc -q0` closed the socket right after the header, and W/H were
# parsed from a combined "WxH" string. The Kotlin reader blocked forever in
# accept()/readFully with zero frames. This implementation is real end-to-end:
#   header : 'EMUX' | width u16 LE | height u16 LE | format u8 | flags u8
#   frame  : seq u32 LE | dirtyW u16 | dirtyH u16 | x u16 | y u16 | rgb565 rows
TARGET="${1:-127.0.0.1:7001}"
HOST="${TARGET%%:*}"; PORT="${TARGET##*:}"
export DISPLAY="${DISPLAY:-:0}"

# v0.1.20 BUGFIX (desktop showed nothing): the Android-side frame reader parses
# a 10-byte frame header (seq u32 | dw u16 | dh u16 | x u16 | y u16) followed by
# exactly dw*dh*2 payload bytes. The old pump emitted a 12-byte prefix and then
# FULL-FRAME payloads even for partial dirty rects → every read desynchronized,
# dw/dh decoded as garbage, and the loop `continue`d forever on black frames.
# The protocol is now FIXED-SIZE end-to-end: always W,H from the stream header,
# always W*H*2 payload bytes per frame. (The Kotlin reader was updated to match.)

# --- wait for the X server (emux-x11 starts it asynchronously) ---------------
# v0.1.22 BUGFIX (black desktop): same bug as emux-x11 — the old loop tested
# ANDROID's /tmp/.X11-unix/X0, which the distro Xvfb NEVER creates there (it
# writes $ROOT/tmp/.X11-unix/X0 via TMPDIR). The loop always burned its full
# 15 s and capture then proceeded against a possibly-dead server. Wait on the
# real TMPDIR socket path instead.
XD="${TMPDIR:-/tmp}"
i=0
while [ ! -e "$XD/.X11-unix/X0" ] && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done

# --- toolchain ----------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }
# v0.1.20: ffmpeg is NOT in Alpine's main repo (it lives in community), so the
# old "apk add ffmpeg" silently failed on fresh rootfs and capture exited with
# "ffmpeg unavailable" — zero frames, black pane, no explanation. We now use the
# much smaller `xwd` (x11-apps) + netpbm `pnmtoplainpnm`, and fall back through
# several candidates before giving up loudly.
# v0.1.21 BUGFIX (capture stalled ~forever on fresh installs): like emux-x11,
# this script runs OUTSIDE any chroot — `have xwd` searched ANDROID's PATH and
# always failed, so EVERY launch ran `apk add --no-cache x11-apps netpbm`
# against the DISTRO db from an Android view of the world. With no writable
# etc/apk/protected-path.d and no cache dir visible outside the rootfs, apk
# either hung or silently errored (output was sent to /dev/null), and capture
# exited with "no grabber available" — zero frames, black pane forever. We now
# check the REAL rootfs paths first and only pay for apk when the binaries are
# genuinely absent; apk failures are LOUD (stderr → terminal tab) instead of
# swallowed.
ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
# v0.1.22 BUGFIX (capture helper could NEVER exec its distro tools): same musl
# loader/libc bridge as emux-x11 — without LD_LIBRARY_PATH pointing at the
# rootfs, every musl binary (xwd, pnmtoplainpnm…) died with
# "CANNOT LINK EXECUTABLE". Also export it so children inherit it.
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  for L in "$ROOT"/lib/ld-musl-*.so.1; do
    [ -e "$L" ] || continue
    B=$(basename "$L")
    [ -e "$ROOT/lib/$B" ] || ln -sf ../usr/lib/libc.so "$ROOT/lib/$B" 2>/dev/null
  done
  export LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
XWD=""
PNM=""
for c in "$ROOT/usr/bin/xwd" /usr/bin/xwd "$(command -v xwd 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { XWD="$c"; break; }
done
for c in "$ROOT/usr/bin/pnmtoplainpnm" /usr/bin/pnmtoplainpnm "$(command -v pnmtoplainpnm 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { PNM="$c"; break; }
done
if [ -z "$XWD" ] || [ -z "$PNM" ]; then
  echo "emux-capture: installing x11-apps+netpbm into the distro (one-time, needs network)" >&2
  # v0.1.22 BUGFIX (apk add failed silently → black pane): apk was invoked as a
  # bare word from OUTSIDE the rootfs — resolving to Android's PATH where no
  # apk exists ("apk: not found", swallowed), and even when it resolved, musl
  # linking needed LD_LIBRARY_PATH and TMPDIR had to be created first. Run the
  # DISTRO apk by absolute path with the loader bridge exported, mkdir TMPDIR,
  # and keep output on stderr so failures are visible in the terminal tab.
  mkdir -p "${TMPDIR:-$ROOT/tmp}" 2>/dev/null
  APK=""
  for c in "$ROOT/sbin/apk" "$ROOT/usr/bin/apk" "$ROOT/bin/apk"; do
    [ -x "$c" ] && { APK="$c"; break; }
  done
  if [ -n "$APK" ]; then
    TMPDIR="${TMPDIR:-$ROOT/tmp}" LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" \
      "$APK" add --no-cache x11-apps netpbm >&2
  else
    echo "emux-capture: apk not found inside $ROOT — cannot install grabber tools" >&2
  fi
  for c in "$ROOT/usr/bin/xwd" /usr/bin/xwd "$(command -v xwd 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { XWD="$c"; break; }
  done
  for c in "$ROOT/usr/bin/pnmtoplainpnm" /usr/bin/pnmtoplainpnm "$(command -v pnmtoplainpnm 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { PNM="$c"; break; }
  done
fi
# v0.1.22 BUGFIX (capture exited even though the rootfs tools existed): this
# guard ran `have xwd` — an ANDROID-PATH lookup made useless outside the
# chroot — and exited 1 whenever the binary lived only under $ROOT/usr/bin.
# Check the RESOLVED paths instead.
if [ -z "$XWD" ] && ! have ffmpeg; then
  echo "emux-capture: no grabber available (apk add x11-apps netpbm failed)" >&2
  exit 1
fi

# --- geometry -----------------------------------------------------------------
# v0.1.21 BUGFIX: xdpyinfo ships in xorg-server-utils (NOT installed by us) —
# the geometry probe always failed and capture exited with "cannot read display
# geometry" even when everything else worked. Derive W/H from the Xvfb screen
# spec (EMUX_X_RES, same default emux-x11 uses) and verify against a real xwd
# dump header when available.
RES_DEFAULT="720x1280x24"
GEOM="${EMUX_X_RES:-$RES_DEFAULT}"
GEOM="${GEOM%%x*}x$(echo "${GEOM#*x}" | sed 's/x.*//')"   # strip bit depth -> WxH
W=$(echo "$GEOM" | cut -dx -f1); H=$(echo "$GEOM" | cut -dx -f2)
if [ -n "$XWD" ]; then
  # xwd header line: "width height" after -silent dump through pnm converter if present
  G2=$("$XWD" -root -silent 2>/dev/null | head -c 2000 | tr '\0' '\n' | grep -oE '[0-9]+ [0-9]+' | head -1)
  [ -n "$G2" ] && { W=$(echo "$G2" | cut -d' ' -f1); H=$(echo "$G2" | cut -d' ' -f2); }
fi
case "$W$H" in (*[!0-9]*|'') W="";; esac
[ -n "$W" ] && [ -n "$H" ] || { echo "emux-capture: cannot read display geometry (tried $GEOM)" >&2; exit 1; }

# --- connect to the Android frame listener ------------------------------------
# v0.1.22 BUGFIX (capture died before sending a single frame — black pane): the
# old code used `eval 'exec 3<>"/dev/tcp/$HOST/$PORT"'`. /dev/tcp is a BASH
# feature; this script runs under #!/system/bin/sh (Android toybox sh), which
# has NO /dev/tcp support, so fd 3 was NEVER opened: the header write failed →
# silent exit, zero frames forever. Alpine's busybox ash doesn't speak /dev/tcp
# either. Fix: stream through an external connector resolved in order —
# netcat (rootfs /bin/nc first, then PATH nc/ncat) or python3 as fallback.
TMPD="${TMPDIR:-${ROOT:+$ROOT/tmp}}"
[ -n "$TMPD" ] || TMPD=/tmp
mkdir -p "$TMPD" 2>/dev/null
NC=""
for c in "$ROOT/bin/nc" "$ROOT/usr/bin/nc" "$(command -v nc 2>/dev/null)" "$(command -v ncat 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { NC="$c"; break; }
done
PY=""
if [ -z "$NC" ]; then
  for c in "$ROOT/usr/bin/python3" "$ROOT/usr/bin/python" "$(command -v python3 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { PY="$c"; break; }
  done
fi
if [ -z "$NC" ] && [ -z "$PY" ]; then
  echo "emux-capture: no TCP client available (tried nc/ncat/python3) — installing netcat-openbsd" >&2
  APK=""
  for c in "$ROOT/sbin/apk" "$ROOT/usr/bin/apk" "$ROOT/bin/apk"; do
    [ -x "$c" ] && { APK="$c"; break; }
  done
  [ -n "$APK" ] && TMPDIR="$TMPD" LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$APK" add --no-cache netcat-openbsd >&2
  for c in "$ROOT/bin/nc" "$ROOT/usr/bin/nc" "$(command -v nc 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { NC="$c"; break; }
  done
fi
[ -n "$NC" ] || [ -n "$PY" ] || { echo "emux-capture: still no TCP client after apk add" >&2; exit 1; }

# Persistent push channel: FIFO drained by a background nc/python that keeps
# ONE socket open for the whole session (per-frame reconnect would race the
# single-accept ServerSocket on the Android side and lose frames).
FIFO="$TMPD/emux_cap.fifo"
rm -f "$FIFO" 2>/dev/null
mkfifo "$FIFO" 2>/dev/null || FIFO=""
if [ -n "$FIFO" ]; then
  if [ -n "$NC" ]; then
    ( "$NC" "$HOST" "$PORT" <"$FIFO" ) >/dev/null 2>&1 &
  else
    ( LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$PY" -u -c \
"import socket,sys
s=socket.create_connection(('$HOST',$PORT),5)
f=sys.stdin.buffer
while True:
    b=f.read(65536)
    if not b: break
    s.sendall(b)
s.close()" <"$FIFO" ) >/dev/null 2>&1 &
  fi
  PUMPID=$!
  exec 3>"$FIFO"
  SINK=3
else
  SINK=0   # per-frame mode: emit() spawns a fresh connector per frame
fi

# --- little-endian byte writers ------------------------------------------------
# v0.1.26 BUGFIX (desktop stuck on "waiting for X frames" forever): the old
# helpers emitted LITERAL backslash sequences. Inside single quotes the shell
# never interprets \x escapes, so u16le(720) printed the eight characters
# \ x 0 2 d 0 0 0 instead of two raw bytes — the stream header was ~40 ASCII
# chars long, the Kotlin reader blocked in readFully() waiting for an 8-byte
# header that never came, and zero frames were ever decoded. The awk converter
# had the same bug ("%c" with a literal "\\xNN" argument prints the text).
# printf FORMATS must be double-quoted so printf itself sees the real escapes;
# only then are the numeric substitutions expanded to octal (\NNN) byte values.
u16le() { printf "$(printf '\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)))"; }
u32le() { printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \\
  $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"; }

send_bytes() {
  # $@ = bytes on stdin of this function via caller grouping; read from fd 0.
  if [ "$SINK" = 3 ]; then
    cat >&3
  elif [ -n "$NC" ]; then
    "$NC" -w 1 "$HOST" "$PORT" 2>/dev/null
  else
    LD_LIBRARY_PATH="$ROOT/lib:$ROOT/usr/lib" "$PY" -u -c \
"import socket,sys
s=socket.create_connection(('$HOST',$PORT),5)
s.sendall(sys.stdin.buffer.read())
s.close()" 2>/dev/null
  fi
}

# --- header: EMUX + W/H LE + format(0=rgb565) + flags(0) -----------------------
{ printf 'EMUX'; u16le "$W"; u16le "$H"; printf '\\x00\\x00'; } | send_bytes || true

# --- frame pump (FIXED-SIZE protocol, v0.1.20) ---------------------------------
# Every frame is exactly: seq u32 | W u16 | H u16 | 0 u16 | 0 u16  (10 bytes)
# followed by exactly W*H*2 bytes of RGB565 little-endian pixels.
# Grab path: xwd -root -silent | pnmtoplainpnm -> PPM text -> tiny awk converter
# to raw rgb565le. If xwd/pnm unavailable, fall back to ffmpeg single-frame grab.
# v0.1.22 BUGFIX (capture returned failure on EVERY frame): TMP/RAW were pinned
# to /tmp — ANDROID's /tmp, which the app user cannot write to (and even when
# writable, Xvfb under $ROOT/tmp never sees them). grab_frame then failed its
# size check forever → zero frames → black pane. Use the distro TMPDIR we set.
TMP="$TMPD/emux_frame.ppm"
RAW="$TMPD/emux_frame.rgb"
seq=0
grab_frame() {
  if [ -n "$XWD" ] && [ -n "$PNM" ]; then
    # v0.1.22: PNMTOP fallback — if the resolved converter produced nothing
    # usable this frame, count it as a grab failure (the main loop logs after
    # 50 consecutive failures instead of dying silently forever).
    "$XWD" -root -silent 2>/dev/null | "$PNM" 2>/dev/null > "$TMP" || return 1
    [ -s "$TMP" ] || return 1
    # P3 (plain) PPM -> rgb565le raw bytes. pnmtoplainpnm guarantees P3 text.
    awk -v OFS=' ' '
      BEGIN{FS=" "; mode=0}
      mode==0 && /^P3$/{mode=1; next}
      mode==1 { if(NF>=3){W=$1;H=$2;MX=$3;mode=2;next} }
      mode==2 {
        for(i=1;i<=NF;i++){
          r=$i; g=$(i+1); b=$(i+2); i+=2
          v=((r*31/255)<<11)|((g*63/255)<<5)|((b*31)/255)
          printf "%c%c", v%256, int(v/256)%256
        }
      }
    ' "$TMP" > "$RAW" 2>/dev/null
    [ "$(wc -c < "$RAW")" -eq $((W*H*2)) ] || return 1
    return 0
  fi
  ffmpeg -hide_banner -loglevel error -f x11grab -video_size "${W}x${H}"     -i "$DISPLAY" -frames:v 1 -pix_fmt rgb565le -f rawvideo "$RAW" 2>/dev/null
  [ "$(wc -c < "$RAW")" -eq $((W*H*2)) ]
}

fails=0
while :; do
  if ! grab_frame; then fails=$((fails+1)); [ $fails -ge 50 ] && { echo "emux-capture: 50 consecutive frame grabs failed — is DISPLAY=$DISPLAY alive?" >&2; exit 1; }; sleep 0.3; continue; fi
  fails=0
  { u32le "$seq"; u16le "$W"; u16le "$H"; u16le 0; u16le 0; cat "$RAW"; } | send_bytes || { [ "$SINK" = 3 ] && { echo "emux-capture: push channel closed (Android side gone)" >&2; exit 0; }; }
  seq=$((seq+1))
  sleep 0.1   # ~10 fps cap — plenty for a WM desktop, battery-friendly
done
