#!/bin/sh
# emux-x11 WM - start Xvfb (or Xorg under real root) + window manager.
#
# v0.1.28 REWRITE: this script runs INSIDE the distro environment (proot or
# chroot), where all absolute paths (/usr/bin/Xvfb, /usr/bin/xkbcomp, ...)
# resolve natively. Host-mode invocation (EMUX_ROOTFS still visible) re-execs
# through the bundled proot. The old host-side loader hacks could never work:
# at startup the X server execs /usr/bin/xkbcomp BY ABSOLUTE PATH through
# /bin/sh to compile its keymap - outside a chroot-equivalent that path does
# not exist and Xvfb dies with "Failed to activate virtual core keyboard"
# (verified). proot's execve/PT_INTERP path translation is exactly the fix.
WM="${1:-openbox}"
# v0.2.61: `emux-x11 doctor` is a READ-ONLY field report. Detected here, before
# the session-state reset below, because clearing the launch markers is exactly
# what would make the report lie - "WM launched: NO" on a healthy session.
DOCTOR_MODE=""
case "$WM" in doctor|--doctor|-d) DOCTOR_MODE=1 ;; esac
# v0.2.5 FIELD FIX: display number comes from the app (rotated to a free
# one; see DesktopService). Everything below (:0, 6000, X0 lock/socket)
# keys off DN/XP so a stale server on another display cannot block us.
DN="${3:-0}"
XP=$((6000 + DN))
# v0.1.101 MOBILE: Android passes the device geometry as $2
# (DesktopService.desktopGeometry(): phone 1280x720 landscape, tablet
# aspect-matched, long side capped at 1280). Manual runs and EMUX_X_RES
# keep the legacy 720x1280 portrait default.
RES="${2:-${EMUX_X_RES:-720x1280x24}}"

ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  # host mode: re-exec inside proot
  NB="${EMUX_NATIVE_BRIDGE:-}"
  if [ -x "$NB/proot" ]; then
    echo "emux-x11: host mode - re-exec inside proot" >&2
    mkdir -p "$ROOT/tmp" 2>/dev/null
    LD_LIBRARY_PATH="$NB" HOME=/root PROOT_TMP_DIR="$ROOT/tmp" \
    PROOT_LOADER="$NB/loader" exec "$NB/proot" --link2symlink -0 -r "$ROOT" \
      -b /dev -b /proc -b /sys -w /root \
      /bin/sh -l -c "unset EMUX_ROOTFS EMUX_ROOT EMUX_NATIVE_BRIDGE; exec /usr/local/bin/emux-x11 $WM \"$RES\" $DN"
  fi
  echo "emux-x11: bundled proot missing at $NB/proot - tap Install to re-seed (or use root chroot mode)." >&2
  exit 1
fi

# ---------------- inside the distro (proot / chroot) ----------------
# v0.2.61: skipped in doctor mode - truncating the session marker would make
# the report claim this session never started.
[ -n "$DOCTOR_MODE" ] || : > /tmp/emux_sess_marker 2>/dev/null   # v0.2.28: freshness baseline for X0
# v0.2.32 FIELD FIX: launch markers live in the rootfs /tmp and SURVIVED
# across sessions - so every session after the first silently skipped the
# WM AND the visibility xterm (field v0.2.31: a perfectly streaming,
# pure-black desktop = X root window with zero clients). Markers are
# per-session by definition: clear them at every launcher start.
# v0.2.78: the button-delivery ladder's files are per-session too. A stale
# /tmp/emux_btn_verdict would fire the ladder before the app had measured
# anything, and a stale /tmp/emux_wm_fellback would forbid the one thing
# that is known to restore clicks.
[ -n "$DOCTOR_MODE" ] || rm -f /tmp/emux_btn_verdict /tmp/emux_btn_action /tmp/emux_btn_stages /tmp/emux_wm_fellback /tmp/emux_wm_mode 2>/dev/null
[ -n "$DOCTOR_MODE" ] || rm -f /tmp/emux_wm_launched /tmp/emux_xterm_launched /tmp/emux_vis_launched /tmp/emux_obx_reconf /tmp/emux_agent_launched /tmp/emux_apt_updated 2>/dev/null
# v0.2.88: tint2 crash strikes are per-session (a config retry in one
# session must not brand the next one as hopeless).
[ -n "$DOCTOR_MODE" ] || rm -f /tmp/emux_tint2_strikes 2>/dev/null
# v0.2.108: dock/tray pidfiles, HiDPI resources and the start-menu install
# attempt are per-session too.
[ -n "$DOCTOR_MODE" ] || rm -f /tmp/emux_tint2.pid /tmp/emux_tray.pid /tmp/emux_rail.pid /tmp/emux_scale_applied /tmp/emux_jgmenu_tried /tmp/emux_start_icon /tmp/emux_clipd.pid /tmp/emux_clip_in /tmp/emux_clip_out /tmp/emux_clip_last /tmp/emux_seed_sig /tmp/emux_pcmanfm_ok 2>/dev/null
# v0.2.108 HiDPI: the app passes EMUX_SCALE=2 for "Retina" (device
# resolution, UI doubled). Xft.dpi (applied once X is up, see apply_scale)
# scales Openbox, tint2 and xterm fonts; GTK gets GDK_SCALE, with
# GDK_DPI_SCALE undoing the Xft.dpi doubling of its text (the standard
# recipe). Under MATE its settings daemon owns GTK scaling instead
# (window-scaling-factor), so GDK_* stay unset there.
EMUX_SCALE="${EMUX_SCALE:-1}"
case "$EMUX_SCALE" in 2) ;; *) EMUX_SCALE=1 ;; esac
export EMUX_SCALE
if [ "$EMUX_SCALE" = 2 ]; then
  export QT_AUTO_SCREEN_SCALE_FACTOR=0 QT_SCALE_FACTOR=2 QT_FONT_DPI=96 XCURSOR_SIZE=48
  case "$WM" in
    mate-session) ;;
    *) export GDK_SCALE=2 GDK_DPI_SCALE=0.5 ;;
  esac
fi
export HOME="${HOME:-/root}"
export DISPLAY=:$DN
export TMPDIR=/tmp
# v0.1.79: PATH sanity. A session that starts mid-dpkg-transaction sources
# /etc/profile while coreutils files are being swapped ("id: not found" in
# the v0.1.78 pane) and can inherit a garbled PATH; pin the distro dirs.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH
# v0.2.39: is a process with $1 in its cmdline alive? (procps not
# guaranteed; /proc scan like kill_stale_x)
# v0.2.56 FIELD FIX: apt-get install with EMPTY/STALE package lists fails
# instantly ("Unable to locate package xdotool") - the governor and REST
# loop never ran `apt-get update`, while every successful manual field
# run did. Update once per session when lists are missing or older than
# ~6 h, bounded and logged.
apt_lists_stale() {
  [ -d /var/lib/apt/lists ] || return 0
  n=$(ls /var/lib/apt/lists 2>/dev/null | grep -c Packages)
  [ "$n" = 0 ] && return 0
  f=$(ls -t /var/lib/apt/lists/*Packages* 2>/dev/null | head -1)
  [ -z "$f" ] && return 0
  now=$(date +%s); mt=$(stat -c %Y "$f" 2>/dev/null || echo 0)
  [ $((now - mt)) -gt 21600 ]
}
apt_update_once() {
  [ -e /tmp/emux_apt_updated ] && return 0
  touch /tmp/emux_apt_updated 2>/dev/null
  echo "emux-x11: apt lists stale/empty - running apt-get update" >&2
  DEBIAN_FRONTEND=noninteractive apt-get update >>/tmp/emux_rest.log 2>&1 || true
}
running() {
  for f in /proc/[0-9]*/cmdline; do
    tr '\0' ' ' < "$f" 2>/dev/null | grep -q "$1" && return 0
  done
  return 1
}
# v0.2.88 FIELD FIX (missing taskbar + black first boot, HUAWEI MRDI-W09,
# Ubuntu rootfs): running() matches a SUBSTRING of the WHOLE cmdline, and
# two argv classes poisoned every furniture decision on the field session:
#   - this launcher itself runs as `/bin/sh /usr/local/bin/emux-x11 openbox …`
#     (WM name is $1), so `running openbox` was ALWAYS true - verify_desktop's
#     openbox=yes/no was fiction, and the watchdog's has-scan (openbox|tint2|…)
#     matched the launcher too, so the visibility client could never relaunch;
#   - the governor/REST installs run `apt-get install … tint2 pcmanfm …`, so
#     while the furniture was still DOWNLOADING, `running tint2` and
#     `running pcmanfm` were TRUE and start_furniture launched NOTHING - the
#     exact first-boot window in which the user watches a black pane and then
#     finds a desktop with no taskbar.
# running0() compares the BASENAME of argv[0] (and argv[1], for
# `/bin/sh /path/emux-capture`-style wrappers) EXACTLY and skips zombies -
# the same two traps doctor's livepid() was written for (see its comment).
# Every furniture/visibility decision goes through it from v0.2.88 on.
# v0.2.112 THE DESKTOP-WIDE SLOWDOWN. Under proot every command is an exec
# that proot must trace, and this function used to run sed + cut + tr + head
# + grep (plus subshells) for EVERY process in /proc - ~6 traced execs per
# process, per call. A MATE session has 60+ processes and the governor calls
# this several times every 5 s for 20 minutes: thousands of execs per tick,
# CPU pegged, the whole desktop (cursor, clicks, repaints) behind it. Now the
# whole process table is read ONCE by ps and matched by ONE awk; the
# per-process walk stays only as the fallback for a guest without ps.
running0() {
  R0OUT=$(ps -eo pid=,stat=,args= 2>/dev/null)
  if [ -n "$R0OUT" ]; then
    printf '%s\n' "$R0OUT" | awk -v t="$1" -v me="$$" '
      $1 != me && $2 !~ /^Z/ {
        a = $3; sub(".*/", "", a); b = $4; sub(".*/", "", b)
        if (a == t || b == t) { f = 1; exit }
      }
      END { exit f ? 0 : 1 }'
    return $?
  fi
  running0_slow "$1"
}
# v0.2.112: is ANY of the named programs running (argv[0]/argv[1] exact)?
running_any() {
  RAOUT=$(ps -eo pid=,stat=,args= 2>/dev/null)
  if [ -n "$RAOUT" ]; then
    printf '%s\n' "$RAOUT" | awk -v l=" $* " -v me="$$" '
      $1 != me && $2 !~ /^Z/ {
        a = $3; sub(".*/", "", a); b = $4; sub(".*/", "", b)
        if (index(l, " " a " ") || index(l, " " b " ")) { f = 1; exit }
      }
      END { exit f ? 0 : 1 }'
    return $?
  fi
  for RAN in "$@"; do running0_slow "$RAN" && return 0; done
  return 1
}
running0_slow() {
  R0T="$1"
  for f in /proc/[0-9]*/cmdline; do
    p=${f#/proc/}; p=${p%/cmdline}
    [ "$p" = "$$" ] && continue
    pst=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d ' ' -f1)
    [ -n "$pst" ] && [ "$pst" != Z ] || continue
    tr '\0' '\n' < "$f" 2>/dev/null | head -2 | while read -r a; do
      case "$a" in */*) a=${a##*/} ;; esac
      [ "$a" = "$R0T" ] && echo match
    done | grep -q match && return 0
  done
  return 1
}
# ============================================================================
# v0.2.78 — THE CLICK-SWALLOW FIX. Field report: "the desktop is visible but I
# cannot interact with it". Motion and keys were never affected; killing
# Openbox made `xdotool click 1` show up in `xev` as ButtonPress=1.
#
# WHY OPENBOX EATS BUTTONS AND NOTHING ELSE — from the two programs' sources,
# not from guesswork:
#
#  openbox/frame.h
#    #define FRAME_CONTEXT(co, cl)  ((cl && cl->type != OB_CLIENT_TYPE_DESKTOP) ?
#                                     co == OB_FRAME_CONTEXT_FRAME : FALSE)
#    #define CLIENT_CONTEXT(co, cl) ((cl && cl->type == OB_CLIENT_TYPE_DESKTOP) ?
#                                     co == OB_FRAME_CONTEXT_DESKTOP :
#                                     co == OB_FRAME_CONTEXT_CLIENT)
#  openbox/mouse.c  mouse_grab_for_client()
#    if (FRAME_CONTEXT(i, client)) { win = client->frame->window;
#        mode = GrabModeAsync; mask = ButtonPress|ButtonMotion|ButtonRelease; }
#    else if (CLIENT_CONTEXT(i, client)) { win = client->window;
#        mode = GrabModeSync;  mask = ButtonPressMask; }   /* "handled in event" */
#    else continue;
#    grab_button_full(b->button, b->state, win, mask, mode, OB_CURSOR_NONE);
#  openbox/grab.c  grab_button_full()
#    XGrabButton(dpy, button, state|mods, win, False /* owner_events */, ...)
#
# So a mousebind in exactly THREE contexts makes Openbox XGrabButton():
#   Frame    -> on the FRAME window, which is the PARENT of the client window
#   Client   -> on the client's own window, GrabModeSync
#   Desktop  -> on the desktop client's window (pcmanfm --desktop), GrabModeSync
# Every other context (Titlebar, Top/Bottom/Left/Right, corners, Close,
# Maximize, Iconify, Icon, Shade, AllDesktops) is dispatched from Openbox's own
# event SELECTION on the frame window, and Root from its root selection
# (screen.c ROOT_EVENTMASK) - neither creates a grab, so neither can swallow.
#
#  xorg dix/events.c  CheckDeviceGrabs()
#    for (; i < sprite->spriteTraceGood; i++) {
#        pWin = sprite->spriteTrace[i];
#        if (CheckPassiveGrabsOnWindow(pWin, device, ievent, sendCore, TRUE))
#            return TRUE;                       /* event goes to the grabber */
#    }
# The walk covers EVERY window from the root down to the one under the pointer,
# so a grab on an ANCESTOR intercepts a click on a descendant - and Openbox
# grabs with owner_events=False, so the application never sees it. A Frame
# binding therefore eats every plain left click inside every managed window,
# which is why Openbox's own shipped rc.xml only ever binds Frame with a
# modifier (A-Left / A-Right / A-Middle) and never a bare button.
# Mask is ButtonPressMask (+motion for Frame) and NEVER keyboard or plain
# motion: that is precisely why "motion and keys were never affected".
#
# TWO WAYS THE DISTRO DEFAULT (/etc/xdg/openbox/rc.xml) WON ON A REAL DEVICE.
# It binds all three fatal contexts - Client (Left/Middle/Right Press) and
# Desktop (Left/Right Press) - plus Frame with modifiers only:
#   * this launcher wrote ~/.config/openbox/rc.xml ONLY IF ABSENT, so a file
#     left by an older version (or dropped there by obconf / a distro upgrade)
#     survived every app update. That is why ~25 releases of input fixes
#     changed nothing at all on the device that reported this.
#   * if that write fails for any reason (unwritable HOME, a full disk), Openbox
#     silently reads the distro default instead and nothing ever notices.
# So from v0.2.78 the file carries a VERSION STAMP and is rewritten whenever
# the stamp does not match, a foreign file is backed up rather than trusted,
# and rc_xml_grab_contexts() audits whichever file Openbox will actually read.
#
# FOCUS WITHOUT GRABS: with no Client binding, nothing focuses a window when it
# is clicked (that binding's whole purpose is `<action name="Focus"/>`). The
# replacement is <focus><followMouse>yes</followMouse>: Openbox focuses on
# EnterNotify (openbox/event.c, `config_focus_follow`), and EmuX injects a
# motion to the tap point before every press (X11Client.fakeButton), so focus
# arrives first and the click lands in a focused window - with zero grabs.
# ============================================================================
EMUX_RCXML_STAMP="EmuX rc v0.2.78"

# Which rc.xml will Openbox actually read? (Openbox falls back to the system
# default when the user file is missing - that fallback is silent, which is
# what made "we wrote a good rc.xml" unprovable from the field.)
rc_xml_effective() {
  for f in "$HOME/.config/openbox/rc.xml" /etc/xdg/openbox/rc.xml \
           /usr/etc/xdg/openbox/rc.xml /usr/share/openbox/rc.xml; do
    [ -e "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# Print the contexts in $1 (default: the effective file) whose mousebinds make
# Openbox XGrabButton(). Empty output = the config cannot swallow a click.
rc_xml_grab_contexts() {
  GXF="${1:-$(rc_xml_effective)}"
  [ -n "$GXF" ] && [ -r "$GXF" ] || return 0
  command -v awk >/dev/null 2>&1 || return 0
  # awk, not grep: `name=` may list several contexts on one line (Openbox's own
  # default does: name="Titlebar Top Right Bottom Left TLCorner ..."), and the
  # mousebinds are children of the context element.
  awk '
    /<context[ \t]/ && /name=/ {
      ctx=$0; sub(/.*name=[ \t]*"/, "", ctx); sub(/".*/, "", ctx); inctx=1
    }
    inctx && /<mousebind/ {
      n=split(ctx, a, /[ \t]+/)
      for (i=1; i<=n; i++) if (a[i]=="Frame" || a[i]=="Client" || a[i]=="Desktop") bad[a[i]]=1
    }
    /<\/context>/ { inctx=0 }
    END { sep=""; for (k in bad) { printf "%s%s", sep, k; sep=" " } }
  ' "$GXF" 2>/dev/null
}

# Write (or refresh) EmuX's rc.xml. Called at every seed AND by the escalation
# ladder, so it must be idempotent and must never leave a half-written file.
write_rc_xml() {
  RCF="$HOME/.config/openbox/rc.xml"  # not RC: that is the launcher's exit status below
  mkdir -p "$HOME/.config/openbox" 2>/dev/null
  if [ -e "$RCF" ] && ! grep -qF "$EMUX_RCXML_STAMP" "$RCF" 2>/dev/null; then
    # Two ways to recognise a file EmuX wrote itself: the stamp (v0.2.78+) and
    # the theme name, which every version since v0.2.51 shipped but which the
    # older files carry WITHOUT any stamp. Getting this wrong is not cosmetic:
    # it would back up our own broken file, tell the user we replaced something
    # of theirs, and - because a backup then exists - never say it again.
    if grep -q "EmuX rc v0.2" "$RCF" 2>/dev/null || grep -q "<name>Emux</name>" "$RCF" 2>/dev/null; then
      echo "emux-x11: upgrading our own rc.xml to $EMUX_RCXML_STAMP (the previous one bound the Frame context, which is what swallowed every click)" >&2
    elif [ ! -e "$RCF.emux-bak" ]; then
      cp "$RCF" "$RCF.emux-bak" 2>/dev/null && \
        echo "emux-x11: replaced a foreign rc.xml (yours is kept as rc.xml.emux-bak) - a Client/Desktop/Frame mousebind in it is what swallowed every click" >&2
    fi
  fi
  [ -e "$RCF" ] && grep -qF "$EMUX_RCXML_STAMP" "$RCF" 2>/dev/null && return 0
  cat > "$RCF.emux-tmp" <<'RCXML'
<?xml version="1.0" encoding="UTF-8"?>
<!-- EmuX rc v0.2.78 - rewritten on every launch whose stamp differs; a
     foreign file is preserved as rc.xml.emux-bak. DO NOT ADD a mousebind in
     the Frame, Client or Desktop context: those three are the only ones that
     make Openbox XGrabButton() (mouse.c mouse_grab_for_client), and xorg
     checks passive grabs on EVERY window from the root down to the one under
     the pointer (dix/events.c CheckDeviceGrabs), so such a grab steals the
     click from the application. See the long comment above write_rc_xml() in
     assets/bin/emux-x11 and docs/CLICK_SWALLOW_v0.2.78.md. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><name>Emux</name><titleLayout>NLIMC</titleLayout><keepBorder>yes</keepBorder><hideDisabled>no</hideDisabled><cornerRadius>6</cornerRadius></theme>
  <!-- followMouse replaces the Client-context Focus binding: no grab, and the
       motion EmuX injects before every tap brings focus with it. -->
  <focus><followMouse>yes</followMouse><focusNew>yes</focusNew><raiseOnFocus>no</raiseOnFocus></focus>
  <resize><drawContents>yes</drawContents></resize>
  <mouse>
    <!-- Root is Openbox's own root-window SELECTION, not a grab: right-click on
         the bare desktop still opens the menu, and clicks that land on an
         application window go to the application. -->
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    </context>
    <!-- Titlebar/border/buttons are dispatched by coordinate from Openbox's
         frame selection, so these are safe. They are deliberately NOT bound in
         the "Frame" context, which would grab Left on the frame window and
         steal every click inside the window below it. -->
    <context name="Titlebar">
      <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    </context>
    <context name="Top"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Left"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Right"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Bottom">
      <mousebind button="Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="TLCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="TRCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="BLCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="BRCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Middle" action="Click"><action name="ToggleMaximizeVertical"/></mousebind>
    </context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
  </mouse>
</openbox_config>
RCXML
  # tmp + mv, never `cat >` straight onto the live file: a truncated rc.xml is
  # worse than an old one (Openbox parses it, finds nothing, and then the audit
  # below reports a config we believe we fixed).
  if [ -s "$RCF.emux-tmp" ] && mv "$RCF.emux-tmp" "$RCF" 2>/dev/null; then
    echo "emux-x11: wrote $RCF ($EMUX_RCXML_STAMP)" >&2
    return 0
  fi
  rm -f "$RCF.emux-tmp" 2>/dev/null
  echo "emux-x11: CANNOT WRITE $RCF - Openbox will read the distro default, which grabs buttons and makes every click die. Fix the HOME permissions." >&2
  return 1
}

# v0.2.78: pids of LIVE window-manager processes, matched on argv[0]/argv[1]
# BASENAME only. The launcher's own cmdline is `... emux-x11 openbox 1280x720 1`,
# so anything that greps the whole cmdline matches the SESSION ITSELF and then
# kills it (doctor()'s livepid() exists for exactly that reason). Zombies are
# skipped: this container's PID 1 does not reap, so kill -0 lies about a WM we
# already terminated.
wm_pid() {
  for f in /proc/[0-9]*/cmdline; do
    p=${f#/proc/}; p=${p%/cmdline}
    [ "$p" = "$$" ] && continue
    pst=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f1)
    [ -n "$pst" ] && [ "$pst" != Z ] || continue
    tr '\0' '\n' < "$f" 2>/dev/null | head -2 | while read -r a; do
      case "$a" in */*) a=${a##*/} ;; esac
      case "$a" in
        openbox|openbox-session|twm|icewm|jwm|marco|metacity|fluxbox|xfwm4) echo match ;;
        # v0.2.101: full sessions must be found by the watchdog too, or it
        # relaunches start_wm every tick forever. head -2 covers
        # gnome-session -> gnome-session-binary and startxfce4's chain.
        gnome-session|gnome-session-binary|gnome-shell|startxfce4|xfce4-session|xfce4-session-binary|mutter|mate-session|mate-session-binary|startlxqt|lxqt-session|lxsession) echo match ;;
      esac
    done | grep -q match || continue
    echo "$p"
  done
  return 0
}

# v0.2.78: switch window manager - or run with none at all - when the app has
# measured that clicks do not reach applications. "No WM" is a real fallback,
# not a defeat: the field report that started this fix was that KILLING Openbox
# makes an injected click arrive (ButtonPress=1 in xev), and case A of
# tools/x11probe/button_delivery_test.sh reproduces that - with no WM at all an
# injected click reaches the application. Windows are then unmanaged (no
# titlebars, no stacking order) but every one is still shown and still clickable.
# A pretty desktop that ignores the finger is worth less than a plain one that
# does not.
# NOT claimed here: keyboard focus. With no WM nothing moves focus when a window
# is clicked, and SetInputFocus(PointerRoot) is not the fix - the server's focus
# already reports PointerRoot in that state, and libX11 defines PointerRoot as
# the ROOT window of the screen the pointer is on, not the window under it. If
# keys do not reach a window in this mode that is the honest state of it, and
# `emux-x11 doctor` reports "WM mode: none" so the field can see which rung of
# the ladder it is on instead of guessing.
# Runs at most once per session (guarded by /tmp/emux_wm_fellback).
wm_fallback() {
  [ -e /tmp/emux_wm_fellback ] && {
    echo "emux-x11: WM fallback already applied this session - not switching again" >&2
    return 0
  }
  touch /tmp/emux_wm_fellback 2>/dev/null
  OLDM=$(cat /tmp/emux_wm_mode 2>/dev/null)
  # v0.2.101: NEVER kill a full desktop session over a button-probe verdict.
  # The probe reads DEAD on a healthy openbox already (passive-grab probe
  # artifact, deprioritised in the field), and a session manager owns grabs
  # its own way - swapping the user's installed desktop for twm behind their
  # back is the worse failure by far.
  case "$OLDM" in
    gnome-session|gnome-session-binary|gnome-shell|startxfce4|xfce4-session|mate-session|mate-session-binary|startlxqt|lxqt-session|lxsession)
      echo "emux-x11: WM mode '$OLDM' is a full session - ladder will not replace it (probe artifacts ignored)" >&2
      return 0 ;;
  esac
  for p in $(wm_pid); do
    echo "emux-x11: terminating WM pid $p ($OLDM) - $1" >&2
    kill "$p" 2>/dev/null
  done
  i=0
  while [ "$i" -lt 20 ] && [ -n "$(wm_pid)" ]; do sleep 0.1; i=$((i + 1)); done
  for p in $(wm_pid); do kill -9 "$p" 2>/dev/null; done
  for cand in /usr/bin/twm /usr/bin/icewm /usr/bin/jwm /usr/bin/marco \
              /usr/bin/metacity /usr/bin/fluxbox /usr/bin/xfwm4; do
    [ -x "$cand" ] || continue
    [ "$(basename "$cand")" = "$OLDM" ] && continue
    echo "emux-x11: starting fallback WM $cand" >&2
    nohup "$cand" >/tmp/wm.log 2>&1 </dev/null &
    FPID=$!
    sleep 1
    if kill -0 "$FPID" 2>/dev/null; then
      basename "$cand" > /tmp/emux_wm_mode 2>/dev/null
      echo "emux-x11: fallback WM alive (pid $FPID, $cand)" >&2
      return 0
    fi
    echo "emux-x11: fallback WM $cand died within 1 s; wm.log tail:" >&2
    tail -3 /tmp/wm.log >&2 2>/dev/null
  done
  echo none > /tmp/emux_wm_mode 2>/dev/null
  echo "emux-x11: no fallback WM is installed - continuing WITHOUT a window manager (windows are unmanaged; clicks and keys still reach them)" >&2
  return 0
}

# v0.2.78: BUTTON-DELIVERY ESCALATION LADDER (guest side).
# The app measures whether an injected click actually reaches a managed window
# (X11Client.probeButtonDelivery - a real window, a real ButtonPress round
# trip, the xev experiment) and publishes the verdict to /tmp/emux_btn_verdict
# as "<epoch> <state> <detail>". This watcher acts on state=dead:
#   stage 1  rewrite the stamped rc.xml and `openbox --reconfigure` - fixes the
#            CAUSE in a live session, no restart, no lost windows
#   stage 2+ switch window manager (wm_fallback)
# Every stage records what it did in /tmp/emux_btn_action, republishes
# /tmp/emux_wm_mode, and DELETES the verdict so the app re-probes and either
# reports recovered or escalates again. Bounded by /tmp/emux_btn_stages.
btn_watch() {
  STG=0
  i=0
  while [ "$i" -lt 900 ]; do
    if [ -s /tmp/emux_btn_verdict ]; then
      VST=$(sed -n 's/^[0-9][0-9]* *\([A-Za-z-]*\).*/\1/p' /tmp/emux_btn_verdict 2>/dev/null | head -1)
      if [ "$VST" = dead ]; then
        STG=$((STG + 1))
        echo "$STG" > /tmp/emux_btn_stages 2>/dev/null
        if [ "$STG" -le 1 ]; then
          echo "emux-x11: button verdict DEAD (stage $STG) - rewriting rc.xml + reconfiguring the WM" >&2
          write_rc_xml
          RCX_BAD=$(rc_xml_grab_contexts)
          echo "${RCX_BAD:-none}" | tr -d ' \n' > /tmp/emux_rcxml_grabs 2>/dev/null
          if running0 openbox && command -v openbox >/dev/null 2>&1; then
            openbox --reconfigure >/dev/null 2>&1 || true
            echo "emux-x11: openbox --reconfigure sent (grabs now: ${RCX_BAD:-none})" >&2
          fi
          { echo "$(date +%s) stage1 rc=$(rc_xml_effective) grabs=${RCX_BAD:-none}"; } > /tmp/emux_btn_action 2>/dev/null
        else
          # v0.2.103 FIELD DEMOTION: the WM switch is dead code BY DECISION.
          # vc202 field: a HEALTHY openbox session (furniture up, user
          # interacting) got probe=DEAD - the KNOWN passive-grab artifact that
          # has shown on every healthy session all week - and stage 2 killed
          # openbox, found no candidate WM (ubuntu-desktop brings mutter, not
          # twm/icewm/jwm/marco/metacity/fluxbox/xfwm4) and left the session
          # WM-LESS: badge wm=none, a 40 MB/s full-frame repaint flood and
          # "everything is very laggy, can't interact". A WM swap is only
          # ever justified by evidence the WM is the problem, and this probe
          # has never provided that evidence - it false-DEADs on every
          # healthy openbox. Stage 1 (rc.xml rewrite + reconfigure) stays:
          # self-healing, cannot remove the WM. Stage 2+ only LOGS; a human
          # restarts the session if clicks genuinely die.
          echo "emux-x11: button verdict STILL DEAD (stage $STG) - NOT switching WM (probe false-DEADs on healthy sessions; the vc202 swap left a WM-less desktop)" >&2
          { echo "$(date +%s) stage$STG wm=$(cat /tmp/emux_wm_mode 2>/dev/null)"; } > /tmp/emux_btn_action 2>/dev/null
        fi
      fi
      # Always consume it: a stale verdict would re-trigger the ladder forever,
      # and the app rewrites a fresh one if the next probe still fails.
      rm -f /tmp/emux_btn_verdict 2>/dev/null
    fi
    sleep 2; i=$((i + 1))
  done
}

# v0.2.59 FIELD FIX — launch Openbox the way its OWN documentation specifies.
#
# openbox.org/help/Autostart, verbatim:
#   "When you run the openbox command on its own, the autostart scripts will
#    not run. They are run by openbox-session or when you log in graphically
#    with the Openbox session type."
#   "Once Openbox starts, the system-wide default script, located at
#    /etc/xdg/openbox/autostart, will be run. Then the user script at
#    ~/.config/openbox/autostart is run afterward."
#
# Every EmuX release up to v0.2.58 ran bare `openbox`, so the seeded
# ~/.config/openbox/autostart (background colour, picom, tint2, pcmanfm
# --desktop) and ~/.config/openbox/environment were NEVER executed. That is a
# direct cause of "I can't see the desktop": the root window stayed black and
# the panel/icons only appeared if the 5-second watchdog happened to launch
# them, which is why the field reports kept flip-flopping between "a terminal",
# "a black screen" and "sometimes a panel".
#
# Verified against Openbox 3.6.1: bare `openbox` -> autostart NOT run;
# `openbox --startup <script>` -> run. `openbox-session` is the same mechanism
# (Debian's script ends in
#   exec /usr/bin/openbox --startup "<libdir>/openbox-autostart OPENBOX")
# but it depends on an arch-specific libdir and on PyXDG (which logs
# "openbox-xdg-autostart requires PyXDG"), so we drive --startup directly.
# --sm-disable skips the session-manager connection: there is no SM here.
# v0.2.108: X resources for the chosen UI scale - once per session, before
# the first client so every toolkit reads the same DPI.
apply_scale() {
  [ -e /tmp/emux_scale_applied ] && return 0
  command -v xrdb >/dev/null 2>&1 || return 0
  # v0.2.111 xterm that behaves like a modern terminal (field: "on the
  # terminal inside the desktop I cannot copy nor paste"): a scalable font
  # (bitmap fonts ignore Xft.dpi - unreadable at Retina), Ctrl+Shift+C /
  # Ctrl+Shift+V copy and paste through CLIPBOARD (which the app shares with
  # the tablet), right-click (= long-press) pastes.
  # v0.2.113: selecting no longer copies by itself - every accidental drag
  # replaced the tablet clipboard ("copy-paste is weird"). Selection stays
  # PRIMARY (middle-click paste inside Linux), Ctrl+Shift+C is the copy.
  cat > /tmp/emux-xterm.ad <<'XTAD'
XTerm*faceName: Monospace
XTerm*faceSize: 11
XTerm*selectToClipboard: false
XTerm*scrollBar: false
XTerm*saveLines: 5000
XTerm*VT100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD) \n\
    <Btn3Down>: insert-selection(CLIPBOARD)
XTAD
  xrdb -merge /tmp/emux-xterm.ad >/dev/null 2>&1
  printf 'Xft.dpi: %s\nXcursor.size: %s\n' "$((96 * EMUX_SCALE))" "$((24 * EMUX_SCALE))" \
    | xrdb -merge >/dev/null 2>&1 && touch /tmp/emux_scale_applied && \
    echo "emux-x11: UI scale ${EMUX_SCALE}x (Xft.dpi $((96 * EMUX_SCALE)))" >&2
}
start_wm() {
  apply_scale
  WM_BIN=""
  for c in "/usr/bin/$1" "/usr/local/bin/$1" "/bin/$1" /usr/bin/openbox /usr/bin/twm /usr/bin/icewm; do
    [ -x "$c" ] && { WM_BIN="$c"; break; }
  done
  [ -n "$WM_BIN" ] || return 1
  # v0.2.107 IDEMPOTENT LAUNCH. start_wm has four call sites (first launch,
  # REST pass, display self-heal, the main path). A second plain `openbox`
  # just exits ("a window manager is already running"), so this never showed -
  # until full sessions: the field ps had TWO mate-session trees (two panels,
  # two settings daemons, two session buses) fighting over one display. The
  # self-heal path clears /tmp/emux_wm_launched on purpose, so a WM stuck on a
  # dead display still gets relaunched.
  if [ -e /tmp/emux_wm_launched ] && running0 "$(basename "$WM_BIN")"; then
    echo "emux-x11: $(basename "$WM_BIN") already running - not starting a second one" >&2
    return 0
  fi
  # Source the Openbox environment scripts first, exactly as openbox-session does.
  for E in /etc/xdg/openbox/environment "$HOME/.config/openbox/environment"; do
    [ -r "$E" ] && . "$E" 2>/dev/null
  done
  AS="$HOME/.config/openbox/autostart"
  case "$(basename "$WM_BIN")" in
    openbox)
      if [ -r "$AS" ]; then
        echo "emux-x11: launching $WM_BIN --sm-disable --startup '$AS' (documented session behaviour)" >&2
        nohup "$WM_BIN" --sm-disable --startup "/bin/sh $AS" >/tmp/wm.log 2>&1 </dev/null &
      else
        echo "emux-x11: launching $WM_BIN --sm-disable (no autostart file to run)" >&2
        nohup "$WM_BIN" --sm-disable >/tmp/wm.log 2>&1 </dev/null &
      fi ;;
    gnome-session|startxfce4|xfce4-session|mate-session|startlxqt|lxsession|lxqt-session)
      # v0.2.102: GNOME/mutter default to Wayland and die instantly on an
      # Xvfb (the vc201 field fallback - openbox returned, but GNOME never
      # got a chance). We are an X11 session by construction; say so up
      # front instead of letting mutter guess and fail.
      export XDG_SESSION_TYPE=x11
      # v0.2.106: no accessibility bus exists under proot; without this every
      # GTK app (caja, mate-panel, mate-settings-daemon) blocks ~25 s per start
      # trying to reach at-spi - a desktop that "hangs" for its first minute.
      export NO_AT_BRIDGE=1
      if [ -z "$XDG_RUNTIME_DIR" ]; then
        XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
        mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null && chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null
        export XDG_RUNTIME_DIR
      fi
      case "$(basename "$WM_BIN")" in
        mate-session) export XDG_CURRENT_DESKTOP=MATE DESKTOP_SESSION=mate ;;
      esac
      # v0.2.101: FULL-DESKTOP SESSIONS (field: 'apt install ubuntu-desktop'
      # must change what the user sees, not just sit on disk). A session
      # manager brings its own panel, icons, WM and autostart; stacking the
      # seeded tint2/pcmanfm furniture on top fights it for the root window,
      # and without systemd there is no session bus - dbus-launch one. The
      # environment scripts sourced above are openbox's; harmless here.
      if command -v dbus-launch >/dev/null 2>&1; then
        eval "$(dbus-launch --sh-syntax 2>/dev/null)" 2>/dev/null || true
      fi
      # v0.2.106 MATE ON A SOFTWARE FRAMEBUFFER: marco's compositor re-renders
      # the whole screen for every change (pure cost on Xvfb, and every repaint
      # is pixels the capture then has to move), and mate-screensaver would
      # blank the pane after idle and ask for a password this user never set.
      # Written into the dconf user db through the bus just started; harmless
      # no-ops when the schema is absent.
      if [ "$(basename "$WM_BIN")" = mate-session ] && command -v gsettings >/dev/null 2>&1; then
        gsettings set org.mate.Marco.general compositing-manager false 2>/dev/null
        gsettings set org.mate.screensaver idle-activation-enabled false 2>/dev/null
        gsettings set org.mate.screensaver lock-enabled false 2>/dev/null
        gsettings set org.mate.power-manager sleep-display-ac 0 2>/dev/null
        # v0.2.107 FIELD (vc206 ps + wm.log): marco never ran at all - no
        # window manager, so no decorations, focus or click-to-raise, and an
        # undecorated "Untitled window" over everything - and caja crash-looped
        # (a new pid every ~250 ms: GIO cannot read /proc/self/mountinfo under
        # proot on this ROM), leaving the root black while mate-session kept
        # respawning it. So MATE runs here with:
        #   - Openbox as its window manager: the WM this launcher has already
        #     made click-safe (write_rc_xml) and that works on this device;
        #   - no file manager in the REQUIRED set, so a crashing caja can no
        #     longer loop; Files still opens caja as a normal window on demand;
        #   - the background drawn by mate-settings-daemon instead of caja.
        # v0.2.116: mate-panel retired AGAIN - "mate center bar" turned out
        # to mean the CENTRED EmuX tint2 dock (v0.2.114), not MATE's
        # full-width panel. The v0.2.108 arrangement is back: the tint2
        # dock is the panel under MATE; the jgmenu start menu plus a dock
        # Settings launcher (mate-control-center) cover the settings
        # access the user missed.
        gsettings set org.mate.session required-components-list "['windowmanager']" 2>/dev/null
        gsettings set org.mate.interface window-scaling-factor "$EMUX_SCALE" 2>/dev/null
        gsettings set org.mate.background show-desktop-icons false 2>/dev/null
        gsettings set org.mate.background draw-background true 2>/dev/null
        # v0.2.116: no mate-panel layout seeding - mate-panel is retired
        # again; the centred EmuX dock is the panel (see start_panels).
        if [ -x /usr/bin/openbox ]; then
          write_rc_xml
          mkdir -p /usr/share/applications 2>/dev/null
          cat > /usr/share/applications/emux-openbox.desktop <<'OBDESK'
[Desktop Entry]
Type=Application
Name=Openbox (EmuX)
Exec=openbox
NoDisplay=true
X-GNOME-WMName=Openbox
X-GNOME-Autostart-Phase=WindowManager
X-MATE-Autostart-Phase=WindowManager
X-MATE-AutoRestart=true
OBDESK
          gsettings set org.mate.session.required-components windowmanager 'emux-openbox' 2>/dev/null
        fi
        echo "emux-x11: MATE tuned for Xvfb (openbox WM, no required caja, compositor/screensaver/lock off)" >&2
      fi
      echo "emux-x11: launching full session $WM_BIN (bus: ${DBUS_SESSION_BUS_ADDRESS:-none})" >&2
      nohup "$WM_BIN" >/tmp/wm.log 2>&1 </dev/null & ;;
    *)
      echo "emux-x11: launching fallback WM $WM_BIN" >&2
      nohup "$WM_BIN" >/tmp/wm.log 2>&1 </dev/null & ;;
  esac
  WM_PID=$!
  sleep 1
  if kill -0 "$WM_PID" 2>/dev/null; then
    touch /tmp/emux_wm_launched
    # v0.2.78: publish which WM is running. The app paints it on the badge and
    # the escalation ladder reads it so it never "falls back" to the same WM.
    basename "$WM_BIN" > /tmp/emux_wm_mode 2>/dev/null
    echo "emux-x11: WM alive (pid $WM_PID, $WM_BIN)" >&2
    return 0
  fi
  echo "emux-x11: WM DIED within 1 s of launch ($WM_BIN) - wm.log tail:" >&2
  tail -5 /tmp/wm.log >&2 2>/dev/null
  # v0.2.101: a full session that cannot stand up (GNOME Shell wants real GL
  # and gets software rendering under proot+Xvfb; Xfce needs less but can
  # still die on a missing bus) must not leave the user a bare root window -
  # fall straight back to the seeded openbox desktop this once.
  if [ "$1" != "openbox" ]; then
    echo "emux-x11: session $1 could not start - falling back to openbox (this session)" >&2
    # v0.2.103: preserve the session's death log BEFORE the openbox fallback
    # truncates wm.log. vc202 field: gnome-session died instantly and the
    # fallback's own silent relaunch emptied wm.log, so there was NO EVIDENCE
    # why - the exact line this app lives on. /tmp/wm_session.log now holds
    # the session's stderr for the next diagnosis.
    [ -s /tmp/wm.log ] && cp /tmp/wm.log /tmp/wm_session.log 2>/dev/null
    start_wm openbox && return 0
  fi
  return 1
}
# v0.2.59: guarantee a visible root window BEFORE any client starts. The old
# path relied on pcmanfm --desktop painting a wallpaper; when pcmanfm wedged
# (a known failure mode under proot, see the wedge watchdog below) the root
# stayed pure black and "no desktop" was indistinguishable from "no frames".
# A solid colour costs one xsetroot call and makes a black pane unambiguous.
paint_root() {
  command -v xsetroot >/dev/null 2>&1 || return 0
  [ -e /tmp/emux_root_painted ] && return 0
  touch /tmp/emux_root_painted 2>/dev/null
  xsetroot -solid '#20344d' >/dev/null 2>&1 || xsetroot -solid '#20344d' >/dev/null 2>&1
  echo "emux-x11: root window painted #20344d (never a black void)" >&2
}
# v0.2.39: bring desktop furniture up the moment it exists - called from
# the REST pass right after install AND from the visibility watchdog, so
# panel/icons/menu appear live without waiting for a session restart.
# v0.2.108: pidfile liveness - two tint2 instances (dock + tray) share one
# argv[0], so running0 cannot tell them apart.
pid_alive() {
  # v0.2.112: read + kill are shell builtins - no traced exec per check
  [ -s "$1" ] || return 1
  read -r PA_PID < "$1" 2>/dev/null || return 1
  [ -n "$PA_PID" ] && kill -0 "$PA_PID" 2>/dev/null
}
# v0.2.116 CENTRED TASKBAR: the EmuX dock (v0.2.114 arrangement) is the
# taskbar under MATE and everywhere else: centred, auto-hiding, start
# button (jgmenu), pinned apps (incl. a Settings launcher when the MATE
# control center is installed), open windows, tray, clock. The slim left
# rail stays (see start_panels).
start_panels() {
  # v0.2.116: the centred auto-hiding dock (v0.2.114) is the taskbar again
  # under MATE and everywhere else - mate-panel (v0.2.115's full-width
  # experiment) is retired; the jgmenu start menu + a Settings launcher on
  # the dock (mate-control-center) cover the "settings menu from mate"
  # the user actually missed.
  if [ -x /usr/bin/tint2 ] && ! pid_alive /tmp/emux_tint2.pid; then
    echo "emux-x11: starting tint2 dock (centred taskbar)" >&2
    nohup /usr/bin/tint2 >/tmp/tint2.log 2>&1 </dev/null &
    T2PID=$!
    echo "$T2PID" > /tmp/emux_tint2.pid 2>/dev/null
    sleep 1
    if kill -0 "$T2PID" 2>/dev/null; then
      echo "emux-x11: tint2 panel alive (pid $T2PID)" >&2
    else
      T2S=$(( $(cat /tmp/emux_tint2_strikes 2>/dev/null || echo 0) + 1 ))
      echo "$T2S" > /tmp/emux_tint2_strikes 2>/dev/null
      if [ "$T2S" -le 3 ]; then
        echo "emux-x11: tint2 DIED within 1s of launch (strike $T2S) - tint2.log tail:" >&2
        tail -4 /tmp/tint2.log >&2 2>/dev/null
      else
        echo "emux-x11: tint2 DIED within 1s of launch (strike $T2S, tail already shown)" >&2
      fi
      # v0.2.113 (field: the dock was replaced by the distro's default
      # bar for good). Two quick deaths used to move the EmuX config aside
      # and set the PERMANENT keep-tint2rc opt-out - but tint2 also dies
      # instantly when the display is not answering yet (early in a session,
      # mid display rotation), so a perfectly good config got retired
      # forever. Now: a death only counts while X answers, and the fallback
      # is the distro panel for THIS session only - the config is untouched.
      if command -v xdpyinfo >/dev/null 2>&1 && ! xdpyinfo >/dev/null 2>&1; then
        T2S=$((T2S - 1)); echo "$T2S" > /tmp/emux_tint2_strikes 2>/dev/null
        rm -f /tmp/emux_tint2.pid   # retry on a later tick, once X answers
      elif [ "$T2S" -ge 2 ] && [ -r /etc/xdg/tint2/tint2rc ]; then
        nohup /usr/bin/tint2 -c /etc/xdg/tint2/tint2rc >/tmp/tint2-fallback.log 2>&1 </dev/null &
        echo "$!" > /tmp/emux_tint2.pid 2>/dev/null
        echo "emux-x11: EmuX dock keeps dying - distro default panel for this session (config kept)" >&2
      fi
    fi
  fi
  if [ -x /usr/bin/tint2 ] && [ -e "$HOME/.config/tint2/emux-tray.tint2rc" ] && ! pid_alive /tmp/emux_tray.pid; then
    nohup /usr/bin/tint2 -c "$HOME/.config/tint2/emux-tray.tint2rc" >/tmp/tint2-tray.log 2>&1 </dev/null &
    echo "$!" > /tmp/emux_tray.pid 2>/dev/null
    echo "emux-x11: tray bar started (pid $!)" >&2
  fi
  # v0.2.114: slim left rail (clock + desktop switcher) beside the dock.
  if [ -x /usr/bin/tint2 ] && [ -e "$HOME/.config/tint2/emux-rail.tint2rc" ] && ! pid_alive /tmp/emux_rail.pid; then
    nohup /usr/bin/tint2 -c "$HOME/.config/tint2/emux-rail.tint2rc" >/tmp/tint2-rail.log 2>&1 </dev/null &
    echo "$!" > /tmp/emux_rail.pid 2>/dev/null
    echo "emux-x11: left rail started (pid $!)" >&2
  fi
}
# v0.2.111 CLIPBOARD BRIDGE, guest side: X CLIPBOARD <-> the app, through
# two files in /tmp (see DesktopService "CLIPBOARD BRIDGE"). Runs for every
# desktop kind - a full session owns its panels, not the clipboard.
start_clipd() {
  pid_alive /tmp/emux_clipd.pid && return 0
  cat > /tmp/emux-clipd <<'CLIPD'
#!/bin/sh
# EmuX clipboard bridge (v0.2.111). Waits for xclip while it installs.
IN=/tmp/emux_clip_in; OUT=/tmp/emux_clip_out; LAST=/tmp/emux_clip_last
T=""; command -v timeout >/dev/null 2>&1 && T="timeout 3"
while ! command -v xclip >/dev/null 2>&1; do sleep 5; done
: > "$LAST"
while :; do
  # tablet -> Linux: own both selections (Ctrl+V and middle-click paste)
  if [ -e "$IN" ] && mv -f "$IN" "$IN.cur" 2>/dev/null; then
    if [ -s "$IN.cur" ]; then
      xclip -selection clipboard -i < "$IN.cur" >/dev/null 2>&1
      xclip -selection primary -i < "$IN.cur" >/dev/null 2>&1
      cp -f "$IN.cur" "$LAST" 2>/dev/null
    fi
    rm -f "$IN.cur"
  fi
  # Linux -> tablet: hand over CLIPBOARD whenever it holds new text (bounded:
  # an owner that never answers must not wedge the bridge)
  if $T xclip -selection clipboard -o > "$OUT.part" 2>/dev/null && [ -s "$OUT.part" ] \
     && ! cmp -s "$OUT.part" "$LAST"; then
    cp -f "$OUT.part" "$LAST" 2>/dev/null
    mv -f "$OUT.part" "$OUT" 2>/dev/null
  fi
  # v0.2.112: every command here is a ptrace-mediated exec under proot -
  # 2 s cadence; OUT.part is simply overwritten next round (no rm per loop).
  sleep 2
done
CLIPD
  nohup sh /tmp/emux-clipd >/dev/null 2>&1 </dev/null &
  echo "$!" > /tmp/emux_clipd.pid 2>/dev/null
  echo "emux-x11: clipboard bridge started (pid $!)" >&2
}
# v0.2.112: seed_desktop_config rewrites a dozen config files - every one a
# traced exec under proot - and start_furniture ran it on EVERY governor tick
# (5 s, 20 min). Seed once per session, and again only when the set of
# installed programs changes (the governor installing furniture mid-session).
seed_if_changed() {
  SEED_SIG=""
  for SB in xterm pcmanfm mousepad galculator gnome-calculator firefox firefox-esr \
            chromium chromium-browser jgmenu tint2 xclip openbox picom mate-control-center; do
    [ -x "/usr/bin/$SB" ] && SEED_SIG="$SEED_SIG$SB,"
  done
  SEED_OLD=""
  [ -r /tmp/emux_seed_sig ] && read -r SEED_OLD < /tmp/emux_seed_sig 2>/dev/null
  [ -n "$SEED_SIG" ] && [ "$SEED_SIG" = "$SEED_OLD" ] && return 0
  seed_desktop_config
  echo "$SEED_SIG" > /tmp/emux_seed_sig 2>/dev/null
}
start_furniture() {
  # v0.2.113: no guest clipboard helper any more - the app owns the X
  # selections itself (X11Clipboard). Stop a v0.2.111/112 emux-clipd if one
  # survived from before the update.
  if pid_alive /tmp/emux_clipd.pid; then
    read -r OLDCLIPD < /tmp/emux_clipd.pid 2>/dev/null && kill "$OLDCLIPD" 2>/dev/null
    rm -f /tmp/emux_clipd.pid
  fi
  # v0.2.101: paint the root FIRST so a black pane stays unambiguous even
  # while a full session is taking over, then keep the EmuX furniture OFF the
  # session's desktop - a session manager (gnome-session / startxfce4 via
  # start_wm) brings its own panel, icons and background, and seeded tint2 +
  # pcmanfm --desktop stacked on top fight it for the root window. The mode
  # file is written by start_wm, which always runs before this.
  paint_root
  SF_MODE=openbox
  [ -r /tmp/emux_wm_mode ] && read -r SF_MODE < /tmp/emux_wm_mode 2>/dev/null
  case "${SF_MODE:-openbox}" in
    mate-session|mate-session-binary)
      # v0.2.116: the centred EmuX tint2 dock is the MATE panel again
      # (mate-panel retired - see start_wm). No pcmanfm desktop: MATE
      # draws its own background.
      seed_if_changed
      start_panels
      return 0 ;;
    gnome-session|gnome-session-binary|gnome-shell|startxfce4|xfce4-session|startlxqt|lxqt-session|lxsession)
      echo "emux-x11: full-session desktop owns the furniture - EmuX panel/icons skipped" >&2
      return 0 ;;
  esac
  seed_if_changed
  # v0.2.59: picom is now OPT-IN (touch /tmp/emux_want_picom). Two reasons,
  # both measured rather than guessed:
  #  1. The video path is a full-screen `xwd -root` grab at ~10 fps. A
  #     compositing manager redirects every client to an offscreen pixmap and
  #     re-composites onto the root, i.e. one extra full-screen render per
  #     frame to buy translucency and shadows that a 10 fps screenshot stream
  #     cannot display smoothly anyway.
  #  2. It is a large long-lived client. On a 1-2 GB device that makes it a
  #     prime low-memory-killer candidate, and an unprivileged app CANNOT lower
  #     oom_score_adj (that needs CAP_SYS_RESOURCE), so the v0.2.47 "-300"
  #     protection on the terminal's proot silently fails while the desktop's
  #     "+100" succeeds. When the LMK reaps the terminal's proot, its tracee
  #     reports exactly the user's symptom: "proot warning: signal 11".
  if [ -x /usr/bin/picom ] && [ -e /tmp/emux_want_picom ] && ! running0 picom; then
    echo "emux-x11: starting picom compositor (opt-in via /tmp/emux_want_picom)" >&2
    nohup /usr/bin/picom -b --backend xrender >/tmp/picom.log 2>&1 </dev/null &
  fi
  # v0.2.88: tint2 launch is now VERIFIED one second in. On the field device
  # the panel was absent from a working desktop with no line anywhere saying
  # why - a tint2 that dies instantly used to leave /tmp/tint2.log that no
  # code path ever read. Strikes: 2nd death moves the seeded tint2rc aside
  # (a bad generated config is THE classic tint2 instant-crash cause) and
  # drops the keep-tint2rc marker so seed_desktop_config does not recreate
  # it on the next tick - the distro default panel config is plain but it
  # EXISTS. Every death narrates its log tail so the pane names the killer.
  start_panels
  if [ -x /usr/bin/pcmanfm ] && ! running0 pcmanfm; then
    echo "emux-x11: starting pcmanfm desktop (icons)" >&2
    # v0.2.58 FIELD FIX: starve pcmanfm of DBUS/GIO at launch. Under proot a
    # --desktop client that reaches for a dead/hung session bus or gvfs parks
    # in a blocking read BEFORE it ever paints the root window: black root,
    # no icons - and a wedged GTK client can sit on the pointer grab,
    # swallowing every injected click while xdotool still returns rc=0.
    # A disabled bus address + no GIO volume monitors removes both waits.
    touch /tmp/emux_pcmanfm_started
    nohup env DBUS_SESSION_BUS_ADDRESS=disabled: GIO_USE_VOLUME_MONITOR=none \
      /usr/bin/pcmanfm --desktop >/tmp/pcmanfm.log 2>&1 </dev/null &
  fi
  if { [ -e "$HOME/.config/openbox/menu.xml" ] || [ -e "$HOME/.themes/Emux/openbox-3/themerc" ]; } && [ ! -e /tmp/emux_obx_reconf ]; then
    echo "emux-x11: menu/theme present - openbox --reconfigure" >&2
    touch /tmp/emux_obx_reconf
    command -v openbox >/dev/null 2>&1 && openbox --reconfigure >/dev/null 2>&1 &
  fi
  # v0.2.45: first-run welcome, once ever. A GUI desktop needs an on-screen
  # explanation, not a terminal prompt: how to double-click icons, use the
  # bottom bar, and right-click for the full menu. Mousepad only; if the
  # editor is missing, skip silently rather than falling back to a terminal.
  if [ ! -e "$HOME/.config/emux-desktop-welcomed" ] && [ -x /usr/bin/mousepad ] \
     && [ -e "$HOME/Desktop/Welcome.txt" ]; then
    touch "$HOME/.config/emux-desktop-welcomed" 2>/dev/null
    nohup /usr/bin/mousepad "$HOME/Desktop/Welcome.txt" >/tmp/mousepad.log 2>&1 </dev/null &
  fi
}
# v0.2.45: FULL VISUAL DESKTOP CONFIG, seeded by the script itself.
# Why this exists: v0.2.37-0.2.44 installed tint2 + pcmanfm but shipped
# NO config for them, so what the user actually got depended on distro
# defaults: a bare tint2 panel (or none, if the REST apt pass failed),
# an empty pcmanfm desktop (~/Desktop had no icons), and a Debian
# openbox menu that was often empty. That is exactly the field report:
# "some versions show a terminal, others a black screen" - the only
# window guaranteed on every version was the forced xterm, and a bare
# openbox root window with no panel/icons reads as a black screen.
# This function writes, idempotently, the four pieces that make it a
# desktop instead of a root window: (1) .desktop launchers for the apps
# that are actually installed, in ~/.local/share/applications and on
# ~/Desktop, (2) a tint2 panel config: bottom bar, app launchers on the
# left, running tasks in the middle, tray + clock on the right,
# (3) an Openbox right-click menu with the same apps, and (4) an
# openbox autostart that brings the panel + icons up with the WM.
# Launchers/menu entries are built ONLY for binaries present on disk,
# and the tint2 config is rewritten only when the installed-app set
# changes, so a later REST install adds its icons live (start_furniture
# calls this) without clobbering a hand-edited config on every open.
# v0.2.85: PER-FILE OPT-OUT of the rice re-seed. Everything below is
# regenerated under version stamps on every launch - that is how the field
# fixes reach every device reliably ("write once if absent" lost the
# click-swallow audit badly, see write_rc_xml) - but a user who themes their
# own desktop needs the seeder to keep its hands off THEIR files. Drop an
# empty marker into ~/.config/emux/ and that config is yours permanently:
#   ~/.config/emux/keep-tint2rc    never rewrite the tint2 panel again
#   ~/.config/emux/keep-autostart  never rewrite the openbox autostart again
#   ~/.config/emux/keep-pcmanfm    never touch pcmanfm.conf, the per-screen
#                                  desktop-items-0.conf, or libfm.conf again
# EmuX-owned files (.desktop launchers, Welcome.txt, the Emux theme, rc.xml -
# whose rewrite is the click-swallow FIX) are still seeded regardless; the
# rc.xml audit always runs and `doctor` always reports what it found.
emux_keep() { [ -e "$HOME/.config/emux/keep-$1" ]; }
seed_desktop_config() {
  # v0.2.113 MIGRATION: the old 2-strike fallback left keep-tint2rc next to a
  # tint2rc.crashed and NO tint2rc - that is the automatic marker, not a user
  # opt-out (a user who keeps their own panel has a tint2rc). Undo it once.
  if [ -e "$HOME/.config/emux/keep-tint2rc" ] && [ -e "$HOME/.config/tint2/tint2rc.crashed" ] && \
     [ ! -e "$HOME/.config/tint2/tint2rc" ]; then
    rm -f "$HOME/.config/emux/keep-tint2rc" "$HOME/.config/tint2/tint2rc.crashed"
    echo "emux-x11: removed the automatic keep-tint2rc marker - the EmuX dock is back" >&2
  fi
  mkdir -p "$HOME/.local/share/applications" "$HOME/Desktop" \
    "$HOME/.config/tint2" "$HOME/.config/openbox" "$HOME/.config/pcmanfm/default" 2>/dev/null
  # v0.2.66 FIX (input-dead audit): on a phone, opening things must not depend
  # on click timing. pcmanfm/libfm activate desktop items on a DOUBLE click by
  # default; double-tap now reaches X as a real double-click, but libfm also
  # offers single-click-to-open, which is the friendlier contract for touch.
  # Only seed it when the user has no opinion yet - never overwrite a choice.
  if emux_keep pcmanfm; then
    echo "emux-x11: keep-pcmanfm marker - libfm/pcmanfm configs left alone" >&2
  else
  mkdir -p "$HOME/.config/libfm" 2>/dev/null
  if [ ! -e "$HOME/.config/libfm/libfm.conf" ]; then
    printf '[config]\nsingle_click=1\n' > "$HOME/.config/libfm/libfm.conf" 2>/dev/null
  elif ! grep -q '^single_click=' "$HOME/.config/libfm/libfm.conf" 2>/dev/null; then
    printf 'single_click=1\n' >> "$HOME/.config/libfm/libfm.conf" 2>/dev/null
  fi
  fi
  # --- .desktop launchers (only for installed apps) ---
  APPS=""
  if [ -x /usr/bin/xterm ]; then
    cat > "$HOME/.local/share/applications/emux-terminal.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Terminal
Comment=Terminal (only if you need it - the desktop itself is graphical)
Exec=xterm
Icon=utilities-terminal
Categories=System;TerminalEmulator;
EOF
    APPS="$APPS terminal"
  fi
  if [ -x /usr/bin/pcmanfm ]; then
    cat > "$HOME/.local/share/applications/emux-files.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Files
Comment=Browse files, folders and drives
Exec=pcmanfm
Icon=system-file-manager
Categories=System;FileManager;
EOF
    APPS="$APPS files"
  fi
  if [ -x /usr/bin/mousepad ]; then
    cat > "$HOME/.local/share/applications/emux-editor.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Text Editor
Comment=Write and edit text files
Exec=mousepad
Icon=accessories-text-editor
Categories=Utility;TextEditor;
EOF
    APPS="$APPS editor"
  fi
  if [ -x /usr/bin/galculator ]; then
    cat > "$HOME/.local/share/applications/emux-calculator.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Calculator
Exec=galculator
Icon=accessories-calculator
Categories=Utility;Calculator;
EOF
    APPS="$APPS calculator"
  fi
  if [ -x /usr/bin/mate-control-center ]; then
    cat > "$HOME/.local/share/applications/emux-settings.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Settings
Comment=MATE control center - appearance, display, keyboard, sound and more
Exec=mate-control-center
Icon=preferences-system
Categories=Settings;
EOF
    APPS="$APPS settings"
  fi
  BROWSER=""
  # v0.2.94 FIELD FIX (browser icon never opened / never appeared):
  # (1) firefox-esr was missing from the scan, so a rootfs with ONLY
  #     firefox-esr installed seeded no browser icon at all;
  # (2) on Ubuntu noble the plain `firefox` deb is a snap-transition
  #     stub - it can never start inside proot (no snapd), so the seeded
  #     icon silently did nothing when tapped. Scan firefox-esr FIRST,
  #     name the launcher after the browser that actually runs, and
  #     launch via env MOZ_DISABLE_CONTENT_SANDBOX=1: proot cannot host
  #     Firefox's seccomp sandbox, and without this Firefox dies right
  #     after launch. The env var is harmless to non-Mozilla browsers.
  for b in firefox-esr firefox chromium chromium-browser google-chrome; do
    if command -v "$b" >/dev/null 2>&1; then BROWSER="$b"; break; fi
  done
  if [ -n "$BROWSER" ]; then
    BNAME="Web Browser"; BICON=web-browser
    case "$BROWSER" in
      firefox-esr) BNAME="Firefox ESR"; BICON=firefox-esr ;;
    esac
    cat > "$HOME/.local/share/applications/emux-browser.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$BNAME
Exec=env MOZ_DISABLE_CONTENT_SANDBOX=1 $BROWSER %u
Icon=$BICON
Categories=Network;WebBrowser;
EOF
    APPS="$APPS browser"
  fi
  for f in "$HOME"/.local/share/applications/emux-*.desktop; do
    [ -e "$f" ] || continue
    cp "$f" "$HOME/Desktop/" 2>/dev/null
    chmod +x "$f" "$HOME/Desktop/$(basename "$f")" 2>/dev/null
  done
  # --- Welcome text (desktop icon, opened once by start_furniture) ---
  if [ ! -e "$HOME/Desktop/Welcome.txt" ]; then
    cat > "$HOME/Desktop/Welcome.txt" <<'EOF'
Welcome to your EmuX desktop!

This is a visual desktop, not just a terminal:
- Double-click an icon on the desktop to open it (Files, Text Editor,
  Calculator, Web Browser if one is installed).
- The bar at the bottom is the taskbar: app icons on the left, your
  open windows in the middle, the clock on the right.
- Right-click anywhere on the desktop for the full menu (all apps,
  Restart Openbox if a window ever misbehaves).
- Tap the Terminal icon only when you actually want a terminal.
  Closing it does not close the desktop - the bar and icons stay.

If the bar or icons are ever missing, close the Desktop tab and
open it again: the desktop re-seeds its panel, menu and icons on
every start, and the log is in the Terminal tab.
EOF
  fi
  # --- v0.2.108: start-button icon - the first that exists, else a text button
  # (cached per session: a find over the icon trees is slow under proot)
  START_ICON=$(cat /tmp/emux_start_icon 2>/dev/null)
  [ -e /tmp/emux_start_icon ] || for n in start-here distributor-logo view-app-grid applications-other open-menu; do
    START_ICON=$(find /usr/share/icons /usr/share/pixmaps -name "$n.svg" 2>/dev/null | head -1)
    [ -n "$START_ICON" ] || START_ICON=$(find /usr/share/icons /usr/share/pixmaps -name "$n.png" 2>/dev/null | sort -t/ -k6 -r | head -1)
    [ -n "$START_ICON" ] && break
  done
  [ -e /tmp/emux_start_icon ] || echo "$START_ICON" > /tmp/emux_start_icon 2>/dev/null
  # --- tint2 panel config (bottom bar, launchers + tasks + tray + clock) ---
  STAMP="$HOME/.config/tint2/.emux-apps"
  OLD_APPS=""
  [ -e "$STAMP" ] && OLD_APPS=$(cat "$STAMP" 2>/dev/null)
  if emux_keep tint2rc; then
    echo "emux-x11: keep-tint2rc marker - the user's panel config is NOT rewritten" >&2
  elif [ ! -e "$HOME/.config/tint2/tint2rc" ] || [ "$APPS s$EMUX_SCALE v116" != "$OLD_APPS" ]; then
    if [ -e "$HOME/.config/tint2/tint2rc" ] && ! grep -q "EmuX" "$HOME/.config/tint2/tint2rc" 2>/dev/null; then
      cp "$HOME/.config/tint2/tint2rc" "$HOME/.config/tint2/tint2rc.emux-bak" 2>/dev/null
    fi
    S="$EMUX_SCALE"
    {
      echo "# EmuX tint2 panel (v0.2.116) - centred auto-hiding dock: start, apps, windows, tray, clock"
      # bg 1: the dock bubble
      echo "rounded = $((12 * S))"
      echo "border_width = 1"
      echo "background_color = #1b1f27 100"
      echo "border_color = #ffffff 14"
      # bg 2: active window / pressed
      echo "rounded = $((7 * S))"
      echo "border_width = 0"
      echo "background_color = #ffffff 22"
      echo "border_color = #ffffff 0"
      echo "background_color_hover = #ffffff 30"
      # bg 3: hover on idle items
      echo "rounded = $((7 * S))"
      echo "border_width = 0"
      echo "background_color = #ffffff 0"
      echo "border_color = #ffffff 0"
      echo "background_color_hover = #ffffff 14"
      echo "background_color_pressed = #ffffff 24"
      # v0.2.113: ONE centred unit - start, pinned apps, windows, tray, clock.
      # The separate tray pill had its own 2 px reveal strip at the far right
      # and the two hid/showed independently.
      echo "panel_items = PLTSC"
      echo "panel_monitor = all"
      echo "panel_position = bottom center horizontal"
      echo "panel_size = 94% $((52 * S))"
      echo "panel_shrink = 1"
      # v0.2.116 CENTRED DOCK RESTORED (field: "i want the centered taskbar
      # back because it had the settings menu from mate" - the v0.2.115
      # full-width mate-panel bar was the wrong reading of "mate center
      # bar"). Exactly the v0.2.114 dock again: centred, auto-hiding
      # (reveals via the app's bottom-edge poke, show timeout 0, 1.5 s
      # grace, 2 px reveal strip), no strut - maximized windows run to
      # the true screen edge.
      echo "panel_margin = 0 0"
      echo "autohide = 1"
      echo "autohide_show_timeout = 0"
      echo "autohide_hide_timeout = 1.5"
      echo "autohide_height = $((2 * S))"
      echo "panel_padding = $((8 * S)) $((4 * S)) $((6 * S))"
      echo "panel_background_id = 1"
      echo "panel_layer = top"
      echo "strut_policy = none"
      echo "wm_menu = 1"
      echo "mouse_effects = 1"
      echo "button = new"
      if [ -n "$START_ICON" ]; then echo "button_icon = $START_ICON"; echo "button_text = "
      else echo "button_text = Apps"; echo "button_font = sans bold 10"; echo "button_font_color = #ffffff 100"; fi
      echo "button_tooltip = Applications"
      echo "button_lclick_command = $HOME/.local/bin/emux-startmenu"
      echo "button_background_id = 3"
      echo "button_padding = $((6 * S)) $((4 * S)) 0"
      echo "button_max_icon_size = $((34 * S))"
      echo "launcher_padding = $((4 * S)) 0 $((6 * S))"
      echo "launcher_background_id = 0"
      echo "launcher_icon_background_id = 3"
      echo "launcher_icon_size = $((34 * S))"
      echo "launcher_tooltip = 1"
      for a in $APPS; do
        case "$a" in
          terminal) echo "launcher_item_app = $HOME/.local/share/applications/emux-terminal.desktop" ;;
          files) echo "launcher_item_app = $HOME/.local/share/applications/emux-files.desktop" ;;
          editor) echo "launcher_item_app = $HOME/.local/share/applications/emux-editor.desktop" ;;
          calculator) echo "launcher_item_app = $HOME/.local/share/applications/emux-calculator.desktop" ;;
          browser) echo "launcher_item_app = $HOME/.local/share/applications/emux-browser.desktop" ;;
          settings) echo "launcher_item_app = $HOME/.local/share/applications/emux-settings.desktop" ;;
        esac
      done
      echo "taskbar_mode = single_desktop"
      echo "taskbar_padding = $((6 * S)) 0 $((6 * S))"
      echo "taskbar_background_id = 0"
      echo "task_icon = 1"
      echo "task_text = 0"
      echo "task_tooltip = 1"
      echo "task_maximum_size = $((46 * S)) $((46 * S))"
      echo "task_padding = $((6 * S)) $((5 * S)) 0"
      echo "task_background_id = 3"
      echo "task_active_background_id = 2"
      echo "task_iconified_background_id = 3"
      echo "mouse_left = toggle_iconify"
      echo "mouse_middle = close"
      echo "mouse_right = close"
      echo "tooltip_font = sans 10"
      echo "tooltip_font_color = #ffffff 100"
      echo "tooltip_background_id = 1"
      echo "tooltip_padding = $((6 * S)) $((4 * S))"
      echo "systray = 1"
      echo "systray_padding = $((6 * S)) 0 $((6 * S))"
      echo "systray_background_id = 0"
      echo "systray_icon_size = $((22 * S))"
      echo "time1_format = %H:%M"
      echo "time1_font = sans bold 10"
      echo "time2_format = %d %b"
      echo "time2_font = sans 8"
      echo "clock_font_color = #ffffff 100"
      echo "clock_padding = $((8 * S)) 0"
      echo "clock_tooltip = %A %d %B %Y"
    } > "$HOME/.config/tint2/tint2rc" 2>/dev/null
    echo "$APPS s$EMUX_SCALE v116" > "$STAMP" 2>/dev/null
  fi
  # v0.2.113: the tray lives inside the dock now - retire the pill config
  # (start_panels and the autostart only launch it when this file exists).
  [ -e "$HOME/.config/tint2/emux-tray.tint2rc" ] && rm -f "$HOME/.config/tint2/emux-tray.tint2rc"
  # --- v0.2.114: slim left rail (vertical tint2: clock + desktop switcher) ---
  # Field: the wide (~130 px) vertical tint2 themes the user installed were
  # liked for the look but carried no taskbar and no start button (no way
  # to open Settings). This is the slim EmuX-native take (~40 px): clock
  # at the top, one taskbar section per desktop below (multi_desktop -
  # click an empty section to switch desktop, drag a task between
  # sections to move its window). Autohides exactly like the dock (2 px
  # reveal strip, instant show, 1.5 s grace), reserves nothing.
  if ! emux_keep tint2rc; then
    S="$EMUX_SCALE"
    {
      echo "# EmuX tint2 rail (v0.2.116) - slim vertical panel, left edge: clock + desktops"
      # bg 1: the rail bubble
      echo "rounded = $((8 * S))"
      echo "border_width = 1"
      echo "background_color = #1b1f27 100"
      echo "border_color = #ffffff 14"
      # bg 2: active window / active desktop
      echo "rounded = $((6 * S))"
      echo "border_width = 0"
      echo "background_color = #ffffff 22"
      echo "border_color = #ffffff 0"
      echo "background_color_hover = #ffffff 30"
      # bg 3: hover on idle items
      echo "rounded = $((6 * S))"
      echo "border_width = 0"
      echo "background_color = #ffffff 0"
      echo "border_color = #ffffff 0"
      echo "background_color_hover = #ffffff 14"
      echo "background_color_pressed = #ffffff 24"
      echo "panel_items = CT"
      echo "panel_monitor = all"
      echo "panel_position = center left vertical"
      echo "panel_size = $((40 * S)) 100%"
      echo "panel_margin = 0 0"
      echo "panel_padding = $((2 * S)) $((4 * S)) $((2 * S))"
      echo "panel_background_id = 1"
      echo "panel_layer = top"
      echo "strut_policy = none"
      echo "autohide = 1"
      echo "autohide_show_timeout = 0"
      echo "autohide_hide_timeout = 1.5"
      echo "autohide_height = $((2 * S))"
      echo "panel_window_name = emux-rail"
      echo "wm_menu = 1"
      echo "mouse_effects = 1"
      echo "time1_format = %H:%M"
      echo "time1_font = sans bold 10"
      echo "time2_format = %d %b"
      echo "time2_font = sans 8"
      echo "clock_font_color = #ffffff 100"
      echo "clock_padding = $((2 * S)) 0"
      echo "clock_tooltip = %A %d %B %Y"
      echo "taskbar_mode = multi_desktop"
      echo "taskbar_name = 1"
      echo "taskbar_name_font = sans 8"
      echo "taskbar_name_font_color = #ffffff 60"
      echo "taskbar_name_active_font_color = #ffffff 100"
      echo "taskbar_padding = $((2 * S)) 0 $((2 * S))"
      echo "taskbar_background_id = 0"
      echo "taskbar_active_background_id = 2"
      echo "task_icon = 1"
      echo "task_text = 0"
      echo "task_tooltip = 1"
      echo "task_maximum_size = $((28 * S)) $((28 * S))"
      echo "task_padding = $((2 * S)) $((2 * S)) 0"
      echo "task_background_id = 3"
      echo "task_active_background_id = 2"
      echo "task_iconified_background_id = 3"
      echo "mouse_left = toggle_iconify"
      echo "mouse_middle = close"
      echo "mouse_right = close"
      echo "tooltip_font = sans 10"
      echo "tooltip_font_color = #ffffff 100"
      echo "tooltip_background_id = 1"
      echo "tooltip_padding = $((6 * S)) $((4 * S))"
    } > "$HOME/.config/tint2/emux-rail.tint2rc" 2>/dev/null
  fi
  # --- v0.2.108: start menu (jgmenu: searchable app list, opens at the pointer) ---
  mkdir -p "$HOME/.local/bin" "$HOME/.config/jgmenu" 2>/dev/null
  cat > "$HOME/.local/bin/emux-startmenu" <<'SMENU'
#!/bin/sh
# EmuX start menu (v0.2.108). A second click on the button closes it.
if command -v jgmenu >/dev/null 2>&1; then
  pkill -x jgmenu 2>/dev/null && exit 0
  exec jgmenu --config-file="$HOME/.config/jgmenu/emux-jgmenurc"
fi
# The menu package is still installing (or offline): open a terminal instead
# of doing nothing - right-click on the desktop also lists every app.
exec x-terminal-emulator 2>/dev/null || exec xterm
SMENU
  chmod +x "$HOME/.local/bin/emux-startmenu" 2>/dev/null
  S="$EMUX_SCALE"
  {
    echo "# EmuX jgmenu (v0.2.108)"
    echo "csv_cmd = apps"
    echo "tint2_look = 0"
    echo "position_mode = pointer"
    echo "stay_alive = 0"
    echo "menu_width = $((300 * S))"
    echo "menu_padding_top = $((8 * S))"
    echo "menu_padding_right = $((6 * S))"
    echo "menu_padding_bottom = $((8 * S))"
    echo "menu_padding_left = $((6 * S))"
    echo "menu_radius = $((10 * S))"
    echo "menu_border = 1"
    echo "item_height = $((30 * S))"
    echo "item_padding_x = $((10 * S))"
    echo "item_radius = $((6 * S))"
    echo "icon_size = $((22 * S))"
    echo "font = Sans 10"
    echo "color_menu_bg = #1b1f27 96"
    echo "color_menu_border = #ffffff 14"
    echo "color_norm_fg = #eeeeee 100"
    echo "color_sel_bg = #3a6ea5 100"
    echo "color_sel_fg = #ffffff 100"
    echo "color_sep_fg = #ffffff 20"
  } > "$HOME/.config/jgmenu/emux-jgmenurc" 2>/dev/null
  # v0.2.111: xclip (clipboard bridge, emux-clipd) rides the same install.
  EXTRA_PKGS=""
  command -v jgmenu >/dev/null 2>&1 || EXTRA_PKGS="$EXTRA_PKGS jgmenu"
  # v0.2.112: a failed attempt (offline, unknown package) used to retry at
  # EVERY desktop start - a full apt/dpkg run under proot competing with the
  # desktop for minutes. Once a day now, at the lowest CPU priority.
  EXTRA_DAY=$(date +%Y%m%d)
  if [ -n "$EXTRA_PKGS" ] && [ ! -e /tmp/emux_jgmenu_tried ] && \
     [ "$(cat /var/lib/emux_extra_pkgs_day 2>/dev/null)" != "$EXTRA_DAY" ]; then
    touch /tmp/emux_jgmenu_tried 2>/dev/null
    echo "$EXTRA_DAY" > /var/lib/emux_extra_pkgs_day 2>/dev/null
    if command -v apt-get >/dev/null 2>&1; then
      echo "emux-x11: installing$EXTRA_PKGS in the background" >&2
      ( DEBIAN_FRONTEND=noninteractive nice -n 19 apt-get install -y --no-install-recommends \
          -o DPkg::Lock::Timeout=300 $EXTRA_PKGS >/tmp/emux_jgmenu.log 2>&1 ) </dev/null >/dev/null 2>&1 &
    elif command -v apk >/dev/null 2>&1; then
      ( nice -n 19 apk add --no-cache $EXTRA_PKGS >/tmp/emux_jgmenu.log 2>&1 ) </dev/null >/dev/null 2>&1 &
    fi
  fi
  # --- Openbox right-click menu (same apps, plus WM controls) ---
  if [ ! -e "$HOME/.config/openbox/menu.xml" ] || ! grep -q "EmuX v0.2.94" "$HOME/.config/openbox/menu.xml" 2>/dev/null; then
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<openbox_menu xmlns="http://openbox.org/3.4/menu">'
      echo '<menu id="root-menu" label="EmuX v0.2.94">'
      echo '  <menu id="cat-apps" label="Applications">'
      echo '    <menu id="cat-net" label="Internet">'
      [ -n "$BROWSER" ] && echo "      <item label=\"Web Browser\"><action name=\"Execute\"><command>env MOZ_DISABLE_CONTENT_SANDBOX=1 $BROWSER</command></action></item>"
      echo '    </menu>'
      echo '    <menu id="cat-office" label="Office">'
      [ -x /usr/bin/mousepad ] && echo '      <item label="Text Editor"><action name="Execute"><command>mousepad</command></action></item>'
      echo '    </menu>'
      echo '    <menu id="cat-acc" label="Accessories">'
      [ -x /usr/bin/xterm ] && echo '      <item label="Terminal"><action name="Execute"><command>xterm</command></action></item>'
      [ -x /usr/bin/pcmanfm ] && echo '      <item label="Files"><action name="Execute"><command>pcmanfm</command></action></item>'
      [ -x /usr/bin/galculator ] && echo '      <item label="Calculator"><action name="Execute"><command>galculator</command></action></item>'
      echo '    </menu>'
      echo '  </menu>'
      [ -x /usr/bin/xterm ] && echo '  <item label="Terminal"><action name="Execute"><command>xterm</command></action></item>'
      [ -x /usr/bin/pcmanfm ] && echo '  <item label="Files"><action name="Execute"><command>pcmanfm</command></action></item>'
      [ -x /usr/bin/mousepad ] && echo "  <item label=\"Desktop Help\"><action name=\"Execute\"><command>mousepad $HOME/Desktop/Welcome.txt</command></action></item>"
      echo '  <separator/>'
      echo '  <item label="Restart Openbox"><action name="Restart"/></item>'
      echo '  <item label="Reconfigure Openbox"><action name="Reconfigure"/></item>'
      echo '</menu>'
      echo '</openbox_menu>'
    } > "$HOME/.config/openbox/menu.xml" 2>/dev/null
  elif [ -e "$HOME/.config/openbox/menu.xml" ]; then
    cp "$HOME/.config/openbox/menu.xml" "$HOME/.config/openbox/menu.xml.emux-bak" 2>/dev/null
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!-- EmuX menu (v0.2.45): previous menu backed up to menu.xml.emux-bak -->'
      echo '<openbox_menu xmlns="http://openbox.org/3.4/menu">'
      echo '<menu id="root-menu" label="EmuX">'
      [ -x /usr/bin/xterm ] && echo '  <item label="Terminal"><action name="Execute"><command>xterm</command></action></item>'
      [ -x /usr/bin/pcmanfm ] && echo '  <item label="Files"><action name="Execute"><command>pcmanfm</command></action></item>'
      [ -x /usr/bin/mousepad ] && echo '  <item label="Text Editor"><action name="Execute"><command>mousepad</command></action></item>'
      [ -x /usr/bin/galculator ] && echo '  <item label="Calculator"><action name="Execute"><command>galculator</command></action></item>'
      [ -n "$BROWSER" ] && echo "  <item label=\"Web Browser\"><action name=\"Execute\"><command>env MOZ_DISABLE_CONTENT_SANDBOX=1 $BROWSER</command></action></item>"
      echo '  <separator/>'
      echo '  <item label="Restart Openbox"><action name="Restart"/></item>'
      echo '</menu>'
      echo '</openbox_menu>'
    } > "$HOME/.config/openbox/menu.xml" 2>/dev/null
  fi
  # --- pcmanfm desktop background ----------------------------------------
  # v0.2.60 FIELD FIX. Three separate defects, each measured with a pixel
  # census of the root window (tools/x11probe/desktop_paint_test.sh), and each
  # of which ALONE was enough to leave the desktop pure black on a real
  # install even after v0.2.59 guaranteed a painted root:
  #  1. NO DIRECTORY. This block wrote pcmanfm.conf with `2>/dev/null` but
  #     never mkdir'd ~/.config/pcmanfm/default - a directory that does not
  #     exist until pcmanfm has run once. On a fresh install the write failed
  #     silently, so the rice never existed at all.
  #  2. `wallpaper_mode=6` is not a value pcmanfm understands. The key takes a
  #     STRING (none|color|stretch|fit|center|tile|crop). Given an unparseable
  #     mode, pcmanfm ignores `wallpaper=` entirely and paints only
  #     desktop_bg, so the shipped wall.png was never displayed on any device.
  #  3. THE AUTHORITATIVE FILE IS THE PER-SCREEN ONE. Background, wallpaper
  #     and icon layout live in
  #     ~/.config/pcmanfm/default/desktop-items-0.conf, which OVERRIDES the
  #     [desktop] section of pcmanfm.conf. pcmanfm creates that file on its
  #     first run with `desktop_bg=#000000`, so every install that had opened
  #     the desktop before this fix stayed 100% black forever - and xsetroot
  #     could not rescue it, because pcmanfm paints its own root pixmap
  #     (_XROOTPMAP_ID) over whatever the root background was.
  # desktop_bg is now the same #20344d paint_root uses, so even with no
  # wallpaper on disk the desktop is visibly navy: the "never a black void"
  # contract finally holds on the layer the user is actually looking at.
  EMUX_RICE_STAMP="Emux rice v0.2.60"
  EMUX_WALL=/usr/share/emux/wall.png
  if [ -e "$EMUX_WALL" ]; then
    EMUX_WALL_MODE=crop   # fill the screen and crop the overflow: no distortion
  else
    EMUX_WALL_MODE=color  # nothing to show: solid colour, never black
    EMUX_WALL=""
  fi
  PFD="$HOME/.config/pcmanfm/default"
  mkdir -p "$PFD" 2>/dev/null
  if emux_keep pcmanfm; then
    : # keep-pcmanfm: the user's pcmanfm.conf is theirs - no rewrite, no repair
  elif [ ! -e "$PFD/pcmanfm.conf" ] || \
     ! grep -qF "$EMUX_RICE_STAMP" "$PFD/pcmanfm.conf" 2>/dev/null; then
    {
      echo "# $EMUX_RICE_STAMP"
      echo "[desktop]"
      echo "wallpaper_mode=$EMUX_WALL_MODE"
      echo "wallpaper=$EMUX_WALL"
      echo "desktop_bg=#20344d"
      echo "desktop_fg=#e8eaf0"
      echo "desktop_shadow=1"
      echo "show_wm_menu=1"
      echo "[config]"
      echo "icon_theme=Adwaita"
    } > "$PFD/pcmanfm.conf" 2>/dev/null
  fi
  # Defect 3: the per-screen desktop layer. Written in full when absent. When
  # it already exists it is repaired ONLY if it is still pcmanfm's own
  # untouched default (pure black background AND no wallpaper path): a user
  # who deliberately chose a colour or a wallpaper is left exactly alone, and
  # icon layout/sort order survive either way - just the background keys are
  # rewritten. Idempotent: once repaired, the gate no longer matches.
  PFI="$PFD/desktop-items-0.conf"
  if emux_keep pcmanfm; then
    : # keep-pcmanfm also owns the per-screen desktop layer
  elif [ ! -e "$PFI" ]; then
    {
      echo "# $EMUX_RICE_STAMP"
      echo "[*]"
      echo "wallpaper_mode=$EMUX_WALL_MODE"
      echo "wallpaper_common=1"
      echo "wallpaper=$EMUX_WALL"
      echo "desktop_bg=#20344d"
      echo "desktop_fg=#e8eaf0"
      echo "desktop_shadow=#000000"
      echo "desktop_font=Sans 12"
      echo "show_wm_menu=1"
      echo "sort=mtime;ascending;"
      echo "show_documents=0"
      echo "show_trash=1"
      echo "show_mounts=0"
    } > "$PFI" 2>/dev/null
  elif grep -q "^desktop_bg=#000000" "$PFI" 2>/dev/null && \
       ! grep -q "^wallpaper=/." "$PFI" 2>/dev/null; then
    echo "emux-x11: repairing pcmanfm's untouched black desktop defaults" >&2
    EMUX_BG_SEEN=0; EMUX_MODE_SEEN=0; EMUX_WP_SEEN=0
    {
      echo "# $EMUX_RICE_STAMP"
      while IFS= read -r EMUX_L; do
        case "$EMUX_L" in
          desktop_bg=*)     echo "desktop_bg=#20344d"; EMUX_BG_SEEN=1 ;;
          wallpaper_mode=*) echo "wallpaper_mode=$EMUX_WALL_MODE"; EMUX_MODE_SEEN=1 ;;
          wallpaper=*)      echo "wallpaper=$EMUX_WALL"; EMUX_WP_SEEN=1 ;;
          show_wm_menu=*)   echo "show_wm_menu=1" ;;
          \#*rice*)         : ;;
          *)                echo "$EMUX_L" ;;
        esac
      done < "$PFI"
      # pcmanfm's own default file carries NO wallpaper= key at all, so
      # rewriting existing keys alone would leave mode=crop pointing at
      # nothing and fall back to the solid colour. Append whatever is absent;
      # the file has a single [*] group, so EOF is still inside it.
      [ "$EMUX_BG_SEEN" = 1 ]   || echo "desktop_bg=#20344d"
      [ "$EMUX_MODE_SEEN" = 1 ] || echo "wallpaper_mode=$EMUX_WALL_MODE"
      [ "$EMUX_WP_SEEN" = 1 ]   || echo "wallpaper=$EMUX_WALL"
    } > "$PFI.emux-tmp" 2>/dev/null && mv "$PFI.emux-tmp" "$PFI" 2>/dev/null
  fi
  # --- Emux openbox theme: flat dark, blue active title, rounded 6 ---
  mkdir -p "$HOME/.themes/Emux/openbox-3" 2>/dev/null
  cat > "$HOME/.themes/Emux/openbox-3/themerc" 2>/dev/null <<'THEME'
# Emux theme v0.2.51 - flat dark, modern
border.width: 1
padding.width: 6
window.active.border.color: #3a6ea5
window.inactive.border.color: #232733
window.active.title.bg: flat solid
window.active.title.bg.color: #232733
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1a1d24
window.active.label.text.color: #e8eaf0
window.inactive.label.text.color: #868c98
window.active.button.unpressed.image.color: #9aa0ac
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.image.color: #4a4f5a
window.inactive.button.unpressed.image.color: #6a707c
menu.border.color: #232733
menu.border.width: 1
menu.title.bg: flat solid
menu.title.bg.color: #232733
menu.title.text.color: #e8eaf0
menu.items.bg: flat solid
menu.items.bg.color: #1a1d24
menu.items.text.color: #d8dbe2
menu.items.disabled.text.color: #6a707c
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3a6ea5
menu.items.active.text.color: #ffffff
menu.separator.color: #2a2f3a
menu.separator.padding.width: 6
osd.bg: flat solid
osd.bg.color: #1a1d24
osd.active.label.text.color: #e8eaf0
osd.inactive.label.text.color: #868c98
THEME
  # --- rc.xml: STAMPED AND REFRESHED (v0.2.78 click-swallow fix) ----------
  # This used to be `if [ ! -e rc.xml ]`, which is exactly why a config left
  # behind by an older version survived every app update and kept swallowing
  # every click. write_rc_xml() rewrites whenever its stamp does not match and
  # backs a foreign file up instead of trusting it; see the long comment above
  # start_wm() for the Openbox/xorg evidence.
  write_rc_xml
  # Audit the file Openbox will ACTUALLY read - which is the distro default
  # when ours could not be written. Frame/Client/Desktop are the only contexts
  # that make Openbox XGrabButton(); any of them means clicks will not reach
  # applications. Publish it so the pane, `doctor` and the app can all say so.
  RCX_EFF=$(rc_xml_effective)
  RCX_BAD=$(rc_xml_grab_contexts "$RCX_EFF")
  echo "${RCX_BAD:-none}" | tr -d ' \n' > /tmp/emux_rcxml_grabs 2>/dev/null
  echo "$RCX_EFF" > /tmp/emux_rcxml_file 2>/dev/null
  if [ -n "$RCX_BAD" ]; then
    echo "emux-x11: WARNING - $RCX_EFF binds grab-context(s): $RCX_BAD" >&2
    echo "emux-x11: Openbox will XGrabButton() those and every injected click dies there. Rewriting it now." >&2
    # Last resort: the effective file is NOT ours (HOME unwritable, or a
    # read-only system default). Neutralise the system default in place when we
    # can, because Openbox reads it whenever our own file is missing.
    if [ "$RCX_EFF" != "$HOME/.config/openbox/rc.xml" ] && [ -w "$RCX_EFF" ]; then
      cp "$RCX_EFF" "$RCX_EFF.emux-bak" 2>/dev/null
      sed -e '/<context name="Client">/,/<\/context>/d' \
          -e '/<context name="Desktop">/,/<\/context>/d' \
          -e '/<context name="Frame">/,/<\/context>/d' "$RCX_EFF" > "$RCX_EFF.emux-tmp" 2>/dev/null && \
        mv "$RCX_EFF.emux-tmp" "$RCX_EFF" 2>/dev/null && \
        echo "emux-x11: stripped Frame/Client/Desktop contexts from $RCX_EFF (backup: $RCX_EFF.emux-bak)" >&2
    fi
    RCX_BAD=$(rc_xml_grab_contexts "$(rc_xml_effective)")
    echo "${RCX_BAD:-none}" | tr -d ' \n' > /tmp/emux_rcxml_grabs 2>/dev/null
    [ -n "$RCX_BAD" ] && echo "emux-x11: STILL bound after the rewrite ($RCX_BAD) - the app-side button probe will escalate (impervious XTEST / WM switch)" >&2
  else
    echo "emux-x11: rc.xml audit clean ($RCX_EFF binds no Frame/Client/Desktop context)" >&2
  fi
  # --- tint2 refresh: darker bar, bigger icons (rewrite once per stamp) ---
  if ! emux_keep tint2rc && [ -e "$HOME/.config/tint2/tint2rc" ] && ! grep -q "EmuX tint2 panel (v0.2.116)" "$HOME/.config/tint2/tint2rc" 2>/dev/null; then
    cp "$HOME/.config/tint2/tint2rc" "$HOME/.config/tint2/tint2rc.pre-rice" 2>/dev/null
    rm -f "$HOME/.config/tint2/tint2rc" 2>/dev/null
  fi
  # --- Openbox autostart -------------------------------------------------
  # v0.2.59: this file is now ACTUALLY EXECUTED (start_wm passes it to
  # `openbox --startup`; bare `openbox` ignored it entirely, per
  # openbox.org/help/Autostart). Two consequences, both fixed here:
  #  1. The old version gate grepped for "EmuX desktop v0.2.45" while writing
  #     "EmuX desktop v0.2.54", so the stamp never matched and the block was
  #     appended a second time - harmless while nothing ran it, but it would
  #     now have launched TWO panels and TWO desktop icon layers.
  #  2. pcmanfm must be starved of DBUS/GIO here too, exactly as the
  #     start_furniture launch does: under proot a --desktop client that
  #     reaches for a dead session bus or gvfs parks in a blocking read before
  #     it ever paints the root window (black desktop, no icons).
  # A user's own hand-written autostart is backed up once and never clobbered
  # again; only EmuX-stamped files are rewritten.
  OBX="$HOME/.config/openbox"
  EMUX_AUTOSTART_STAMP="EmuX desktop v0.2.60"
  # Set when we just displaced a user's own autostart; the generated file then
  # chains it back (see the tail of the block below).
  EMUX_USER_BAK=""
  if emux_keep autostart; then
    # v0.2.85: the user's own autostart runs as-is (start_wm passes whatever
    # is at $OBX/autostart to `openbox --startup`). No backup, no rewrite,
    # no chaining - the marker means the file is theirs.
    echo "emux-x11: keep-autostart marker - the user's autostart runs as-is" >&2
  else
  if [ -e "$OBX/autostart" ] && ! grep -qF "$EMUX_AUTOSTART_STAMP" "$OBX/autostart" 2>/dev/null; then
    if grep -q "EmuX desktop v0.2" "$OBX/autostart" 2>/dev/null; then
      : # an older EmuX stamp: safe to rewrite in place
    else
      cp "$OBX/autostart" "$OBX/autostart.emux-bak" 2>/dev/null
      EMUX_USER_BAK=1
      echo "emux-x11: user autostart backed up to autostart.emux-bak and will be chained" >&2
    fi
  fi
  # v0.2.60: `|| [ -n "$EMUX_USER_BAK" ]` is the part that was missing. Backing
  # the user's file up without replacing it meant EmuX's own furniture never
  # started for that user either - no panel, no root colour - which reproduces
  # the exact "I can't see the desktop" report from someone who had customised
  # Openbox once. Rewrite, and chain their script from the end of ours.
  if [ ! -e "$OBX/autostart" ] || grep -q "EmuX desktop v0.2" "$OBX/autostart" 2>/dev/null \
     || [ ! -s "$OBX/autostart" ] || [ -n "$EMUX_USER_BAK" ]; then
    {
      echo "# $EMUX_AUTOSTART_STAMP"
      echo "# Run by openbox --startup (see openbox.org/help/Autostart). Every"
      echo "# command must end with & or the ones after it never run."
      echo "(command -v xsetroot >/dev/null 2>&1 && xsetroot -solid \"#20344d\") &"
      # v0.2.108: dock + tray bar, each with the pidfile start_panels checks -
      # without them the launcher would start a second dock beside this one.
      echo "if command -v tint2 >/dev/null 2>&1; then"
      echo "  tint2 >/tmp/tint2.log 2>&1 </dev/null & echo \$! > /tmp/emux_tint2.pid"
      echo "  if [ -e \"\$HOME/.config/tint2/emux-tray.tint2rc\" ]; then"
      echo "    tint2 -c \"\$HOME/.config/tint2/emux-tray.tint2rc\" >/tmp/tint2-tray.log 2>&1 </dev/null & echo \$! > /tmp/emux_tray.pid"
      echo "  fi"
      echo "  if [ -e \"\$HOME/.config/tint2/emux-rail.tint2rc\" ]; then"
      echo "    tint2 -c \"\$HOME/.config/tint2/emux-rail.tint2rc\" >/tmp/tint2-rail.log 2>&1 </dev/null & echo \$! > /tmp/emux_rail.pid"
      echo "  fi"
      echo "fi"
      echo "if [ -e /tmp/emux_want_picom ] && command -v picom >/dev/null 2>&1; then"
      echo "  (picom -b --backend xrender) >/dev/null 2>&1 &"
      echo "fi"
      echo "if command -v pcmanfm >/dev/null 2>&1; then"
      echo "  (DBUS_SESSION_BUS_ADDRESS=disabled: GIO_USE_VOLUME_MONITOR=none \\"
      echo "     pcmanfm --desktop) >/dev/null 2>&1 &"
      echo "fi"
      # v0.2.60: a user's own autostart is backed up above and then CHAINED, not
      # silently dropped. Before this, "respect the user's file" also meant
      # EmuX's furniture never started for that user - no panel, no root colour,
      # i.e. the very "I can't see the desktop" report, from someone who had
      # merely customised Openbox once. The absolute path is written at
      # generation time so the generated file needs no escaping of $HOME.
      if [ -r "$OBX/autostart.emux-bak" ]; then
        echo "# the user's own autostart, preserved and chained"
        echo "[ -r '$OBX/autostart.emux-bak' ] && /bin/sh '$OBX/autostart.emux-bak' &"
      fi
    } > "$OBX/autostart" 2>/dev/null
    chmod +x "$OBX/autostart" 2>/dev/null
  fi
  fi # keep-autostart marker guard (v0.2.85)
}
# v0.2.45: self-check the desktop, not just the X server. A streaming
# black frame used to be "proof" the pipeline worked while the desktop
# itself had zero windows. This logs, a few seconds after launch, which
# furniture processes are alive and which windows exist, so the next
# field report can say "panel up, icons missing" instead of "black".
verify_desktop() {
  sleep 6
  {
    echo "emux-x11: desktop check: openbox=$(running0 openbox && echo yes || echo no) tint2=$(running0 tint2 && echo yes || echo no) pcmanfm=$(running0 pcmanfm && echo yes || echo no) xterm=$(running0 xterm && echo yes || echo no)"
    # v0.2.61: "furniture is running" is NOT "the user can see something" -
    # pcmanfm owns the root window and happily paints it black (see the rice
    # fix in seed_desktop_config). Sample the actual pixels so the pane can
    # distinguish the two, and name the diagnostic that explains a black one.
    DSP=$(tr -dc '0-9' < /tmp/emux_display_num 2>/dev/null)
    [ -n "$DSP" ] || DSP=$DN
    for DC in "127.0.0.1:$DSP" ":$DSP"; do
      DS=$(root_samples "$DC" 2>/dev/null) || continue
      case "$DS" in *[a-z-]*) continue ;; esac
      set -- $(echo "$DS" | tr ';' '\n' | awk '
        NF==3 { t++; if ($1+$2+$3 < 24) b++ } END { printf "%d %d", b+0, t+0 }')
      DB=$1; DT=$2
      if [ "$DT" -gt 0 ] && [ "$DB" = "$DT" ]; then
        echo "emux-x11: desktop check: ROOT IS PURE BLACK at all $DT samples - run: emux-x11 doctor"
      elif [ "$DT" -gt 0 ]; then
        echo "emux-x11: desktop check: root shows colour at $((DT-DB))/$DT samples (not black)"
      fi
      break
    done
    if ! running0 tint2 && [ -e /tmp/emux_rest.log ]; then
      echo "emux-x11: desktop check: REST log tail (furniture missing):"
      tail -6 /tmp/emux_rest.log 2>/dev/null
    fi
    if command -v wmctrl >/dev/null 2>&1; then
      echo "emux-x11: desktop check windows (wmctrl):"
      wmctrl -l 2>&1 || echo "emux-x11: desktop check: wmctrl failed"
    elif command -v xwininfo >/dev/null 2>&1; then
      echo "emux-x11: desktop check windows (xwininfo -root -tree):"
      xwininfo -root -tree 2>&1 | grep -E "0x[0-9a-f]+ " | head -30 || echo "emux-x11: desktop check: xwininfo failed"
    elif command -v xlsclients >/dev/null 2>&1; then
      echo "emux-x11: desktop check clients (xlsclients):"
      xlsclients 2>&1 || echo "emux-x11: desktop check: xlsclients failed"
    else
      echo "emux-x11: desktop check: no wmctrl/xwininfo/xlsclients - install x11-utils + wmctrl for window lists"
    fi
  } > /tmp/emux_desktop_check 2>&1
  cat /tmp/emux_desktop_check >&2
}

# v0.2.61: `emux-x11 doctor` - a read-only, one-screen field diagnostic.
#
# WHY THIS EXISTS: "the desktop is black" is the SAME PIXELS for at least six
# different failures - X never came up, the WM died, the autostart never ran,
# pcmanfm painted its own black root pixmap, capture died, or frames never
# reached the host. Three rounds of this project were spent telling those apart
# over adb. Every one of them leaves a distinct trace in /tmp or on the wire, so
# print all of those traces at once and let the field report BE the data.
#
# It changes nothing: no kills, no restarts, no config writes, one extra root
# grab. Safe against a live session. Narrow-terminal friendly (~68 cols).

# Sample the root window at five points. Binary PPM (P6) from xwdtopnm has the
# fixed header "P6\n<w> <h>\n255\n", so a pixel is a byte offset - no netpbm
# plain conversion (its ASCII output WRAPS at 8 pixels per line, so rows are not
# lines) and no float arithmetic (neither exists in a minimal guest).
# Echoes "R G B;R G B;..." or a one-word reason on failure.
root_samples() {
  command -v xwd >/dev/null 2>&1 || { echo "no-xwd"; return 1; }
  command -v xwdtopnm >/dev/null 2>&1 || { echo "no-xwdtopnm"; return 1; }
  command -v xwininfo >/dev/null 2>&1 || { echo "no-xwininfo"; return 1; }
  DW=$(DISPLAY="$1" xwininfo -root 2>/dev/null | sed -n 's/^  Width: //p')
  DH=$(DISPLAY="$1" xwininfo -root 2>/dev/null | sed -n 's/^  Height: //p')
  [ -n "$DW" ] && [ -n "$DH" ] || { echo "no-geometry"; return 1; }
  DF=/tmp/emux_doctor_root.ppm
  DISPLAY="$1" xwd -root -silent 2>/dev/null | xwdtopnm > "$DF" 2>/dev/null || {
    rm -f "$DF"; echo "grab-failed"; return 1; }
  DSZ=$(wc -c < "$DF" 2>/dev/null || echo 0)
  DHDR=$(( 3 + ${#DW} + 1 + ${#DH} + 1 + 3 + 1 ))
  if [ "$DSZ" -lt $(( DHDR + 3 * DW * DH )) ]; then
    rm -f "$DF"; echo "short-grab($DSZ)"; return 1
  fi
  DOUT=""
  for DPT in "$((DW/4)) $((DH/4))" "$((DW/2)) $((DH/4))" "$((DW/2)) $((DH/2))" \
             "$((DW/4)) $((3*DH/4))" "$((3*DW/4)) $((3*DH/4))"; do
    set -- $DPT
    DOFF=$(( DHDR + 3 * ($2 * DW + $1) ))
    DRGB=$(tail -c +$((DOFF+1)) "$DF" | head -c 3 | od -A n -t u1 | tr -s ' ' ' ' | sed 's/^ //')
    DOUT="$DOUT$DRGB;"
  done
  rm -f "$DF"
  echo "$DOUT"
}

doctor() {
  # --- which display? Prefer the one the session recorded, then probe. ---
  DDN=$(tr -dc '0-9' < /tmp/emux_display_num 2>/dev/null)
  [ -n "$DDN" ] || DDN=$DN
  DDSP=""
  if command -v xwininfo >/dev/null 2>&1; then
    for DCAND in "127.0.0.1:$DDN" ":$DDN"; do
      DISPLAY="$DCAND" xwininfo -root >/dev/null 2>&1 && { DDSP="$DCAND"; break; }
    done
  fi

  hdr() { printf '\n== %s ==\n' "$1"; }
  kv()  { printf '  %-13s %s\n' "$1:" "$2"; }
  # pid of a LIVE (non-zombie) process whose EXECUTABLE is $1. Two traps here,
  # both previously bitten elsewhere in this project:
  #  - grepping the whole cmdline matches any process that merely mentions the
  #    name in an argument. The shell running `emux-x11 doctor` has the report
  #    text in its own argv, so it matched Xvfb, openbox, tint2 AND pcmanfm at
  #    once. Only argv[0] (and argv[1], for `/bin/sh /path/emux-capture`) is
  #    compared, by basename.
  #  - pgrep -x and kill -0 both report ZOMBIES as alive, and this container's
  #    PID 1 does not reap, so a furniture process killed earlier still looks
  #    "RUNNING". The /proc state field is read and Z is skipped.
  livepid() {
    DT=$1
    for f in /proc/[0-9]*/cmdline; do
      p=${f#/proc/}; p=${p%/cmdline}
      [ "$p" = "$$" ] && continue
      pst=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f1)
      [ -n "$pst" ] && [ "$pst" != Z ] || continue
      tr '\0' '\n' < "$f" 2>/dev/null | head -2 | while read -r a; do
        case "$a" in */*) a=${a##*/} ;; esac
        [ "$a" = "$DT" ] && echo match
      done | grep -q match || continue
      echo "$p"; return 0
    done
    return 1
  }
  pst() { p=$(livepid "$1"); if [ -n "$p" ]; then echo "RUNNING (pid $p)"; else echo "not running"; fi; }
  age() {
    [ -e "$1" ] || { echo "-"; return; }
    echo "$(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) ))s ago"
  }
  mk() { [ -e "$1" ] && echo "yes ($(age "$1"))" || echo "NO"; }
  hexs() {  # "R G B;R G B;..." -> "#rrggbb #rrggbb ..."
    echo "$1" | tr ';' '\n' | while read -r r g b; do
      [ -n "$r" ] || continue
      printf '#%02x%02x%02x ' "$r" "$g" "$b"
    done
  }
  PROBLEMS=""
  bad() { PROBLEMS="$PROBLEMS
  - $1"; }

  printf 'emux-x11 doctor (read-only; nothing was changed)\n'
  kv "script" "$(command -v emux-x11 2>/dev/null || echo "$0")"
  kv "autostart" "$(sed -n '1p' "$HOME/.config/openbox/autostart" 2>/dev/null || echo 'none seeded')"
  kv "pcmanfm rice" "$(sed -n '1p' "$HOME/.config/pcmanfm/default/pcmanfm.conf" 2>/dev/null || echo 'none seeded')"

  hdr "X server"
  if [ -n "$DDSP" ]; then
    kv "display" "$DDSP  (answering)"
    kv "geometry" "$(DISPLAY="$DDSP" xwininfo -root 2>/dev/null | sed -n 's/^  Width: /W=/p;s/^  Height: / H=/p;s/^  Depth: / D=/p' | tr -d '\n')"
    kv "Xvfb" "$(pst Xvfb)"
    kv "x_up marker" "$(mk /tmp/emux_x_up)"
    kv "attempts" "$(cat /tmp/emux_attempts 2>/dev/null || echo '-')"
    kv "lock/socket" "$(ls /tmp/.X$DDN-lock /tmp/.X11-unix/X$DDN 2>/dev/null | tr '\n' ' ' || echo 'none')"
  else
    kv "display" ":$DDN - NOTHING ANSWERS (probed 127.0.0.1:$DDN and :$DDN)"
    kv "Xvfb" "$(pst Xvfb)"
    kv "xvfb.log" "$(tail -2 /tmp/xvfb.log 2>/dev/null | tr '\n' '|' || echo '-')"
    bad "X server is not answering on :$DDN - the pane cannot show anything."
  fi

  hdr "desktop"
  kv "openbox" "$(pst openbox)"
  kv "tint2 panel" "$(pst tint2)"
  kv "pcmanfm" "$(pst pcmanfm)"
  kv "xterm" "$(pst xterm)"
  kv "WM launched" "$(mk /tmp/emux_wm_launched)"
  kv "root painted" "$(mk /tmp/emux_root_painted)"
  kv "pcmanfm wedges" "$(cat /tmp/emux_pcmanfm_wedges 2>/dev/null || echo 0)"
  if [ -n "$DDSP" ]; then
    DSAMP=$(root_samples "$DDSP")
    case "$DSAMP" in
      *[a-z-]*) kv "root colour" "$DSAMP (sampler could not read the root)" ;;
      *)
        kv "root colour" "$(hexs "$DSAMP")"
        # One awk pass: the samples are "R G B;R G B;...", and a `for` loop
        # over that splits on every space, so each iteration would see a single
        # number and $2/$3 would be empty (dash: "arithmetic expression:
        # expecting primary").
        set -- $(echo "$DSAMP" | tr ';' '\n' | awk '
          NF==3 { t++; if ($1+$2+$3 < 24) b++ } END { printf "%d %d", b+0, t+0 }')
        DBLACK=$1; DTOT=$2
        if [ "$DBLACK" = "$DTOT" ]; then
          kv "verdict" "PURE BLACK at all $DTOT sample points"
          bad "the root window is pure black. See 'pcmanfm config' below - if
    desktop-items-0.conf still says desktop_bg=#000000, the seeded
    v0.2.60 rice has not run yet (re-seed: bump ENV_VERSION / tap Install)."
        else
          kv "verdict" "not black ($((DTOT-DBLACK))/$DTOT points show colour) - OK"
        fi
        ;;
    esac
  fi

  hdr "pcmanfm config"
  DWALL=/usr/share/emux/wall.png
  kv "wallpaper" "$([ -e "$DWALL" ] && echo "present ($DWALL)" || echo "MISSING ($DWALL)")"
  for DF in "$HOME/.config/pcmanfm/default/pcmanfm.conf" \
            "$HOME/.config/pcmanfm/default/desktop-items-0.conf"; do
    DN2=$(basename "$DF")
    if [ -e "$DF" ]; then
      kv "$DN2" "$(grep -E '^(wallpaper_mode|wallpaper|desktop_bg)=' "$DF" 2>/dev/null | tr '\n' ' ')"
      case "$DN2" in
        desktop-items-0.conf)
          if grep -q '^desktop_bg=#000000' "$DF" 2>/dev/null && \
             ! grep -q '^wallpaper=/.' "$DF" 2>/dev/null; then
            bad "desktop-items-0.conf is still pcmanfm's untouched default
    (desktop_bg=#000000). It OVERRIDES pcmanfm.conf, so the desktop is
    black no matter what the rice says. v0.2.60 repairs it at seed time."
          fi ;;
        pcmanfm.conf)
          if grep -q '^wallpaper_mode=[0-9]' "$DF" 2>/dev/null; then
            bad "wallpaper_mode is numeric. pcmanfm parses STRINGS
    (none|color|stretch|fit|center|tile|crop); a number means the
    wallpaper is ignored and only desktop_bg is painted."
          fi ;;
      esac
    else
      kv "$DN2" "absent"
    fi
  done

  hdr "input"
  kv "xdotool" "$(command -v xdotool 2>/dev/null || echo 'NOT INSTALLED')"
  if command -v xdpyinfo >/dev/null 2>&1 && [ -n "$DDSP" ]; then
    kv "XTEST ext" "$(DISPLAY="$DDSP" xdpyinfo -ext XTEST 2>/dev/null | grep -ci xtest | { read n; [ "${n:-0}" -gt 0 ] && echo present || echo MISSING; })"
  fi
  kv "FIFO" "$([ -p /tmp/emux_in ] && echo '/tmp/emux_in (fifo)' || { [ -e /tmp/emux_in ] && echo '/tmp/emux_in (NOT a fifo)' || echo 'absent'; })"
  kv "agent" "launched=$(mk /tmp/emux_agent_launched) noxdotool=$(mk /tmp/emux_agent_noxtool)"
  kv "agent input" "last activity $(age /tmp/emux_agent_firstclick)"
  if ! command -v xdotool >/dev/null 2>&1; then
    bad "xdotool is missing, so the FIFO fallback cannot inject. Input needs
    the XTEST control plane (host side) to work."
  fi

  # v0.2.78: "input can be injected" is NOT "a click reaches an application".
  # Motion-only proof is what let the click-swallow survive ~25 releases, so the
  # button leg gets its own section: which WM, which rc.xml Openbox really read,
  # whether that file binds a context Openbox turns into an XGrabButton, and
  # what the app's own button probe concluded.
  hdr "clicks (button delivery)"
  kv "WM mode" "$(cat /tmp/emux_wm_mode 2>/dev/null || echo '?')  $(pst openbox)"
  kv "WM fallback" "$([ -e /tmp/emux_wm_fellback ] && echo "APPLIED this session" || echo 'not needed')"
  RCX_EFF_D=$(rc_xml_effective)
  kv "rc.xml read" "${RCX_EFF_D:-NONE FOUND}"
  if [ -n "$RCX_EFF_D" ]; then
    if grep -qF "$EMUX_RCXML_STAMP" "$RCX_EFF_D" 2>/dev/null; then
      kv "rc.xml stamp" "$EMUX_RCXML_STAMP (current)"
    elif grep -q "<name>Emux</name>" "$RCX_EFF_D" 2>/dev/null; then
      # The common broken state in the field: our OWN file from v0.2.51..77,
      # which carries no stamp at all. Printing its first bytes tells nobody
      # anything; naming it says both what it is and what happens next.
      kv "rc.xml stamp" "an OLDER EmuX rc.xml (v0.2.51..77, unstamped) - binds Frame, so clicks die; rewritten on the next launch"
    else
      kv "rc.xml stamp" "NOT EmuX's - $(head -c 60 "$RCX_EFF_D" 2>/dev/null | tr '\n' ' ')"
    fi
    RCX_BAD_D=$(rc_xml_grab_contexts "$RCX_EFF_D")
    kv "grab contexts" "${RCX_BAD_D:-none}"
    if [ -n "$RCX_BAD_D" ]; then
      bad "$RCX_EFF_D binds $RCX_BAD_D. Openbox turns a mousebind in those
    contexts into XGrabButton() (mouse.c mouse_grab_for_client: Frame -> the
    FRAME window, Client/Desktop -> the client window with GrabModeSync), and
    xorg checks passive grabs on EVERY window from the root down to the one
    under the pointer (dix/events.c CheckDeviceGrabs). With owner_events=False
    the application never sees the ButtonPress - while motion and keys are
    untouched, which is the 'visible but not clickable' report. The next
    launcher run rewrites this file (stamp $EMUX_RCXML_STAMP)."
    fi
  fi
  kv "app verdict" "$([ -s /tmp/emux_btn_verdict ] && cat /tmp/emux_btn_verdict 2>/dev/null || echo 'none published')"
  kv "ladder action" "$(cat /tmp/emux_btn_action 2>/dev/null || echo '-')"
  kv "ladder stages" "$(cat /tmp/emux_btn_stages 2>/dev/null || echo 0)"

  hdr "capture / frames"
  kv "emux-capture" "$(pst emux-capture)"
  kv "converter" "$([ -x /usr/local/lib/emux/emux-rgb565 ] && echo native || echo 'fallback chain (native missing)')"
  kv "last frame" "$([ -e /tmp/emux_frame.rgb ] && echo "$(wc -c < /tmp/emux_frame.rgb) bytes, $(age /tmp/emux_frame.rgb)" || echo 'none written')"
  kv "cap.err tail" "$(tail -2 /tmp/emux_cap.err 2>/dev/null | tr '\n' '|' || echo '-')"
  if [ -n "$DDSP" ] && [ -e /tmp/emux_frame.rgb ]; then
    DAGE=$(( $(date +%s) - $(stat -c %Y /tmp/emux_frame.rgb 2>/dev/null || echo 0) ))
    [ "$DAGE" -gt 30 ] && bad "no frame has been produced for ${DAGE}s even though X is up -
    the host pane will look frozen/black while the desktop itself is fine."
  fi

  hdr "logs"
  for DL in /tmp/xvfb.log /tmp/wm.log /tmp/pcmanfm.log /tmp/tint2.log; do
    [ -s "$DL" ] || continue
    printf '  -- %s (last 3)\n' "$DL"
    tail -3 "$DL" 2>/dev/null | sed 's/^/     /'
  done

  hdr "verdict"
  if [ -z "$PROBLEMS" ]; then
    printf '  OK: X answering, root is not black, furniture and input present.\n'
  else
    printf '  %d problem(s) found:%s\n' "$(echo "$PROBLEMS" | grep -c '^  - ')" "$PROBLEMS"
  fi
  printf '\n  Full detail: /tmp/emux_desktop_check, /tmp/emux_probes, /tmp/emux_cap.err\n'
}

# Dispatch BEFORE any side effect below (kill_stale_x, Xvfb launch, traps), so
# `emux-x11 doctor` can never disturb a live session. Also reachable from the
# host side: the proot re-exec above forwards $1 verbatim.
if [ -n "$DOCTOR_MODE" ]; then doctor; exit 0; fi
# v0.2.36 FIELD FIX (the thirty-five-round bug): emux-x11 EXITS by design
# once X+WM are launched - and when its PTY session closes, the kernel
# SIGHUPs the entire process group: the WM, every visibility client and
# the REST install subshell all died at launcher exit (wm.log with one
# openbox line then silence; xterm never installed; windowless black
# desktop beside a perfect stream). Ignored signals are INHERITED across
# fork+exec, so one trap here makes every child we launch SIGHUP-proof.
trap '' HUP
# v0.1.52 FIELD FIX: a leftover Xvfb/Xorg from an earlier desktop session
# still holds :0 and tcp/6000 — a fresh Xvfb then dies with EADDRINUSE and
# the Android pane waits for frames forever. Kill stale servers (proc scan:
# pkill/procps are not guaranteed in minimal images) and drop stale sockets.
# v0.1.54: also kill orphaned capture helpers (emux-capture / xwd) - they
# survive session stops and app deaths (proot tracees are detached, not
# killed) and keep tcp/7001 + X connections open, which made the NEXT desktop
# start die with "bind failed: EADDRINUSE" on the Android side.
# v0.1.80: factored into kill_stale_x() so EVERY launch attempt (first,
# retry, death-restart) re-sweeps and drops stale sockets - the v0.1.79
# field pane died with "Cannot establish any listening sockets" on a retry
# that only removed the lock file, not the stale X0 socket.
kill_stale_x() {
  # v0.2.13 FIELD FIX: FILES ONLY - no process killing from the guest
  # sweep, ever again. Thirteen rounds of evidence: on this ROM it cannot
  # reach foreign proot tracees (so it never cleaned anything useful),
  # and whenever it COULD reach something it murdered our own live
  # capture (v0.1.54-v0.2.7, rc=137) or, via the explicit previous-attempt
  # kill, our own SERVING X server mid-session (v0.2.12 field: preflight
  # ok on :0, then every grab "unable to open display" after attempt 3
  # killed attempt 2's live server). Host-side age-filtered kill at
  # session start covers healthy ROMs; adoption covers the rest.
  sleep 0.3
  mkdir -p /tmp/.X11-unix
  rm -f /tmp/.X$DN-lock /tmp/.X11-unix/X$DN 2>/dev/null
}
kill_stale_x
rm -f /tmp/emux_wm_launched /tmp/emux_xvfb_restarted /tmp/emux_x_up 2>/dev/null

# v0.1.82: SOCKET PROBES. X's "Cannot establish any listening sockets /
# server already running" is a GENERIC message that hides the real errno -
# it fires for a live orphan holder AND for bind() failures (proot socket
# translation, SELinux). These lines let the next field round tell them
# apart without guessing: directory state, kernel tcp tables (6000 =
# 0x1770), and live bind probes (124 = bind OK and blocked in listen).
probe_sockets() {
  : > /tmp/emux_probes 2>/dev/null
  pl() { echo "emux-x11: $1" >&2; echo "$1" >> /tmp/emux_probes 2>/dev/null; }
  pl "probe .X11-unix: $(ls -la /tmp/.X11-unix 2>&1 | tr '\n' ' ')"
  pl "probe tcp6000: $(grep -hi ':1770 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null | tr -s ' ' | cut -d' ' -f2,4,10 | tr '\n' ' ')"
  if command -v nc >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    # v0.2.28: the old probe ran `nc -l` whose stdin was the session's
    # (closed) stdin - openbsd nc then exits 0 IMMEDIATELY, and the
    # "(124=ok, other=failed)" semantics read that as "port held" for
    # ten versions. A CONNECT test is what we actually care about:
    # rc=0 = something really listens; rc!=0 = free.
    nc -z 127.0.0.1 "$XP" >/dev/null 2>&1
    pl "probe tcp-connect-$XP rc=$? (0=HELD, other=free)"
    timeout 1 nc -l 6001 >/dev/null 2>&1
    pl "probe tcp-bind-6001 rc=$? (124=ok, other=failed)"
    timeout 1 nc -l -U /tmp/.X11-unix/Xprobe >/dev/null 2>&1
    pl "probe unix-bind rc=$? (124=ok, other=failed)"
    rm -f /tmp/.X11-unix/Xprobe 2>/dev/null
  fi
  # v0.1.86: mirror into the pane-visible selfcheck file (chunked notes)
  cat /tmp/emux_probes >> /tmp/emux_selfcheck 2>/dev/null
}
# v0.1.99 PERF: probes are diagnostics, not gates - run them in the
# background so the launch path never pays their ~3 s; the clash branch
# still calls probe_sockets synchronously when it needs fresh numbers.
( probe_sockets ) >/dev/null 2>&1 &

# v0.1.78: xkbcomp preflight. The X server execs /usr/bin/xkbcomp BY ABSOLUTE
# PATH through /bin/sh while compiling its keymap; a ghost x11-xkb-utils (db
# installed, binary gone) makes Xvfb die with "Failed to activate virtual core
# keyboard" before any client connects - xvfb.log then names it, but the
# session is already dead. One [ -x ] test on a healthy system; a cheap cached
# install when the ghost struck.
if [ ! -x /usr/bin/xkbcomp ] && command -v apt-get >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    x11-xkb-utils >&2 || true
fi

# v0.1.79: id-independent guard - a session starting mid-transaction can hit
# a half-swapped coreutils ("id: not found" pane noise); fake-root is the
# normal case here, so default to 0 when id is momentarily unavailable.
if [ "$(id -u 2>/dev/null || echo 0)" = "0" ] && [ -x /usr/bin/Xorg ] && [ -n "$EMUX_USE_XORG" ]; then
  Xorg :"$DN" -config /etc/X11/emux-xorg.conf &
else
  XVFB=""
  for c in /usr/bin/Xvfb /usr/bin/Xephyr; do
    [ -x "$c" ] && { XVFB="$c"; break; }
  done
  if [ -z "$XVFB" ]; then
    # v0.1.47 multi-distro: install through whichever package manager the
    # active distro ships (apk on Alpine, apt on Debian/Ubuntu).
    echo "emux-x11: Xvfb missing - installing via the distro package manager (one time, needs network)" >&2
    if command -v apt-get >/dev/null 2>&1; then
      # v0.1.53 FIELD FIX: the bare `dpkg --configure -a || true` here could
      # never succeed on devices where proot's link(2) translation breaks
      # dpkg's status-old backup (EACCES/EEXIST, termux/proot#377) or where a
      # killed apt run left the journal dirty - so the install below died and
      # the desktop pane showed "X server exited (code 1)" with apt Hit: lines.
      # emux-apt-repair installs the link()->linkat() preload shim, cleans the
      # stale backup, quarantines an unrecoverable journal and fixes
      # half-installed packages first.
      if [ -x /usr/local/bin/emux-apt-repair ]; then
        emux-apt-repair >&2 || true
      else
        dpkg --configure -a >&2 || true
      fi
      # v0.1.94 PERF: skip apt-get update when list files are fresh (<6 h) -
      # on slow links this alone cost 30-60 s of desktop open time.
      if [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -mmin -360 2>/dev/null | head -1)" ]; then
        apt-get update >&2
      fi
      # v0.1.54 FIELD FIX ("X server exited code 1" on FIRST desktop open right
      # after an update): the app-start repair pass may still hold the dpkg
      # lock when the desktop cascade runs - apt then fails with "Could not
      # get lock" and Xvfb never gets installed. Retry a few times instead of
      # giving up on the first lock race.
      # v0.1.58 FIELD FIX (pane: "E: dpkg was interrupted ... apt install
      # failed (lock or mirror?) - retry"): apt reports "dpkg was interrupted"
      # whenever /var/lib/dpkg/updates/ is non-empty - which is ALSO true while
      # ANOTHER dpkg transaction is legitimately running (the app-start gap
      # install of the desktop stack takes minutes on slow links). The old
      # 4x5s retry loop raced that multi-minute install and always lost, then
      # gave up with Xvfb absent. Now: wait while a foreign apt/dpkg runs, and
      # heal the journal between retries when nothing is running.
      apt_busy() {
        for f in /proc/[0-9]*/cmdline; do
          c=$(tr "\0" " " < "$f" 2>/dev/null)
          case "$c" in *dpkg*|*apt-get*) return 0 ;; esac
        done
        return 1
      }
      heal_dpkg() {
        rm -f /var/lib/dpkg/status-old /etc/passwd.lock /etc/shadow.lock /etc/group.lock /etc/gshadow.lock 2>/dev/null
        if ! dpkg --configure -a >&2; then
          mkdir -p /var/lib/dpkg/updates.emux-broken 2>/dev/null
          for f in /var/lib/dpkg/updates/*; do
            [ -e "$f" ] && mv "$f" /var/lib/dpkg/updates.emux-broken/ 2>/dev/null
          done
          rm -f /var/lib/dpkg/updates/* 2>/dev/null
          dpkg --configure -a >&2 || true
        fi
        # v0.1.78: purge ghost db entries between retries too - a retry loop
        # against a ghost (db installed, files gone) spins all 30 tries.
        ghost_purge
      }
      # v0.1.78: GHOST-PACKAGE PURGE. An interrupted transaction (or a killed
      # extraction) can leave a package "install ok installed" in the dpkg db
      # while its files are GONE. apt-get install then NO-OPs on it ("already
      # the newest version") and the cascade spins its retries against a
      # binary that can never appear - the v0.1.76/77 field pane showed exactly
      # that: the whole xvfb transaction aborted on the coreutils upgrade, so
      # /usr/bin/Xvfb never landed and the pane waited for frames forever.
      # Purging the db entry makes the next install really unpack the files.
      # KEEP IN SYNC with assets/bin/emux-apt-repair and
      # BootstrapManager.GHOST_PURGE_PAYLOAD (inlined twin).
      ghost_purge() {
        for pair in \
          "coreutils:/usr/bin/id" \
          "util-linux:/usr/bin/script" \
          "bash:/bin/bash" \
          "xvfb:/usr/bin/Xvfb" \
          "xserver-common:/etc/X11/Xsession" \
          "x11-xkb-utils:/usr/bin/xkbcomp" \
          "xfonts-base:/usr/share/fonts/X11/misc" \
          "x11-apps:/usr/bin/xwd" \
          "netpbm:/usr/bin/pnmtoplainpnm" \
          "netcat-openbsd:/bin/nc.openbsd" \
          "openbox:/usr/bin/openbox" \
          "xterm:/usr/bin/xterm" ; do
          gp=${pair%%:*}; gm=${pair#*:}
          if [ ! -e "$gm" ] && dpkg -s "$gp" 2>/dev/null | grep -q "install ok installed"; then
            echo "emux-x11: ghost package $gp (db says installed, $gm missing) - purging db entry" >&2
            dpkg --remove --force-all "$gp" >&2 || true
          fi
        done
      }
      if ! apt_busy && [ -x /usr/local/bin/emux-apt-repair ]; then
        emux-apt-repair >&2 || true
      fi
      ghost_purge
      # v0.1.62: SPLIT the cascade. CORE is what the X server itself needs;
      # everything else (WM + capture toolchain: xwd from x11-apps,
      # pnmtoplainpnm from netpbm, nc from netcat-openbsd) installs in the
      # BACKGROUND once X is up. Before, one multi-minute transaction gated
      # Xvfb startup: the pane sat in dpkg/apt output for minutes and the
      # control-plane wait expired ("touch input: X TCP not up yet").
      # v0.1.60 CRITICAL: "xkbcomp" is NOT a Debian/Ubuntu package name
      # (x11-xkb-utils is) - apt aborts the WHOLE transaction on one bad name.
      # v0.1.98 (field audit): the capture toolchain (xwd/xwdtopnm from
      # x11-apps, pnmtoplainpnm from netpbm, nc) moved INTO the synchronous
      # CORE install - installing it in the background after X started raced
      # the capture helper on slow devices (the "desktop running but
      # invisible" rounds). Only the WM half stays backgrounded now.
      CORE="coreutils xvfb x11-xkb-utils xkb-data xfonts-base x11-apps netpbm netcat-openbsd"
      # v0.2.37: desktop furniture, not just a terminal: menu (fixes the
    # empty openbox right-click menu), tint2 (taskbar+clock), pcmanfm
    # (desktop icons + graphical file manager), mousepad (GUI editor).
    # Best-effort REST pass as before; the visibility chain does not
    # depend on any of these.
    # v0.2.45: + galculator (a clickable Calculator app - a desktop
    # without one is not a visual interface), wmctrl + x11-utils (the
    # window list verify_desktop reports, so "black screen" can be
    # diagnosed from the log instead of a screenshot).
    REST="x11-xserver-utils openbox xterm menu tint2 pcmanfm mousepad galculator wmctrl x11-utils xdotool"
      # v0.2.42 FIELD FIX: NO apt transaction unless something is actually
      # missing. Every desktop open used to run the CORE install (and the
      # REST pass) even on a complete rootfs; while dpkg swaps libraries,
      # every NEW guest exec (shell, xterm, xeyes) can SIGSEGV - the field
      # signal-11 wave that killed terminals and clients ("terminal works
      # when I don't open the desktop tab"). A complete rootfs now opens
      # with zero transaction window.
      NEEDCORE=0
      for b in /usr/bin/Xvfb /usr/bin/xkbcomp /usr/bin/xwd /usr/bin/xwdtopnm \
               /usr/bin/pnmtoplainpnm /bin/nc /usr/bin/nc /usr/bin/openbox /usr/bin/id; do
        [ -x "$b" ] || NEEDCORE=1
      done
      if [ "$NEEDCORE" = 1 ]; then
      TRIES=0
      while [ "$TRIES" -lt 30 ]; do
        if apt_busy; then
          TRIES=$((TRIES + 1))
          echo "emux-x11: another apt/dpkg transaction is running - waiting ($TRIES/30)" >&2
          sleep 10
          continue
        fi
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
          $CORE >&2 && break
        TRIES=$((TRIES + 1))
        echo "emux-x11: apt install failed - healing dpkg and retrying ($TRIES/30)" >&2
        heal_dpkg
        sleep 2
      done
      # v0.1.61: settle pass (first-pass postinst failures under proot's statx
      # translation leave packages unpacked-but-unconfigured; a configure
      # retry completes them - sandbox-verified on the pinned noble image).
      i=0
      while [ "$i" -lt 2 ]; do
        dpkg --configure -a >&2 && break
        i=$((i + 1))
      done
      else
        echo "emux-x11: core stack complete - skipping CORE apt transaction" >&2
      fi
      # v0.1.78 LAST RESORT: if the X server binary STILL is not on disk after
      # the retry loop (ghost db entry that survived healing, stale mirror
      # cache, ...), force the db entry out and reinstall exactly what the
      # server needs. Before this, a ghost xvfb meant "apt-get install xvfb"
      # no-opped forever and the session died with "no X server available".
      if [ ! -x /usr/bin/Xvfb ] && [ ! -x /usr/bin/Xephyr ]; then
        echo "emux-x11: X server still absent after retries - forced reinstall" >&2
        ghost_purge
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
          xvfb x11-xkb-utils xserver-common xfonts-base >&2 || true
        if [ ! -x /usr/bin/Xvfb ]; then
          DEBIAN_FRONTEND=noninteractive apt-get install -y --reinstall \
            --no-install-recommends xvfb x11-xkb-utils xserver-common xfonts-base >&2 || true
        fi
        i=0
        while [ "$i" -lt 2 ]; do
          dpkg --configure -a >&2 && break
          i=$((i + 1))
        done
      fi
      # v0.1.79: the REST install (WM + capture toolchain) NO LONGER starts
      # here - it moved to after the X server is up. A background dpkg
      # transaction swapping libc-bin/fonts/coreutils under a STARTING Xvfb
      # is exactly what killed the v0.1.78 field round (first launch landed
      # on a half-configured libc-bin: no ld.so.cache, Xvfb could not exec,
      # the 15 s window expired, and the retry died on -noshmem).
      APT_BRANCH=1
    elif command -v pacman >/dev/null 2>&1; then
      # v0.2.45: previously this branch installed NO desktop furniture at
      # all (no tint2/pcmanfm/mousepad) - on Arch the desktop could never
      # be more than Xvfb + a terminal, if that.
      pacman -Sy --noconfirm --needed xorg-server-xvfb xorg-xkbcomp xkeyboard-config xorg-xwd netpbm openbox xterm tint2 pcmanfm mousepad galculator wmctrl xdotool >&2
    elif command -v dnf >/dev/null 2>&1; then
      dnf -y --skip-broken install xorg-x11-server-Xvfb xkbcomp xkeyboard-config xorg-x11-apps netpbm nmap-ncat openbox xterm tint2 pcmanfm mousepad galculator wmctrl xdotool >&2
    else
      # v0.2.45: previously Alpine got Xvfb + xwd only - no WM, no panel,
      # no file manager, no terminal: a black screen by construction.
      # Alpine is also the app's DEFAULT_DISTRO, so this branch is the
      # likeliest explanation for "other versions only show a black screen".
      # v0.2.66 FIX (input-dead audit): `wmctrl` DOES NOT EXIST on Alpine, and
      # `apk add` aborts the WHOLE transaction on one unknown name - so on the
      # app's DEFAULT distro this line silently installed NOTHING: no openbox,
      # no tint2, no pcmanfm, no xterm, and no xdotool (which the input fallback
      # needs and which DOES exist on Alpine but was never listed). Verified on
      # a real alpine-minirootfs-3.20.3: "ERROR: unable to select packages:
      # wmctrl (no such package)". Retry package-by-package so one bad name can
      # never take the whole desktop down with it again.
      APKLIST="xvfb xkbcomp xkeyboard-config xwd netpbm openbox xterm tint2 pcmanfm mousepad galculator xdotool"
      if ! apk add --no-cache $APKLIST >&2; then
        echo "emux-x11: apk add aborted on an unknown name - installing one-by-one" >&2
        for p in $APKLIST; do
          apk add --no-cache "$p" >&2 || echo "emux-x11: apk: '$p' unavailable on this Alpine" >&2
        done
      fi
    fi
    [ -x /usr/bin/Xvfb ] && XVFB=/usr/bin/Xvfb
  fi
  if [ -z "$XVFB" ]; then
    echo "emux-x11: no X server available (apk add xvfb failed? see above)" >&2
    exit 1
  fi
  # -listen tcp : the Android-side X11Client talks X over loopback TCP :6000
  # -ac         : disable access control (loopback-only server)
  # v0.1.79 SETTLE WAIT: never start Xvfb into a running dpkg/apt transaction.
  # The v0.1.78 field pane proved the first launch landed mid-transaction
  # (dpkg.log: libc-bin half-configured = ld.so.cache gone; /etc/profile even
  # lost `id`): Xvfb could not exec, the old blind 15 s window expired, and
  # the retry then died on a flag noble's Xvfb no longer knows.
  # v0.1.94 PERF: cap the settle at 45 s (was 120). v0.1.99 PERF: with a
  # valid ld.so.cache the original reason for settling (execs failing mid
  # libc-bin swap) is gone, so the cap drops to 10 s; without cache keep 45.
  SETTLE_CAP=9
  [ -s /etc/ld.so.cache ] && SETTLE_CAP=2
  i=0
  while [ "$i" -lt "$SETTLE_CAP" ] && command -v apt_busy >/dev/null 2>&1 && apt_busy; do
    echo "emux-x11: dpkg/apt still running before X start - settling ($i/$SETTLE_CAP)" >&2
    [ "$i" = 0 ] && echo "emux-x11: note: waiting on background package transaction" >&2
    sleep 5; i=$((i + 1))
  done
  # v0.1.79: -noshmem was REMOVED from Xvfb (xorg-server 21.1, Ubuntu noble):
  # passing it = instant "Fatal server error: Unrecognized option". Probe the
  # flag once; on noble NOSHEM stays empty and shm failures are handled by
  # the server's own fallback (which is why upstream dropped the flag).
  NOSHEM=""
  if "$XVFB" -noshmem -version >/dev/null 2>&1; then NOSHEM="-noshmem"; fi
  # v0.1.84: TCP-ONLY FIRST ATTEMPT. The v0.1.83 pinned probe settled it:
  # hostbind tcp6000=true abs=true while the guest Xvfb dies with the generic
  # "server already running" fatal => the failure is GUEST-INTERNAL (proot
  # unix-socket translation / SELinux on the path+abstract binds), not an
  # orphan holder. -nolisten unix drops the unix transport entirely; every
  # client we run works over tcp (X11Client talks tcp:6000 by design; xwd /
  # xterm / openbox use Xlib, which falls back to tcp for DISPLAY=:0 when
  # the unix socket is unavailable).
  tcp_open() {
    if command -v nc >/dev/null 2>&1; then nc -z 127.0.0.1 "$XP" 2>/dev/null; return $?; fi
    if [ -x /bin/bash ]; then /bin/bash -c "exec 3<>/dev/tcp/127.0.0.1/$XP" 2>/dev/null; return $?; fi
    return 1
  }
  # v0.2.28 FIELD FIX: a stale X0 socket FILE is not a server. SIGKILLed
  # Xvfbs never unlink it, and the v0.2.16/2.18 gates (x_up leg 1) trusted
  # mere existence - field v0.2.27: "leg=X0-file present" with "xwd
  # handshake rc=1" twice, i.e. the file outlived its server and every
  # gate after it lied. Require the socket to be NEWER than this session's
  # start marker; files from previous lives are ignored. tcp leg unchanged
  # (connect-based, honest).
  x_up() {
    if [ -e /tmp/.X11-unix/X$DN ] && [ /tmp/.X11-unix/X$DN -nt /tmp/emux_sess_marker ]; then
      return 0
    fi
    tcp_open
  }
  # v0.2.16 FIELD FIX: socket presence is NOT a server. The v0.2.15 field
  # round adopted a "pre-existing" server whose sockets answered for a
  # couple of seconds (a dying zombie's half-closed listener), launched
  # ZERO Xvfbs, and the session then sat at "X server never came up (no
  # X0, tcp 6000 closed)" with xvfb.log absent. verify_x demands a REAL
  # X protocol handshake: xwd -root must succeed, bounded by a killer
  # subshell (timeout(1) is poison under this proot, see emux-capture).
  verify_x() {
    # v0.2.29: (a) unix leg now requires the socket file to be NEWER than
    # the session marker (a stale X0 from a SIGKILLed server claimed
    # liveness in the v0.2.28 field round: "leg=X0-file present" + "xwd
    # handshake rc=1"); (b) transition-only logging - the watcher polls
    # twice a second and unconditional echoes flooded diag and the pane
    # with identical leg/rc walls.
    local detail res=1 VR
    if ! x_up; then
      detail="DOWN leg=none(no fresh X$DN, tcp $XP not answering)"
      if [ "$detail" != "$LAST_VERIFY" ]; then echo "verify_x: $detail" >&2; LAST_VERIFY="$detail"; fi
      return 1
    fi
    detail="UP leg=fresh-X$DN-or-tcp"
    if ! command -v xwd >/dev/null 2>&1; then
      detail="$detail no-xwd(trust sockets)"
      if [ "$detail" != "$LAST_VERIFY" ]; then echo "verify_x: $detail" >&2; LAST_VERIFY="$detail"; fi
      return 0
    fi
    xwd -root -silent >/dev/null 2>&1 &
    VP=$!
    ( sleep 5; kill -9 "$VP" 2>/dev/null ) &
    VK=$!
    wait "$VP"; VR=$?
    kill "$VK" 2>/dev/null
    if [ "$VR" = 0 ]; then res=0; detail="$detail xwd-rc0"; else detail="$detail xwd-rc$VR"; fi
    if [ "$detail" != "$LAST_VERIFY" ]; then echo "verify_x: $detail" >&2; LAST_VERIFY="$detail"; fi
    return $res
  }
  # v0.2.78 STRAY-XVFB FIX. Every ladder attempt used to leave its Xvfb behind.
  # "adopt, don't fight" (v0.2.13) was right to forbid killing a server that is
  # SERVING - that round murdered the only live server mid-session - but it was
  # implemented as "never kill the previous attempt at all". So a ladder that
  # walked :0 -> :0 -> :1 left unverified Xvfbs parked on :0 for the rest of the
  # app's life: strays holding the very sockets the next session then has to
  # rotate around, which is the reported "stray Xvfb on :0 before settling on
  # :1". Retire OUR OWN previous attempt, and only when it is provably not
  # serving - no unix socket newer than this session's marker AND nothing
  # answering on its tcp port. That is the same evidence verify_x trusts, so a
  # serving server can never be killed by this.
  XVFB_PID=""; XVFB_PID_DN=""
  retire_own_xvfb() {
    [ -n "$XVFB_PID" ] || return 0
    kill -0 "$XVFB_PID" 2>/dev/null || { XVFB_PID=""; return 0; }
    # v0.2.90 FIELD FIX (stray-Xvfb leak, the v0.2.89 tablet round): the old
    # keep-checks below kept every FAILED attempt that still listened, so the
    # ladder parked live-but-unverified Xvfbs on :0 for the rest of the app
    # life - the field ran three X servers at once. The next session input
    # control plane then connected to one of those zombies: green badge,
    # proof ok, every tap injected into a bare-root server while the desktop
    # the user watched streamed from :1 (pointer never moved off center -
    # xdotool evidence). This function runs only when the ladder is about to
    # launch the NEXT attempt, i.e. after x_up already FAILED for this pid:
    # a server the ladder abandoned is a stray by definition, serving or
    # not. Kill it (gently, then -9); never let kill -0 decide - on the
    # field ROM it misreports freshly-forked tracees both ways. Adoption is
    # untouched: it happens BEFORE the ladder, never inside it, so a
    # VERIFIED pre-existing server is still adopted, never killed by this.
    local RD RI
    RD="${XVFB_PID_DN:-$DN}"
    echo "emux-x11: retiring our own failed Xvfb attempt pid $XVFB_PID on :$RD (the ladder abandoned it)" >&2
    kill "$XVFB_PID" 2>/dev/null
    RI=0
    while kill -0 "$XVFB_PID" 2>/dev/null && [ "$RI" -lt 20 ]; do sleep 0.1; RI=$((RI + 1)); done
    kill -9 "$XVFB_PID" 2>/dev/null
    XVFB_PID=""
    return 0
  }

  XTRY=0
  start_xvfb() { # rc: 0 up, 1 server died, 2 alive but not up yet
    # v0.1.88: keep THREE generations - attempt 1's log was being lost after
    # two rotations, and attempt 1 is where the truth lives.
    [ -f /tmp/xvfb.log.1 ] && mv -f /tmp/xvfb.log.1 /tmp/xvfb.log.2 2>/dev/null
    [ -f /tmp/xvfb.log ] && mv -f /tmp/xvfb.log /tmp/xvfb.log.1 2>/dev/null
    # v0.2.13: the explicit previous-attempt kill is GONE - it murdered the
    # only serving server mid-session (see kill_stale_x note). A live
    # previous attempt is now ADOPTED instead (below), never killed.
    # v0.2.78: ...but an attempt that is NOT serving is retired here, so the
    # ladder cannot accumulate strays (see retire_own_xvfb above). Adoption is
    # untouched: a verified server is never killed and never replaced.
    retire_own_xvfb
    # v0.1.80/81: sweep + drop stale sockets on EVERY attempt
    kill_stale_x
    XTRY=$((XTRY + 1))
    echo "emux-x11: Xvfb attempt $XTRY:$*" >&2
    ATTEMPT_FLAGS="$*"
    # v0.2.10 FIELD FIX: -extension MIT-SHM. Xvfb advertises MIT-SHM and xwd
    # then takes the shared-memory grab path - whose shmget/shmat syscalls
    # hang under proot's ptrace translation (field v0.2.9: preflight grab
    # succeeds, every real grab times out silently, "grab retry #10...").
    # With the extension disabled xwd can only use plain XGetImage, which
    # needs no shm syscalls at all. Our only clients are xwd/openbox.
    # v0.2.84 FBDIR - THE ZERO-PROCESS FRAMEBUFFER MAILBOX. -fbdir makes
    # Xvfb keep its screen in an mmap'ed file (XWD format, validated against
    # a real Xvfb_screen0: header 160B + palette + w*h*2 pixel bytes) that
    # the app reads DIRECTLY off the shared rootfs. The fallback capture
    # chain loses its per-frame xwd | xwdtopnm | pnmtoplainpnm text
    # pipeline (megabytes of ASCII through proot, per frame - the slowest
    # thing on the device), its socket push and its file copy, all at once.
    # Detected once per Xvfb binary; when unsupported the flag is simply
    # omitted and the app falls back to the v0.2.75 mailbox ladder.
    if [ -z "$FBDIR_CHECKED" ]; then
      FBDIR_CHECKED=1
      FBDIR_OPT=""
      mkdir -p /tmp/emux_fbdir 2>/dev/null
      # v0.2.112: no X-side cursor. The pane draws its own pointer (and a
      # real mouse/trackpad gets Android's), so Xvfb's software sprite was pure
      # cost: every pointer move made the server save/restore pixels under
      # it and re-damage that spot - capture work per motion event.
      NOCURSOR_OPT=""
      "$XVFB" -help 2>&1 | grep -q -- "-nocursor" && NOCURSOR_OPT="-nocursor"
      if "$XVFB" -help 2>&1 | grep -q -- "-fbdir"; then
        FBDIR_OPT="-fbdir /tmp/emux_fbdir"
        echo "emux-x11: fbdir ON - framebuffer file /tmp/emux_fbdir/Xvfb_screen0" >&2
      else
        echo "emux-x11: fbdir unsupported by $XVFB - fallback keeps the xwd chain" >&2
      fi
    fi
    # stale screen files from a previous attempt would paint a photograph
    rm -f /tmp/emux_fbdir/Xvfb_screen* 2>/dev/null
    "$XVFB" :"$DN" -screen 0 "$RES" -listen tcp -ac -extension MIT-SHM ${FBDIR_OPT:-} ${NOCURSOR_OPT:-} "$@" >/tmp/xvfb.log 2>&1 &
    XPID=$!
    XVFB_PID=$XPID; XVFB_PID_DN=$DN     # v0.2.78: ours to retire if it never serves
    i=0
    GONE=0
    while [ "$i" -lt 450 ]; do
      x_up && return 0
      # v0.2.9 FIELD FIX: one kill -0 miss is NOT death. Under proot the
      # pid translation races right after fork - the field process table
      # showed attempt-3's Xvfb ALIVE and serving (pid with -listen tcp
      # -ac flags) while /tmp/emux_attempts logged rc=1 for all three
      # attempts: each was declared dead at i=0, the ladder launched a
      # duplicate, and the duplicate died for real on the first (alive)
      # server's sockets - "server already running" was us fighting
      # ourselves. Require three consecutive misses ~1 s apart.
      if kill -0 "$XPID" 2>/dev/null; then
        GONE=0
      else
        GONE=$((GONE + 1))
        [ "$GONE" -ge 3 ] && return 1
      fi
      sleep 0.3; i=$((i + 1))
    done
    return 2
  }
  # v0.1.97: tell the Android side (via a FILE - socket waits proved
  # unreliable as a gate on this device) the moment X is reachable.
  ( trap '' HUP   # v0.2.36: watcher must outlive the launcher too
    i=0
    while [ "$i" -lt 600 ]; do
      # v0.2.20: follow display rotations/self-heal - re-read the published
      # display number every tick instead of trusting the fork-time copy
      # (a watcher pinned to a dead :0 never sets the marker and the
      # capture gate then waits its full 180 s for nothing).
      DNW=$(tr -dc '0-9' < /tmp/emux_display_num 2>/dev/null)
      if [ -n "$DNW" ] && [ "$DNW" != "$DN" ]; then
        DN="$DNW"; XP=$((6000 + DN))
      fi
      if verify_x; then
        echo "watcher: X verified up at $(date +%T) on :$DN" >&2
        : > /tmp/emux_x_up 2>/dev/null; break
      fi
      sleep 0.5; i=$((i + 1))
    done ) &
  # v0.2.13 FIELD FIX: ADOPT, DON'T FIGHT. If anything already answers on
  # this display - an unkillable zombie from a previous app life, or an
  # earlier attempt this session misreported as dead - it serves clients
  # perfectly (the capture preflight proved it in every field round),
  # while every NEW Xvfb we launch either dies on its sockets or gets
  # killed by our own next attempt. Launch zero servers in that case.
  if verify_x; then
    echo "emux-x11: adopting VERIFIED running X server on :$DN (tcp $XP)" >&2
    : > /tmp/emux_attempts 2>/dev/null
    echo "$(date +%s) adopted rc=0 flags=<pre-existing>" >> /tmp/emux_attempts 2>/dev/null
  else
  rc=0
  : > /tmp/emux_attempts 2>/dev/null
  # v0.1.86: PURE IPv4 TCP first. The v0.1.85 shim selftest proved guest
  # binds work for IPv4/unix-path/abstract (all errno 0), so X's failure is
  # X-specific: its dual-stack tcp listener tries AF_INET6 first (the host
  # probe and shim only tested IPv4) and its unix listener uses the odd-mode
  # .X11-unix dir. Both are sidestepped by -nolisten unix -nolisten inet6;
  # every client we run speaks IPv4 tcp (X11Client dials 127.0.0.1; Xlib
  # falls back from unix to tcp for DISPLAY=:0).
  # v0.1.88: "local" too - on some X builds -nolisten unix alone does not
  # disable the unix transport ("local" is the classic umbrella name).
  # v0.2.4 FIELD FIX: attempt 1 WITH the unix socket enabled. The v0.1.86
  # triple -nolisten made Xvfb tcp-only, and on the field device xwd then
  # died with "unable to open display ':0'" (emux_cap.err) even though
  # `nc -z 127.0.0.1 6000` succeeded and the server ran with -ac: on this
  # ROM/libX11 combo the tcp X HANDSHAKE is the broken path, while the
  # unix transport provably binds+connects inside the guest (probe
  # unix-bind rc=124=ok). With /tmp/.X11-unix/X0 present, every client
  # (xwd, wm, xterm) uses the transport that works. If the unix/inet6
  # listeners are what kills Xvfb on some other ROM, the ladder falls
  # through to the old tcp-only flags as attempt 2.
  start_xvfb || rc=$?
  echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  if [ "$rc" != 0 ]; then
    echo "emux-x11: plain attempt rc=$rc - falling back to tcp-only listener" >&2
    start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  fi
  if [ "$rc" = 2 ]; then
    # server alive, socket slow (first-run font scan under proot): give it
    # 60 s more INSTEAD of killing it - the v0.1.39 logic mistook slow for shm.
    echo "emux-x11: Xvfb alive but not up in 45 s - waiting 60 s more" >&2
    i=0
    while [ "$i" -lt 600 ] && ! x_up; do sleep 0.1; i=$((i + 1)); done
  elif [ "$rc" = 1 ]; then
    echo "emux-x11: Xvfb died on first start - previous log kept at /tmp/xvfb.log.1:" >&2
    tail -5 /tmp/xvfb.log.1 >&2 2>/dev/null
    if grep -qi "shm" /tmp/xvfb.log.1 2>/dev/null && [ -n "$NOSHEM" ]; then
      echo "emux-x11: shm failure in log - retrying with $NOSHEM" >&2
      start_xvfb -nolisten unix $NOSHEM || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    else
      echo "emux-x11: retrying with tcp (all families, unix off)" >&2
      start_xvfb -nolisten unix -nolisten local || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
    # v0.1.80: if THAT also died on a socket clash, sweep once more, 3rd shot
    if [ "$rc" = 1 ] && grep -qi "listening sockets" /tmp/xvfb.log 2>/dev/null; then
      echo "emux-x11: socket clash persists - sweeping again, 3rd attempt" >&2
      probe_sockets
      kill_stale_x
      start_xvfb || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  fi
  # v0.2.6 FIELD FIX: WALK AWAY from occupied sockets. The field ROM hides
  # other processes' cmdlines, so the host pid-scan kill has silently
  # no-oped for five versions, and guest sweeps cannot signal foreign
  # proot tracees - zombie Xvfb processes from previous app lives keep
  # their unix/abstract/tcp sockets forever ("server already running",
  # every ladder attempt rc=1, even on a display the host probe called
  # free one second earlier). Instead of fighting: rotate to the next
  # display number and run the ladder there, up to 3 rotations.
  ROT=0
  while ! x_up && [ "$ROT" -lt 3 ]; do
    DN=$((DN + 1)); XP=$((6000 + DN)); ROT=$((ROT + 1))
    echo "emux-x11: sockets occupied on :$((DN - 1)) - rotating to :$DN (rot $ROT/3)" >&2
    kill_stale_x
    rc=0
    start_xvfb || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    if [ "$rc" = 1 ]; then
      start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  done
  fi
  # v0.2.16: adoption (or a ladder) can still end up believing in a server
  # that is gone. Verify with a real handshake; if nothing verifies, rotate
  # the display and LAUNCH for real instead of waiting on a ghost.
  if ! verify_x; then
    DN=$((DN + 1)); XP=$((6000 + DN))
    echo "emux-x11: no verifiable X server on :$((DN - 1)) - rotating to :$DN and launching" >&2
    kill_stale_x
    rc=0
    start_xvfb || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    if [ "$rc" = 1 ]; then
      start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  fi
  # v0.2.6: publish the display this session ACTUALLY runs on; emux-capture
  # and the Android control plane read it instead of assuming :0/$2.
  echo "$DN" > /tmp/emux_display_num 2>/dev/null
  # v0.2.104: TERMINAL-DISPLAY HINT. Field (vc203 screenshot): every X
  # command run from the Terminal tab died "Can't open display: (null)" -
  # the app-side sessionEnv pins DISPLAY=:0, the display rotates past :0 on
  # stale sockets, and (see v0.2.13 below) a bare ":N" cannot reach a
  # tcp-only server at all - so the pin was wrong twice over and NO
  # guest-side diagnostic (xdotool / xdpyinfo / wmctrl / GUI launches)
  # could ever run. Publish the VERIFIED display to login shells: bash -l
  # sources /etc/profile -> /etc/profile.d/*.sh, so every new Terminal tab
  # exports the LIVE display. Rewritten at each desktop start; stale when
  # the desktop is down (harmless - nothing listens either way).
  DFORM="127.0.0.1:$DN"
  if [ -e /tmp/.X11-unix/X$DN ]; then DFORM=":$DN"; fi
  if mkdir -p /etc/profile.d 2>/dev/null; then
    echo "export DISPLAY=$DFORM" > /etc/profile.d/emux-display.sh 2>/dev/null &&
      echo "emux-x11: terminal hint -> /etc/profile.d/emux-display.sh (DISPLAY=$DFORM)" >&2
  fi
  # v0.2.13: a tcp-only server (no unix socket) is NOT reachable as ":N"
  # on this libX11 stack - it does not fall back to tcp. Export the tcp
  # form so openbox/xwd connect first try.
  if [ -e /tmp/.X11-unix/X$DN ]; then
    export DISPLAY=:$DN
  else
    export DISPLAY="127.0.0.1:$DN"
    echo "emux-x11: no unix socket on :$DN - DISPLAY=$DISPLAY (tcp form)" >&2
  fi
  echo "emux-x11: session display $DISPLAY (tcp $XP)" >&2
fi
# v0.2.38 FIELD FIX: openbox IMMEDIATELY too (it used to launch only
# inside the REST subshell, behind an apt loop that can chew for minutes
# or wait on a previous session's now-SIGHUP-immortal apt - field v0.2.37:
# live stream, zero windows). Seed the full desktop config first
# (v0.2.45: panel config, menu, icons, autostart) so the WM brings a
# real desktop with it, not just a root window.
if [ -x /usr/bin/openbox ] || [ -x "/usr/bin/$WM" ]; then
  seed_desktop_config
  command -v update-menus >/dev/null 2>&1 && update-menus >/dev/null 2>&1 &
fi
# v0.2.59: seed_desktop_config above writes ~/.config/openbox/autostart, so it
# MUST run before start_wm - that is the whole point of the --startup fix.
paint_root
if [ ! -e /tmp/emux_wm_launched ]; then
  start_wm "$WM"
fi
# v0.2.53 FIELD FIX: input over the shared filesystem. The host-side
# X11Client (tcp AND unix LocalSocket) has never completed a handshake on
# this ROM in 52 rounds, while guest-local X connections (xwd, tint2,
# xterm) always work. So input stops trying to speak X from Android:
# the app writes one line per event into a FIFO in the rootfs, and this
# agent replays them with xdotool INSIDE the guest, on the session's
# DISPLAY. The filesystem is the one channel proven bidirectional
# (markers, logs, frames-config all ride it already).
start_agent() {
  nohup /bin/sh -c '
    FIFO=/tmp/emux_in
    rm -f "$FIFO" 2>/dev/null
    mkfifo "$FIFO" 2>/dev/null || exit 0
    exec 3<>"$FIFO"
    # v0.2.59: no pathname expansion - key names and text payloads must reach
    # xdotool verbatim, never glob-expanded against the guest filesystem.
    set -f
    CDN=""
    while IFS= read -r LINE <&3; do
      [ -n "$LINE" ] || continue
      # v0.2.59 FIELD FIX: split off ONLY the command letter. The old
      # `read -r t a b c` split the payload on spaces, so a text event lost
      # everything after its second space and a key name with arguments could
      # not be expressed at all.
      T=${LINE%% *}
      ARG=${LINE#"$T"}
      ARG=${ARG# }
      # v0.2.55 FIELD FIX: follow display rotations. The agent pinned its
      # DISPLAY at launch, but the self-heal can rotate the display AFTER
      # it starts - every tap then replayed onto the old, unseen server
      # ("INPUT: agent green but I cannot click the taskbar").
      ND=$(tr -dc 0-9 < /tmp/emux_display_num 2>/dev/null)
      if [ -n "$ND" ] && [ "$ND" != "$CDN" ]; then
        CDN="$ND"
        if [ -e "/tmp/.X11-unix/X$CDN" ]; then export DISPLAY=":$CDN"; else export DISPLAY="127.0.0.1:$CDN"; fi
        echo "agent: following display to $DISPLAY"
      fi
      if ! command -v xdotool >/dev/null 2>&1; then
        # v0.2.54: never drop events silently again - the field round had
        # INPUT: agent green while xdotool was simply not installed.
        if [ ! -e /tmp/emux_agent_noxtool ]; then
          touch /tmp/emux_agent_noxtool
          echo "agent: xdotool MISSING - events dropped until installed (apt-get install -y xdotool)"
        fi
        continue
      fi
      rm -f /tmp/emux_agent_noxtool 2>/dev/null
      # v0.2.59 FIELD FIX: THE KEYBOARD BUG. The host used to send
      # "K <keysym-integer>" and this agent ran `xdotool keydown <integer>`.
      # xdotool treats a bare number as a KEYCODE, not a keysym: measured on a
      # live server, `xdotool keydown 97` injects keycode 97 while keysym 97
      # ("a") is keycode 38 - and `xdotool keydown a` correctly injects 38.
      # So every character typed on the desktop went to the wrong key (or to
      # nothing at all for the >0xFF Unicode keysym range, whose decimal form
      # is far outside the 8..255 keycode window). Typing into an xterm that
      # was fed `xdotool type --clearmodifiers` plus `xdotool key <NAME>`
      # worked first time.
      #
      # Protocol now (one line per event, payload kept verbatim):
      #   M <x> <y>   pointer move
      #   D <button>  button press        U <button>  button release
      #   T <text>    literal text  -> xdotool type --clearmodifiers
      #   N <name>    X11 key name  -> xdotool key  --clearmodifiers
      #   K <keysym>  legacy; translated here to a name, never passed through
      case "$T" in
        M) set -- $ARG; xdotool mousemove --sync "$1" "$2" >/dev/null 2>&1 ;;
        D) set -- $ARG
           xdotool mousedown "$1" >/dev/null 2>&1
           echo "agent: ev D b=$1 rc=$?"
           if [ ! -e /tmp/emux_agent_firstclick ]; then
             touch /tmp/emux_agent_firstclick
             echo "agent: first-click evidence:"
             echo "  mouse: $(xdotool getmouselocation 2>&1)"
             echo "  panelwin=$(xdotool search --class tint2 2>&1 | head -1)"
             echo "  activewin=$(xdotool getactivewindow 2>&1 | head -1)"
             echo "  xsockets: $(ls /tmp/.X11-unix 2>/dev/null | tr '"'"'\n'"'"' '"'"' '"'"')"
           fi ;;
        U) set -- $ARG
           xdotool mouseup "$1" >/dev/null 2>&1
           echo "agent: ev U b=$1 rc=$?" ;;
        T) xdotool type --clearmodifiers -- "$ARG" >/dev/null 2>&1
           echo "agent: ev T len=${#ARG} rc=$?" ;;
        N) # Deliberately UNQUOTED: `xdotool key` takes one key name per
           # argument, so a multi-key payload ("BackSpace BackSpace") must
           # word-split. Passed as one quoted string it is not a valid key
           # name and xdotool exits 2 - measured, not assumed.
           xdotool key --clearmodifiers -- $ARG >/dev/null 2>&1
           echo "agent: ev N k=$ARG rc=$?" ;;
        K) N=""
           case "$ARG" in
             65288) N=BackSpace;; 65289) N=Tab;;      65293) N=Return;;
             65307) N=Escape;;    65535) N=Delete;;   65360) N=Home;;
             65361) N=Left;;      65362) N=Up;;       65363) N=Right;;
             65364) N=Down;;      65365) N=Prior;;    65366) N=Next;;
             65367) N=End;;       65300) N=Num_Lock;; 65507) N=ctrl;;
             65505) N=shift;;     65509) N=Caps_Lock;;
           esac
           if [ -n "$N" ]; then
             xdotool key --clearmodifiers -- "$N" >/dev/null 2>&1
             echo "agent: ev K ks=$ARG -> $N rc=$?"
           elif [ "$ARG" -ge 32 ] 2>/dev/null && [ "$ARG" -le 126 ] 2>/dev/null; then
             CH=$(printf "\\$(printf '"'"'%03o'"'"' "$ARG")")
             xdotool type --clearmodifiers -- "$CH" >/dev/null 2>&1
             echo "agent: ev K ks=$ARG -> char '"'"'$CH'"'"' rc=$?"
           else
             echo "agent: ev K ks=$ARG has no xdotool encoding - DROPPED (upgrade the app: it should send T/N)"
           fi ;;
        k) : ;;   # legacy key-release: `xdotool key` already releases
        *) echo "agent: unknown event '"'"'$T'"'"'" ;;
      esac
    done
  ' >/tmp/emux_agent.log 2>&1 </dev/null &
  echo $! > /tmp/emux_agent_pid 2>/dev/null
}
# v0.2.67 FIX: the agent became a FUNCTION so the governor can relaunch it
# when the LMK reaps it mid-session (the fallback transport used to cease to
# exist silently exactly when a dead control plane needed it).
if [ ! -e /tmp/emux_agent_launched ]; then
  touch /tmp/emux_agent_launched
  start_agent
  # v0.2.112: the census below walks every process with ~4 traced execs each,
  # 45 s in - right when the user starts working. Diagnostics only now:
  # touch ~/.config/emux/diagnostics to bring it back.
  [ -e "$HOME/.config/emux/diagnostics" ] && \
  # v0.2.58 EVIDENCE ROUND: delayed deep census. ~45 s in, dump pid +
  # process state + DISPLAY of every desktop participant plus the root
  # pixmap verdict into the agent log - proves who is alive, on which
  # server, and whether the wallpaper layer ever painted.
  nohup /bin/sh -c '
    sleep 45
    ND=$(tr -dc 0-9 < /tmp/emux_display_num 2>/dev/null)
    [ -n "$ND" ] && { [ -e "/tmp/.X11-unix/X$ND" ] && export DISPLAY=":$ND" || export DISPLAY="127.0.0.1:$ND"; }
    { echo "census @ $(date +%T):"
      for f in /proc/[0-9]*/cmdline; do
        c=$(tr "\0" " " < "$f" 2>/dev/null)
        case "$c" in
          *Xvfb*|*openbox*|*tint2*|*pcmanfm*|*picom*|*emux-capture*|*emux-x11*)
            p=${f#/proc/}; p=${p%/cmdline}
            st=$(sed -n "s/^State:.//p" /proc/$p/status 2>/dev/null | tr -d " ")
            dsp=$(tr "\0" "\n" < /proc/$p/environ 2>/dev/null | sed -n "s/^DISPLAY=//p" | head -1)
            echo "  pid=$p state=${st:-?} DISPLAY=${dsp:-none} cmd=${c% }"
          ;;
        esac
      done
      echo "  rootpmap=$(xprop -root _XROOTPMAP_ID 2>&1 | head -1)"
    } >> /tmp/emux_agent.log 2>&1
  ' >/dev/null 2>&1 </dev/null &
fi
# v0.2.38: visibility watchdog - if no window client is alive (killed,
# crashed, or never installed), relaunch one, for the first ~10 min.
# v0.2.45: a running WM / panel / file manager IS a live desktop, so
# they count as "has" too. Before, only xterm/xclock/xeyes counted, so
# closing the terminal on a healthy GUI desktop made the watchdog
# resurrect a terminal window - the desktop could never stop looking
# like a terminal. Now the watchdog only forces a terminal when the
# whole desktop (WM + panel + icons) is gone.
( trap '' HUP
  i=0
  APTTRIED=0
  # v0.2.50: ~20 min window + self-furnishing: on a fresh device the first
  # desktop open must install tint2/pcmanfm/mousepad with ZERO manual
  # terminal steps (user request: "make the apk auto do these installs -
  # I want to use it on another device"). If the binaries are missing and
  # no apt is running, the governor installs them itself (logged to
  # /tmp/emux_rest.log); start_furniture launches them the tick they land.
  while [ "$i" -lt 240 ]; do
    sleep 5
    # v0.2.67: keep the FALLBACK transport alive. The agent is the only input
    # path that does not depend on our persistent control-plane socket; if
    # Android's LMK reaps it mid-session (no root => oom protection denied),
    # relaunch it from its pidfile instead of ceasing to exist silently.
    if [ -r /tmp/emux_agent_pid ]; then
      APID=""; read -r APID < /tmp/emux_agent_pid 2>/dev/null   # v0.2.112: builtin, no exec
      case "$APID" in *[!0-9]*) APID="" ;; esac
      if [ -n "$APID" ] && ! kill -0 "$APID" 2>/dev/null; then
        echo "emux-x11: governor: input agent (pid $APID) dead - relaunching" >&2
        start_agent
      fi
    fi    # v0.2.89: the check used to cover FURNITURE ONLY and tried apt exactly
    # once. Field v0.2.88 (fresh Ubuntu rootfs): the first big install died
    # partway, tint2/pcmanfm healed via this governor but openbox/xterm/
    # xsetroot stayed missing - a WM-LESS desktop: pcmanfm dialogs had no
    # min/max/close/resize decorations and tint2 listed no tasks and no
    # terminal launcher (no EWMH _NET_CLIENT_LIST without a WM). Check the
    # WM set too, and retry (a once-only flag can never heal a download
    # that failed mid-way).
    # v0.2.112: picom is opt-in (never required), and a set that cannot be
    # installed is retried on ONE day only - it used to re-run a full apt
    # transaction 3x at every desktop start while the user was working.
    if { [ ! -x /usr/bin/tint2 ] || [ ! -x /usr/bin/pcmanfm ] || [ ! -x /usr/bin/xdotool ] || [ ! -x /usr/bin/openbox ] || [ ! -x /usr/bin/xterm ] || [ ! -x /usr/bin/xsetroot ]; } && [ "$APTTRIED" -lt 3 ] \
       && { [ "$APTTRIED" -gt 0 ] || [ "$(cat /var/lib/emux_gov_day 2>/dev/null)" != "$(date +%Y%m%d)" ]; }; then
      if ! apt_busy; then
        [ "$APTTRIED" = 0 ] && date +%Y%m%d > /var/lib/emux_gov_day 2>/dev/null
        APTTRIED=$((APTTRIED + 1))
        echo "emux-x11: governor installing missing furniture/wm (tint2/pcmanfm/xdotool/picom/openbox/xterm/x11-apps) - attempt $APTTRIED/3" >&2
        ( apt_lists_stale && apt_update_once
          DEBIAN_FRONTEND=noninteractive nice -n 19 apt-get install -y --no-install-recommends \
            tint2 pcmanfm mousepad x11-xserver-utils xdotool picom openbox xterm x11-apps >>/tmp/emux_rest.log 2>&1
          dpkg --configure -a >>/tmp/emux_rest.log 2>&1
          if [ ! -x /usr/bin/xdotool ] || [ ! -x /usr/bin/openbox ]; then
            echo "emux-x11: governor install FAILED - xdotool/openbox still missing; rest.log tail:" >&2
            tail -6 /tmp/emux_rest.log >&2 2>/dev/null
          fi ) &
      fi
    fi
    # v0.2.89: WM watchdog. start_wm() runs exactly once per session; if the
    # WM binary was missing at that instant (fresh rootfs whose first install
    # died partway) or the WM died later, NOTHING ever relaunched it. A
    # WM-less desktop has no window decorations, an empty tint2 taskbar and
    # no way to open a terminal from the panel. Relaunch whenever the
    # preferred WM and every fallback is down but a binary exists - which
    # also covers "the governor just installed openbox mid-session".
    if ! running0 "$WM" && ! running0 openbox && ! running0 icewm && ! running0 fluxbox && ! running0 twm \
       && { [ -x "/usr/bin/$WM" ] || [ -x /usr/bin/openbox ] || [ -x /usr/bin/icewm ] || [ -x /usr/bin/twm ]; }; then
      echo "emux-x11: governor: no window manager running - (re)launching $WM" >&2
      start_wm "$WM"
    fi
    has=0
    # v0.2.88: argv[0]-exact has-scan. The old whole-cmdline grep
    # 'openbox|tint2|pcmanfm|xterm|xclock|xeyes' matched THIS LAUNCHER's own
    # argv (`/bin/sh /usr/local/bin/emux-x11 openbox …`) on every tick, so
    # has=1 was a constant and the visibility client could never relaunch -
    # dead code since v0.2.45, and the reason a client-less black pane never
    # self-healed during first-boot package installs.
    # v0.2.112: one ps + awk (was tr|head per process, every 5 s)
    running_any openbox tint2 pcmanfm xterm xclock xeyes mate-session && has=1
    if [ "$has" = 0 ]; then
      for vc in /usr/bin/xterm /usr/bin/xclock /usr/bin/xeyes; do
        if [ -x "$vc" ]; then
          echo "emux-x11: watchdog relaunching visibility client $vc" >&2
          nohup "$vc" >>/tmp/vis.log 2>&1 </dev/null &
          break
        fi
      done
    fi
    start_furniture   # v0.2.39: catches furniture the moment REST installs it
    # v0.2.58 FIELD FIX: pcmanfm wedge watchdog. A wedged --desktop client
    # paints nothing (black root, no icons) and can hold the pointer grab so
    # every injected click vanishes while xdotool returns rc=0. A HEALTHY
    # pcmanfm publishes _XROOTPMAP_ID once it paints the wallpaper; absence
    # 25 s after start = wedged: kill -9 and relaunch. 4th strike: give up
    # on the wallpaper layer and paint a solid root - never a black void.
    # v0.2.112: once the root pixmap was seen, the wedge check is done for
    # the session (it used to run ps + date + stat + xprop every 5 s forever).
    if [ -x /usr/bin/pcmanfm ] && [ -e /tmp/emux_pcmanfm_started ] && [ ! -e /tmp/emux_pcmanfm_ok ] && running0 pcmanfm; then
      PFAGE=$(( $(date +%s) - $(stat -c %Y /tmp/emux_pcmanfm_started 2>/dev/null || echo 0) ))
      if [ "$PFAGE" -ge 25 ] && xprop -root _XROOTPMAP_ID >/dev/null 2>&1; then
        : > /tmp/emux_pcmanfm_ok
      elif [ "$PFAGE" -ge 25 ]; then
        W=$(( $(cat /tmp/emux_pcmanfm_wedges 2>/dev/null || echo 0) + 1 ))
        echo "$W" > /tmp/emux_pcmanfm_wedges
        echo "emux-x11: pcmanfm WEDGE strike $W (no _XROOTPMAP_ID ${PFAGE}s after start) - kill -9 + relaunch" >&2
        # v0.2.88: kill by argv[0], never by substring. The old loop grepped
        # 'pcmanfm' over WHOLE cmdlines and could kill -9 an apt/dpkg
        # transaction (whose argv literally lists pcmanfm) or the doctor
        # shell - i.e. the wedge "fix" was able to abort the very install
        # that would have fixed the wedge.
        for f in /proc/[0-9]*/cmdline; do
          p=${f#/proc/}; p=${p%/cmdline}
          a=$(tr '\0' '\n' < "$f" 2>/dev/null | head -1)
          [ -n "$a" ] || continue
          case "$a" in */*) a=${a##*/} ;; esac
          [ "$a" = "pcmanfm" ] && kill -9 "$p" 2>/dev/null
        done
        rm -f /tmp/emux_pcmanfm_started
        if [ "$W" -ge 4 ]; then
          echo "emux-x11: 4th wedge strike - falling back to xsetroot -solid" >&2
          xsetroot -solid '#1a2733' 2>/dev/null
        fi
      fi
    fi
    i=$((i + 1))
  done ) &
# v0.2.35 FIELD FIX: launch a visibility client IMMEDIATELY once the
# server is up - not behind the REST apt loop (field v0.2.34: the loop
# spends minutes in apt_busy waits/downloads on this rootfs, so the
# WM/xterm launches - and every window - arrived long after the user
# gave up on the black pane). xclock/xeyes ship in x11-apps, part of
# the synchronous CORE install, so one of them is already on disk even
# with apt completely broken. xeyes follows the pointer: capture,
# stream, display and input injection proven in one widget.
# v0.2.43: unconditional + self-verifying. Marker gating lost a race
# somewhere in the respawn/sweep interplay (field v0.2.39-42: live
# stream, zero windows, vis.log empty); a duplicate window is harmless,
# a missing one is the entire failure mode. Launch the first available
# client every session, then confirm it survived one second and say so
# in the diag - the next field screenshot answers itself.
# v0.2.45: ...unless the visual desktop is already up. On a complete
# rootfs, start_furniture just launched tint2 + pcmanfm, so forcing an
# xterm on top of them is what made every "desktop" look like a
# terminal. Skip the forced terminal when panel/desktop are running;
# keep it as the fallback when they are not installed yet (first run,
# while REST is still installing them).
start_furniture
if running0 tint2 || running0 pcmanfm; then
  echo "emux-x11: desktop furniture up (panel/desktop) - skipping forced terminal window" >&2
else
  for vc in /usr/bin/xterm /usr/bin/xclock /usr/bin/xeyes; do
    if [ -x "$vc" ]; then
      echo "emux-x11: launching visibility client $vc on $DISPLAY (immediate)" >&2
      nohup "$vc" >/tmp/vis.log 2>&1 </dev/null &
      VPID=$!
      sleep 1
      if kill -0 "$VPID" 2>/dev/null; then
        echo "emux-x11: visibility client alive (pid $VPID, $vc)" >&2
      else
        echo "emux-x11: visibility client DEAD on launch ($vc); vis.log:" >&2
        tail -3 /tmp/vis.log >&2 2>/dev/null
      fi
      break
    fi
  done
fi
# v0.1.79: REST (WM + capture toolchain) installs NOW that X is up - never
# under a starting server (see APT_BRANCH note above). When it lands, start
# the WM if none runs yet.
if x_up && [ "$APT_BRANCH" = 1 ]; then
  (
    trap '' HUP   # v0.2.36: survive the launcher's PTY close
    # v0.2.42: furniture loop only while furniture is missing - same
    # transaction-window reasoning as NEEDCORE.
    NEEDREST=0
    for b in /usr/bin/tint2 /usr/bin/pcmanfm /usr/bin/mousepad /usr/bin/galculator; do
      [ -x "$b" ] || NEEDREST=1
    done
    # v0.2.112: a package that never installs (offline, missing from the
    # repo) made this run up to 30 apt/dpkg attempts on EVERY desktop start
    # - minutes of full CPU under proot while the user works. At most once a
    # day now, 3 attempts, lowest priority.
    REST_DAY=$(date +%Y%m%d)
    if [ "$NEEDREST" = 1 ] && [ "$(cat /var/lib/emux_rest_day 2>/dev/null)" = "$REST_DAY" ]; then
      echo "emux-x11: REST furniture install already tried today - skipping" >&2
      NEEDREST=0
    fi
    if [ "$NEEDREST" = 1 ]; then
    echo "$REST_DAY" > /var/lib/emux_rest_day 2>/dev/null
    apt_lists_stale && apt_update_once
    TRIES=0
    while [ "$TRIES" -lt 3 ]; do
      if apt_busy; then TRIES=$((TRIES + 1)); sleep 10; continue; fi
      DEBIAN_FRONTEND=noninteractive nice -n 19 apt-get install -y --no-install-recommends \
        $REST >&2 && break
      TRIES=$((TRIES + 1)); heal_dpkg; sleep 2
    done
    i=0
    while [ "$i" -lt 2 ]; do dpkg --configure -a >&2 && break; i=$((i + 1)); done
    sleep 1
    else
      echo "emux-x11: furniture present - skipping REST apt transaction" >&2
    fi
    start_furniture   # v0.2.39: panel/icons/menu as soon as they land
    # v0.2.46: if the furniture still is not on disk, say WHY with the apt
    # tail - forty rounds of silent furniture failures happened because
    # this subshell's output went to /dev/null (see below).
    if [ ! -x /usr/bin/tint2 ] || [ ! -x /usr/bin/pcmanfm ] || [ ! -x /usr/bin/xdotool ]; then
      echo "emux-x11: REST install incomplete (tint2/pcmanfm/xdotool missing) - tail of /tmp/emux_rest.log:" >&2
      tail -6 /tmp/emux_rest.log >&2 2>/dev/null
    fi
    if [ ! -e /tmp/emux_wm_launched ]; then
      # v0.2.45: full desktop config (panel, menu, icons, autostart) -
      # seed_desktop_config already ran inside start_furniture above;
      # just refresh the openbox menu database if the menu pkg landed.
      command -v update-menus >/dev/null 2>&1 && update-menus >/dev/null 2>&1 &
      start_wm "$WM"
      # v0.2.14: a working desktop with no windows is a pure-black void
      # (field: "for a moment there was a black desktop with nothing") -
      # indistinguishable from a broken pipeline. Open one xterm so the
      # session is visibly alive and input-testable.
      # v0.2.32: and if xterm is not even installed (half-configured REST
      # pass on the field device), install it now - a streaming black
      # desktop is worse than useless as proof of life.
      if [ ! -x /usr/bin/xterm ]; then
        echo "emux-x11: xterm missing - installing for visibility" >&2
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xterm >&2 || true
        dpkg --configure -a >&2 || true
      fi
      # v0.2.34: visibility client fallback chain. If apt is too broken to
      # ever install xterm (half-configured rootfs), launch a client that
      # is ALREADY on disk: xclock/xeyes ship in x11-apps, which is part of
      # the synchronous CORE install - so a streaming desktop can never
      # again be a windowless black void. xeyes even proves input (the
      # eyes follow your finger).
      # v0.2.45: only as a last resort - if start_furniture already
      # brought the panel/desktop up, a forced terminal just hides
      # the GUI desktop again.
      if [ ! -e /tmp/emux_xterm_launched ] && ! running0 tint2 && ! running0 pcmanfm && ! running0 mate-panel; then
        for vc in /usr/bin/xterm /usr/bin/uxterm /usr/bin/rxvt /usr/bin/xclock /usr/bin/xeyes; do
          if [ -x "$vc" ]; then
            echo "emux-x11: launching visibility client $vc" >&2
            "$vc" >/tmp/xterm.log 2>&1 &
            touch /tmp/emux_xterm_launched
            break
          fi
        done
      fi
    fi
  ) >/tmp/emux_rest.log 2>&1 &   # v0.2.46: was /dev/null - silent failures
fi
[ -n "$XPID" ] || XPID=$!

# v0.2.18 FIELD FIX: self-heal a vanished adoption. Field v0.2.17: the
# session verified+adopted a ghost (dying zombie / first-second listener),
# launched zero Xvfbs, and ended here server-less. Instead of giving up:
# rotate the display (nothing holds the next one) and launch for real.
if ! verify_x; then
  DN=$((DN + 1)); XP=$((6000 + DN))
  echo "emux-x11: adopted server vanished - rotating to :$DN and launching now" >&2
  kill_stale_x
  rc=0
  start_xvfb || rc=$?
  echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  if [ "$rc" = 1 ]; then
    start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  fi
  echo "$DN" > /tmp/emux_display_num 2>/dev/null
  if [ -e /tmp/.X11-unix/X$DN ]; then export DISPLAY=:$DN; else export DISPLAY="127.0.0.1:$DN"; fi
  echo "emux-x11: session display now $DISPLAY (tcp $XP)" >&2
  # v0.2.20: a server alone is not a desktop. The WM/xterm launches earlier
  # in this script ran against the ghost display and died; relaunch them
  # against the new one, and set the X-up marker so the capture gate does
  # not wait 180 s for a watcher forked against the old display.
  if verify_x; then
    : > /tmp/emux_x_up 2>/dev/null
    rm -f /tmp/emux_wm_launched /tmp/emux_xterm_launched /tmp/emux_root_painted 2>/dev/null
    paint_root
    start_wm "$WM"
    if [ -x /usr/bin/xterm ] && [ ! -e /tmp/emux_xterm_launched ]; then
      nohup /usr/bin/xterm -geometry 96x28+60+40 >/tmp/xterm.log 2>&1 </dev/null &
      touch /tmp/emux_xterm_launched
    fi
    echo "emux-x11: self-heal complete - WM/xterm launched on $DISPLAY" >&2
  fi
fi
# fail loudly with the captured log
if ! x_up; then
  echo "emux-x11: X server never came up (no X$DN, tcp $XP closed) - log follows (previous attempt: /tmp/xvfb.log.1):" >&2
  tail -20 /tmp/xvfb.log >&2
  exit 1
fi

# window manager; fall back through installed WMs to xterm so SOMETHING draws.
# v0.2.59: start_wm() owns the whole cascade now (and runs Openbox with
# --startup so the seeded autostart actually executes - see its comment).
start_wm "$WM" || {
  if [ -x /usr/bin/xterm ]; then
    /usr/bin/xterm -e /bin/sh -l >/tmp/wm.log 2>&1 &
    touch /tmp/emux_wm_launched /tmp/emux_xterm_launched
  else
    echo "emux-x11: no window manager found ($WM/openbox/twm/icewm) and no xterm - root window will be blank. Install one with the distro package manager (apk add openbox / apt-get install openbox / pacman -S openbox / dnf install openbox)" >&2
  fi
}
# v0.1.100 FIX (blank desktop even when frames flow): Openbox alone
# draws a bare root window — no icons, no taskbar, no open window —
# so a perfectly working frame stream still reads as "no visual
# interface". Launch one xterm once the WM is up, so SOMETHING visible
# is on screen. The fallback branch above already launched xterm and
# touched emux_xterm_launched, so this never launches a second one.
# v0.2.45: ...but NOT when the visual desktop is already up. Panel +
# desktop icons are the visible thing now; a forced terminal on top
# of them is the bug the user reported, not the fix.
if [ -e /tmp/emux_wm_launched ] && [ ! -e /tmp/emux_xterm_launched ] \
   && [ -x /usr/bin/xterm ] && ! running0 tint2 && ! running0 pcmanfm && ! running0 mate-panel; then
  /usr/bin/xterm >/tmp/xterm.log 2>&1 &
  touch /tmp/emux_xterm_launched
fi
# v0.2.45: report the desktop, not just the server, a few seconds in.
# Runs in the background so the launcher can go on waiting on Xvfb;
# its output lands in the pane log and in /tmp/emux_desktop_check.
( verify_desktop ) &
# v0.2.78: watch for the app's button-delivery verdict and escalate
# (rc.xml rewrite -> reconfigure -> WM switch). Must outlive the launcher's
# PTY close, hence the HUP trap; it is a 2 s poll on two small files.
( trap '' HUP
  btn_watch ) >/dev/null 2>&1 &
# v0.1.43: never exit silently — the Android side paints this on the desktop
# pane, so a dying X server now names its own reason in the field.
wait $XPID
RC=$?
# v0.1.62: if Xvfb dies mid-session (shm SIGBUS class), restart ONCE with
# -noshmem instead of ending the session and orphaning the pane.
if [ "$RC" != 0 ] && [ ! -e /tmp/emux_xvfb_restarted ]; then
  touch /tmp/emux_xvfb_restarted
  echo "emux-x11: Xvfb died rc=$RC - restarting once${NOSHEM:+ with $NOSHEM}" >&2
  [ -f /tmp/xvfb.log ] && mv -f /tmp/xvfb.log /tmp/xvfb.log.1 2>/dev/null
  kill_stale_x
  "$XVFB" :"$DN" -screen 0 "$RES" -listen tcp -ac -extension MIT-SHM -nolisten unix ${FBDIR_OPT:-} ${NOCURSOR_OPT:-} $NOSHEM >/tmp/xvfb.log 2>&1 &
  XPID=$!
  i=0
  while ! x_up && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
  wait $XPID
  RC=$?
fi
echo "emux-x11: X server (pid $XPID) exited rc=$RC - log tail:" >&2
tail -15 /tmp/xvfb.log >&2
exit $RC

