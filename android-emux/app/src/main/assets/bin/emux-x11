#!/bin/sh
# emux-x11 WM - start Xvfb (or Xorg under real root) + window manager.
#
# v0.1.28 REWRITE: this script runs INSIDE the distro environment (proot or
# chroot), where all absolute paths (/usr/bin/Xvfb, /usr/bin/xkbcomp, ...)
# resolve natively. Host-mode invocation (EMUX_ROOTFS still visible) re-execs
# through the bundled proot. The old host-side loader hacks could never work:
# at startup the X server execs /usr/bin/xkbcomp BY ABSOLUTE PATH through
# /bin/sh to compile its keymap - outside a chroot-equivalent that path does
# not exist and Xvfb dies with "Failed to activate virtual core keyboard"
# (verified). proot's execve/PT_INTERP path translation is exactly the fix.
WM="${1:-openbox}"
# v0.2.5 FIELD FIX: display number comes from the app (rotated to a free
# one; see DesktopService). Everything below (:0, 6000, X0 lock/socket)
# keys off DN/XP so a stale server on another display cannot block us.
DN="${3:-0}"
XP=$((6000 + DN))
# v0.1.101 MOBILE: Android passes the device geometry as $2
# (DesktopService.desktopGeometry(): phone 1280x720 landscape, tablet
# aspect-matched, long side capped at 1280). Manual runs and EMUX_X_RES
# keep the legacy 720x1280 portrait default.
RES="${2:-${EMUX_X_RES:-720x1280x24}}"

ROOT="${EMUX_ROOTFS:-${EMUX_ROOT:-}}"
if [ -n "$ROOT" ] && [ -d "$ROOT/lib" ]; then
  # host mode: re-exec inside proot
  NB="${EMUX_NATIVE_BRIDGE:-}"
  if [ -x "$NB/proot" ]; then
    echo "emux-x11: host mode - re-exec inside proot" >&2
    mkdir -p "$ROOT/tmp" 2>/dev/null
    LD_LIBRARY_PATH="$NB" HOME=/root PROOT_TMP_DIR="$ROOT/tmp" \
    PROOT_LOADER="$NB/loader" exec "$NB/proot" -0 -r "$ROOT" \
      -b /dev -b /proc -b /sys -w /root \
      /bin/sh -l -c "unset EMUX_ROOTFS EMUX_ROOT EMUX_NATIVE_BRIDGE; exec /usr/local/bin/emux-x11 $WM \"$RES\" $DN"
  fi
  echo "emux-x11: bundled proot missing at $NB/proot - tap Install to re-seed (or use root chroot mode)." >&2
  exit 1
fi

# ---------------- inside the distro (proot / chroot) ----------------
export HOME="${HOME:-/root}"
export DISPLAY=:$DN
export TMPDIR=/tmp
# v0.1.79: PATH sanity. A session that starts mid-dpkg-transaction sources
# /etc/profile while coreutils files are being swapped ("id: not found" in
# the v0.1.78 pane) and can inherit a garbled PATH; pin the distro dirs.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH
# v0.1.52 FIELD FIX: a leftover Xvfb/Xorg from an earlier desktop session
# still holds :0 and tcp/6000 — a fresh Xvfb then dies with EADDRINUSE and
# the Android pane waits for frames forever. Kill stale servers (proc scan:
# pkill/procps are not guaranteed in minimal images) and drop stale sockets.
# v0.1.54: also kill orphaned capture helpers (emux-capture / xwd) - they
# survive session stops and app deaths (proot tracees are detached, not
# killed) and keep tcp/7001 + X connections open, which made the NEXT desktop
# start die with "bind failed: EADDRINUSE" on the Android side.
# v0.1.80: factored into kill_stale_x() so EVERY launch attempt (first,
# retry, death-restart) re-sweeps and drops stale sockets - the v0.1.79
# field pane died with "Cannot establish any listening sockets" on a retry
# that only removed the lock file, not the stale X0 socket.
kill_stale_x() {
  # v0.2.13 FIELD FIX: FILES ONLY - no process killing from the guest
  # sweep, ever again. Thirteen rounds of evidence: on this ROM it cannot
  # reach foreign proot tracees (so it never cleaned anything useful),
  # and whenever it COULD reach something it murdered our own live
  # capture (v0.1.54-v0.2.7, rc=137) or, via the explicit previous-attempt
  # kill, our own SERVING X server mid-session (v0.2.12 field: preflight
  # ok on :0, then every grab "unable to open display" after attempt 3
  # killed attempt 2's live server). Host-side age-filtered kill at
  # session start covers healthy ROMs; adoption covers the rest.
  sleep 0.3
  mkdir -p /tmp/.X11-unix
  rm -f /tmp/.X$DN-lock /tmp/.X11-unix/X$DN 2>/dev/null
}
kill_stale_x
rm -f /tmp/emux_wm_launched /tmp/emux_xvfb_restarted /tmp/emux_x_up 2>/dev/null

# v0.1.82: SOCKET PROBES. X's "Cannot establish any listening sockets /
# server already running" is a GENERIC message that hides the real errno -
# it fires for a live orphan holder AND for bind() failures (proot socket
# translation, SELinux). These lines let the next field round tell them
# apart without guessing: directory state, kernel tcp tables (6000 =
# 0x1770), and live bind probes (124 = bind OK and blocked in listen).
probe_sockets() {
  : > /tmp/emux_probes 2>/dev/null
  pl() { echo "emux-x11: $1" >&2; echo "$1" >> /tmp/emux_probes 2>/dev/null; }
  pl "probe .X11-unix: $(ls -la /tmp/.X11-unix 2>&1 | tr '\n' ' ')"
  pl "probe tcp6000: $(grep -hi ':1770 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null | tr -s ' ' | cut -d' ' -f2,4,10 | tr '\n' ' ')"
  if command -v nc >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    timeout 1 nc -l "$XP" >/dev/null 2>&1
    pl "probe tcp-bind-$XP rc=$? (124=ok, other=failed)"
    timeout 1 nc -l 6001 >/dev/null 2>&1
    pl "probe tcp-bind-6001 rc=$? (124=ok, other=failed)"
    timeout 1 nc -l -U /tmp/.X11-unix/Xprobe >/dev/null 2>&1
    pl "probe unix-bind rc=$? (124=ok, other=failed)"
    rm -f /tmp/.X11-unix/Xprobe 2>/dev/null
  fi
  # v0.1.86: mirror into the pane-visible selfcheck file (chunked notes)
  cat /tmp/emux_probes >> /tmp/emux_selfcheck 2>/dev/null
}
# v0.1.99 PERF: probes are diagnostics, not gates - run them in the
# background so the launch path never pays their ~3 s; the clash branch
# still calls probe_sockets synchronously when it needs fresh numbers.
( probe_sockets ) >/dev/null 2>&1 &

# v0.1.78: xkbcomp preflight. The X server execs /usr/bin/xkbcomp BY ABSOLUTE
# PATH through /bin/sh while compiling its keymap; a ghost x11-xkb-utils (db
# installed, binary gone) makes Xvfb die with "Failed to activate virtual core
# keyboard" before any client connects - xvfb.log then names it, but the
# session is already dead. One [ -x ] test on a healthy system; a cheap cached
# install when the ghost struck.
if [ ! -x /usr/bin/xkbcomp ] && command -v apt-get >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    x11-xkb-utils >&2 || true
fi

# v0.1.79: id-independent guard - a session starting mid-transaction can hit
# a half-swapped coreutils ("id: not found" pane noise); fake-root is the
# normal case here, so default to 0 when id is momentarily unavailable.
if [ "$(id -u 2>/dev/null || echo 0)" = "0" ] && [ -x /usr/bin/Xorg ] && [ -n "$EMUX_USE_XORG" ]; then
  Xorg :"$DN" -config /etc/X11/emux-xorg.conf &
else
  XVFB=""
  for c in /usr/bin/Xvfb /usr/bin/Xephyr; do
    [ -x "$c" ] && { XVFB="$c"; break; }
  done
  if [ -z "$XVFB" ]; then
    # v0.1.47 multi-distro: install through whichever package manager the
    # active distro ships (apk on Alpine, apt on Debian/Ubuntu).
    echo "emux-x11: Xvfb missing - installing via the distro package manager (one time, needs network)" >&2
    if command -v apt-get >/dev/null 2>&1; then
      # v0.1.53 FIELD FIX: the bare `dpkg --configure -a || true` here could
      # never succeed on devices where proot's link(2) translation breaks
      # dpkg's status-old backup (EACCES/EEXIST, termux/proot#377) or where a
      # killed apt run left the journal dirty - so the install below died and
      # the desktop pane showed "X server exited (code 1)" with apt Hit: lines.
      # emux-apt-repair installs the link()->linkat() preload shim, cleans the
      # stale backup, quarantines an unrecoverable journal and fixes
      # half-installed packages first.
      if [ -x /usr/local/bin/emux-apt-repair ]; then
        emux-apt-repair >&2 || true
      else
        dpkg --configure -a >&2 || true
      fi
      # v0.1.94 PERF: skip apt-get update when list files are fresh (<6 h) -
      # on slow links this alone cost 30-60 s of desktop open time.
      if [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -mmin -360 2>/dev/null | head -1)" ]; then
        apt-get update >&2
      fi
      # v0.1.54 FIELD FIX ("X server exited code 1" on FIRST desktop open right
      # after an update): the app-start repair pass may still hold the dpkg
      # lock when the desktop cascade runs - apt then fails with "Could not
      # get lock" and Xvfb never gets installed. Retry a few times instead of
      # giving up on the first lock race.
      # v0.1.58 FIELD FIX (pane: "E: dpkg was interrupted ... apt install
      # failed (lock or mirror?) - retry"): apt reports "dpkg was interrupted"
      # whenever /var/lib/dpkg/updates/ is non-empty - which is ALSO true while
      # ANOTHER dpkg transaction is legitimately running (the app-start gap
      # install of the desktop stack takes minutes on slow links). The old
      # 4x5s retry loop raced that multi-minute install and always lost, then
      # gave up with Xvfb absent. Now: wait while a foreign apt/dpkg runs, and
      # heal the journal between retries when nothing is running.
      apt_busy() {
        for f in /proc/[0-9]*/cmdline; do
          c=$(tr "\0" " " < "$f" 2>/dev/null)
          case "$c" in *dpkg*|*apt-get*) return 0 ;; esac
        done
        return 1
      }
      heal_dpkg() {
        rm -f /var/lib/dpkg/status-old
        if ! dpkg --configure -a >&2; then
          mkdir -p /var/lib/dpkg/updates.emux-broken 2>/dev/null
          for f in /var/lib/dpkg/updates/*; do
            [ -e "$f" ] && mv "$f" /var/lib/dpkg/updates.emux-broken/ 2>/dev/null
          done
          rm -f /var/lib/dpkg/updates/* 2>/dev/null
          dpkg --configure -a >&2 || true
        fi
        # v0.1.78: purge ghost db entries between retries too - a retry loop
        # against a ghost (db installed, files gone) spins all 30 tries.
        ghost_purge
      }
      # v0.1.78: GHOST-PACKAGE PURGE. An interrupted transaction (or a killed
      # extraction) can leave a package "install ok installed" in the dpkg db
      # while its files are GONE. apt-get install then NO-OPs on it ("already
      # the newest version") and the cascade spins its retries against a
      # binary that can never appear - the v0.1.76/77 field pane showed exactly
      # that: the whole xvfb transaction aborted on the coreutils upgrade, so
      # /usr/bin/Xvfb never landed and the pane waited for frames forever.
      # Purging the db entry makes the next install really unpack the files.
      # KEEP IN SYNC with assets/bin/emux-apt-repair and
      # BootstrapManager.GHOST_PURGE_PAYLOAD (inlined twin).
      ghost_purge() {
        for pair in \
          "coreutils:/usr/bin/id" \
          "util-linux:/usr/bin/script" \
          "bash:/bin/bash" \
          "xvfb:/usr/bin/Xvfb" \
          "xserver-common:/etc/X11/Xsession" \
          "x11-xkb-utils:/usr/bin/xkbcomp" \
          "xfonts-base:/usr/share/fonts/X11/misc" \
          "x11-apps:/usr/bin/xwd" \
          "netpbm:/usr/bin/pnmtoplainpnm" \
          "netcat-openbsd:/bin/nc.openbsd" \
          "openbox:/usr/bin/openbox" \
          "xterm:/usr/bin/xterm" ; do
          gp=${pair%%:*}; gm=${pair#*:}
          if [ ! -e "$gm" ] && dpkg -s "$gp" 2>/dev/null | grep -q "install ok installed"; then
            echo "emux-x11: ghost package $gp (db says installed, $gm missing) - purging db entry" >&2
            dpkg --remove --force-all "$gp" >&2 || true
          fi
        done
      }
      if ! apt_busy && [ -x /usr/local/bin/emux-apt-repair ]; then
        emux-apt-repair >&2 || true
      fi
      ghost_purge
      # v0.1.62: SPLIT the cascade. CORE is what the X server itself needs;
      # everything else (WM + capture toolchain: xwd from x11-apps,
      # pnmtoplainpnm from netpbm, nc from netcat-openbsd) installs in the
      # BACKGROUND once X is up. Before, one multi-minute transaction gated
      # Xvfb startup: the pane sat in dpkg/apt output for minutes and the
      # control-plane wait expired ("touch input: X TCP not up yet").
      # v0.1.60 CRITICAL: "xkbcomp" is NOT a Debian/Ubuntu package name
      # (x11-xkb-utils is) - apt aborts the WHOLE transaction on one bad name.
      # v0.1.98 (field audit): the capture toolchain (xwd/xwdtopnm from
      # x11-apps, pnmtoplainpnm from netpbm, nc) moved INTO the synchronous
      # CORE install - installing it in the background after X started raced
      # the capture helper on slow devices (the "desktop running but
      # invisible" rounds). Only the WM half stays backgrounded now.
      CORE="coreutils xvfb x11-xkb-utils xkb-data xfonts-base x11-apps netpbm netcat-openbsd"
      REST="x11-xserver-utils openbox xterm"
      TRIES=0
      while [ "$TRIES" -lt 30 ]; do
        if apt_busy; then
          TRIES=$((TRIES + 1))
          echo "emux-x11: another apt/dpkg transaction is running - waiting ($TRIES/30)" >&2
          sleep 10
          continue
        fi
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
          $CORE >&2 && break
        TRIES=$((TRIES + 1))
        echo "emux-x11: apt install failed - healing dpkg and retrying ($TRIES/30)" >&2
        heal_dpkg
        sleep 2
      done
      # v0.1.61: settle pass (first-pass postinst failures under proot's statx
      # translation leave packages unpacked-but-unconfigured; a configure
      # retry completes them - sandbox-verified on the pinned noble image).
      i=0
      while [ "$i" -lt 2 ]; do
        dpkg --configure -a >&2 && break
        i=$((i + 1))
      done
      # v0.1.78 LAST RESORT: if the X server binary STILL is not on disk after
      # the retry loop (ghost db entry that survived healing, stale mirror
      # cache, ...), force the db entry out and reinstall exactly what the
      # server needs. Before this, a ghost xvfb meant "apt-get install xvfb"
      # no-opped forever and the session died with "no X server available".
      if [ ! -x /usr/bin/Xvfb ] && [ ! -x /usr/bin/Xephyr ]; then
        echo "emux-x11: X server still absent after retries - forced reinstall" >&2
        ghost_purge
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
          xvfb x11-xkb-utils xserver-common xfonts-base >&2 || true
        if [ ! -x /usr/bin/Xvfb ]; then
          DEBIAN_FRONTEND=noninteractive apt-get install -y --reinstall \
            --no-install-recommends xvfb x11-xkb-utils xserver-common xfonts-base >&2 || true
        fi
        i=0
        while [ "$i" -lt 2 ]; do
          dpkg --configure -a >&2 && break
          i=$((i + 1))
        done
      fi
      # v0.1.79: the REST install (WM + capture toolchain) NO LONGER starts
      # here - it moved to after the X server is up. A background dpkg
      # transaction swapping libc-bin/fonts/coreutils under a STARTING Xvfb
      # is exactly what killed the v0.1.78 field round (first launch landed
      # on a half-configured libc-bin: no ld.so.cache, Xvfb could not exec,
      # the 15 s window expired, and the retry died on -noshmem).
      APT_BRANCH=1
    elif command -v pacman >/dev/null 2>&1; then
      pacman -Sy --noconfirm --needed xorg-server-xvfb xorg-xkbcomp xkeyboard-config xorg-xwd netpbm openbox xterm >&2
    elif command -v dnf >/dev/null 2>&1; then
      dnf -y --skip-broken install xorg-x11-server-Xvfb xkbcomp xkeyboard-config xorg-x11-apps netpbm nmap-ncat openbox xterm >&2
    else
      apk add --no-cache xvfb xkbcomp xkeyboard-config xwd netpbm >&2
    fi
    [ -x /usr/bin/Xvfb ] && XVFB=/usr/bin/Xvfb
  fi
  if [ -z "$XVFB" ]; then
    echo "emux-x11: no X server available (apk add xvfb failed? see above)" >&2
    exit 1
  fi
  # -listen tcp : the Android-side X11Client talks X over loopback TCP :6000
  # -ac         : disable access control (loopback-only server)
  # v0.1.79 SETTLE WAIT: never start Xvfb into a running dpkg/apt transaction.
  # The v0.1.78 field pane proved the first launch landed mid-transaction
  # (dpkg.log: libc-bin half-configured = ld.so.cache gone; /etc/profile even
  # lost `id`): Xvfb could not exec, the old blind 15 s window expired, and
  # the retry then died on a flag noble's Xvfb no longer knows.
  # v0.1.94 PERF: cap the settle at 45 s (was 120). v0.1.99 PERF: with a
  # valid ld.so.cache the original reason for settling (execs failing mid
  # libc-bin swap) is gone, so the cap drops to 10 s; without cache keep 45.
  SETTLE_CAP=9
  [ -s /etc/ld.so.cache ] && SETTLE_CAP=2
  i=0
  while [ "$i" -lt "$SETTLE_CAP" ] && command -v apt_busy >/dev/null 2>&1 && apt_busy; do
    echo "emux-x11: dpkg/apt still running before X start - settling ($i/$SETTLE_CAP)" >&2
    [ "$i" = 0 ] && echo "emux-x11: note: waiting on background package transaction" >&2
    sleep 5; i=$((i + 1))
  done
  # v0.1.79: -noshmem was REMOVED from Xvfb (xorg-server 21.1, Ubuntu noble):
  # passing it = instant "Fatal server error: Unrecognized option". Probe the
  # flag once; on noble NOSHEM stays empty and shm failures are handled by
  # the server's own fallback (which is why upstream dropped the flag).
  NOSHEM=""
  if "$XVFB" -noshmem -version >/dev/null 2>&1; then NOSHEM="-noshmem"; fi
  # v0.1.84: TCP-ONLY FIRST ATTEMPT. The v0.1.83 pinned probe settled it:
  # hostbind tcp6000=true abs=true while the guest Xvfb dies with the generic
  # "server already running" fatal => the failure is GUEST-INTERNAL (proot
  # unix-socket translation / SELinux on the path+abstract binds), not an
  # orphan holder. -nolisten unix drops the unix transport entirely; every
  # client we run works over tcp (X11Client talks tcp:6000 by design; xwd /
  # xterm / openbox use Xlib, which falls back to tcp for DISPLAY=:0 when
  # the unix socket is unavailable).
  tcp_open() {
    if command -v nc >/dev/null 2>&1; then nc -z 127.0.0.1 "$XP" 2>/dev/null; return $?; fi
    if [ -x /bin/bash ]; then /bin/bash -c "exec 3<>/dev/tcp/127.0.0.1/$XP" 2>/dev/null; return $?; fi
    return 1
  }
  x_up() { [ -e /tmp/.X11-unix/X$DN ] || tcp_open; }
  # v0.2.16 FIELD FIX: socket presence is NOT a server. The v0.2.15 field
  # round adopted a "pre-existing" server whose sockets answered for a
  # couple of seconds (a dying zombie's half-closed listener), launched
  # ZERO Xvfbs, and the session then sat at "X server never came up (no
  # X0, tcp 6000 closed)" with xvfb.log absent. verify_x demands a REAL
  # X protocol handshake: xwd -root must succeed, bounded by a killer
  # subshell (timeout(1) is poison under this proot, see emux-capture).
  verify_x() {
    # v0.2.18 INSTRUMENTATION: say WHICH leg believes what, and dump the
    # raw kernel tcp table for the display port when the tcp leg passes.
    # Field v0.2.17: the connect-sweep said "silent" at :15, adoption
    # verified a real handshake at :16, and by :30 nothing existed and
    # xvfb.log was ABSENT - a ghost listener inside the first second.
    # The pane now carries the evidence to catch it red-handed.
    if [ -e /tmp/.X11-unix/X$DN ]; then
      echo "verify_x: leg=X0-file present" >&2
    elif tcp_open; then
      echo "verify_x: leg=tcp $XP answering; kernel tcp table:" >&2
      grep -i ":$(printf '%X' "$XP") " /proc/net/tcp /proc/net/tcp6 2>/dev/null | head -3 >&2
    else
      echo "verify_x: leg=none (nothing listening on $XP)" >&2
      return 1
    fi
    command -v xwd >/dev/null 2>&1 || { echo "verify_x: no xwd in PATH - trusting socket leg" >&2; return 0; }
    xwd -root -silent >/dev/null 2>&1 &
    VP=$!
    ( sleep 5; kill -9 "$VP" 2>/dev/null ) &
    VK=$!
    wait "$VP"; VR=$?
    kill "$VK" 2>/dev/null
    echo "verify_x: xwd handshake rc=$VR" >&2
    [ "$VR" = 0 ]
  }
  XTRY=0
  start_xvfb() { # rc: 0 up, 1 server died, 2 alive but not up yet
    # v0.1.88: keep THREE generations - attempt 1's log was being lost after
    # two rotations, and attempt 1 is where the truth lives.
    [ -f /tmp/xvfb.log.1 ] && mv -f /tmp/xvfb.log.1 /tmp/xvfb.log.2 2>/dev/null
    [ -f /tmp/xvfb.log ] && mv -f /tmp/xvfb.log /tmp/xvfb.log.1 2>/dev/null
    # v0.2.13: the explicit previous-attempt kill is GONE - it murdered the
    # only serving server mid-session (see kill_stale_x note). A live
    # previous attempt is now ADOPTED instead (below), never killed.
    # v0.1.80/81: sweep + drop stale sockets on EVERY attempt
    kill_stale_x
    XTRY=$((XTRY + 1))
    echo "emux-x11: Xvfb attempt $XTRY:$*" >&2
    ATTEMPT_FLAGS="$*"
    # v0.2.10 FIELD FIX: -extension MIT-SHM. Xvfb advertises MIT-SHM and xwd
    # then takes the shared-memory grab path - whose shmget/shmat syscalls
    # hang under proot's ptrace translation (field v0.2.9: preflight grab
    # succeeds, every real grab times out silently, "grab retry #10...").
    # With the extension disabled xwd can only use plain XGetImage, which
    # needs no shm syscalls at all. Our only clients are xwd/openbox.
    "$XVFB" :"$DN" -screen 0 "$RES" -listen tcp -ac -extension MIT-SHM "$@" >/tmp/xvfb.log 2>&1 &
    XPID=$!
    i=0
    GONE=0
    while [ "$i" -lt 450 ]; do
      x_up && return 0
      # v0.2.9 FIELD FIX: one kill -0 miss is NOT death. Under proot the
      # pid translation races right after fork - the field process table
      # showed attempt-3's Xvfb ALIVE and serving (pid with -listen tcp
      # -ac flags) while /tmp/emux_attempts logged rc=1 for all three
      # attempts: each was declared dead at i=0, the ladder launched a
      # duplicate, and the duplicate died for real on the first (alive)
      # server's sockets - "server already running" was us fighting
      # ourselves. Require three consecutive misses ~1 s apart.
      if kill -0 "$XPID" 2>/dev/null; then
        GONE=0
      else
        GONE=$((GONE + 1))
        [ "$GONE" -ge 3 ] && return 1
      fi
      sleep 0.3; i=$((i + 1))
    done
    return 2
  }
  # v0.1.97: tell the Android side (via a FILE - socket waits proved
  # unreliable as a gate on this device) the moment X is reachable.
  ( i=0
    while [ "$i" -lt 600 ]; do
      if verify_x; then
        echo "watcher: X verified up at $(date +%T) on :$DN" >&2
        : > /tmp/emux_x_up 2>/dev/null; break
      fi
      sleep 0.5; i=$((i + 1))
    done ) &
  # v0.2.13 FIELD FIX: ADOPT, DON'T FIGHT. If anything already answers on
  # this display - an unkillable zombie from a previous app life, or an
  # earlier attempt this session misreported as dead - it serves clients
  # perfectly (the capture preflight proved it in every field round),
  # while every NEW Xvfb we launch either dies on its sockets or gets
  # killed by our own next attempt. Launch zero servers in that case.
  if verify_x; then
    echo "emux-x11: adopting VERIFIED running X server on :$DN (tcp $XP)" >&2
    : > /tmp/emux_attempts 2>/dev/null
    echo "$(date +%s) adopted rc=0 flags=<pre-existing>" >> /tmp/emux_attempts 2>/dev/null
  else
  rc=0
  : > /tmp/emux_attempts 2>/dev/null
  # v0.1.86: PURE IPv4 TCP first. The v0.1.85 shim selftest proved guest
  # binds work for IPv4/unix-path/abstract (all errno 0), so X's failure is
  # X-specific: its dual-stack tcp listener tries AF_INET6 first (the host
  # probe and shim only tested IPv4) and its unix listener uses the odd-mode
  # .X11-unix dir. Both are sidestepped by -nolisten unix -nolisten inet6;
  # every client we run speaks IPv4 tcp (X11Client dials 127.0.0.1; Xlib
  # falls back from unix to tcp for DISPLAY=:0).
  # v0.1.88: "local" too - on some X builds -nolisten unix alone does not
  # disable the unix transport ("local" is the classic umbrella name).
  # v0.2.4 FIELD FIX: attempt 1 WITH the unix socket enabled. The v0.1.86
  # triple -nolisten made Xvfb tcp-only, and on the field device xwd then
  # died with "unable to open display ':0'" (emux_cap.err) even though
  # `nc -z 127.0.0.1 6000` succeeded and the server ran with -ac: on this
  # ROM/libX11 combo the tcp X HANDSHAKE is the broken path, while the
  # unix transport provably binds+connects inside the guest (probe
  # unix-bind rc=124=ok). With /tmp/.X11-unix/X0 present, every client
  # (xwd, wm, xterm) uses the transport that works. If the unix/inet6
  # listeners are what kills Xvfb on some other ROM, the ladder falls
  # through to the old tcp-only flags as attempt 2.
  start_xvfb || rc=$?
  echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  if [ "$rc" != 0 ]; then
    echo "emux-x11: plain attempt rc=$rc - falling back to tcp-only listener" >&2
    start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  fi
  if [ "$rc" = 2 ]; then
    # server alive, socket slow (first-run font scan under proot): give it
    # 60 s more INSTEAD of killing it - the v0.1.39 logic mistook slow for shm.
    echo "emux-x11: Xvfb alive but not up in 45 s - waiting 60 s more" >&2
    i=0
    while [ "$i" -lt 600 ] && ! x_up; do sleep 0.1; i=$((i + 1)); done
  elif [ "$rc" = 1 ]; then
    echo "emux-x11: Xvfb died on first start - previous log kept at /tmp/xvfb.log.1:" >&2
    tail -5 /tmp/xvfb.log.1 >&2 2>/dev/null
    if grep -qi "shm" /tmp/xvfb.log.1 2>/dev/null && [ -n "$NOSHEM" ]; then
      echo "emux-x11: shm failure in log - retrying with $NOSHEM" >&2
      start_xvfb -nolisten unix $NOSHEM || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    else
      echo "emux-x11: retrying with tcp (all families, unix off)" >&2
      start_xvfb -nolisten unix -nolisten local || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
    # v0.1.80: if THAT also died on a socket clash, sweep once more, 3rd shot
    if [ "$rc" = 1 ] && grep -qi "listening sockets" /tmp/xvfb.log 2>/dev/null; then
      echo "emux-x11: socket clash persists - sweeping again, 3rd attempt" >&2
      probe_sockets
      kill_stale_x
      start_xvfb || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  fi
  # v0.2.6 FIELD FIX: WALK AWAY from occupied sockets. The field ROM hides
  # other processes' cmdlines, so the host pid-scan kill has silently
  # no-oped for five versions, and guest sweeps cannot signal foreign
  # proot tracees - zombie Xvfb processes from previous app lives keep
  # their unix/abstract/tcp sockets forever ("server already running",
  # every ladder attempt rc=1, even on a display the host probe called
  # free one second earlier). Instead of fighting: rotate to the next
  # display number and run the ladder there, up to 3 rotations.
  ROT=0
  while ! x_up && [ "$ROT" -lt 3 ]; do
    DN=$((DN + 1)); XP=$((6000 + DN)); ROT=$((ROT + 1))
    echo "emux-x11: sockets occupied on :$((DN - 1)) - rotating to :$DN (rot $ROT/3)" >&2
    kill_stale_x
    rc=0
    start_xvfb || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    if [ "$rc" = 1 ]; then
      start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  done
  fi
  # v0.2.16: adoption (or a ladder) can still end up believing in a server
  # that is gone. Verify with a real handshake; if nothing verifies, rotate
  # the display and LAUNCH for real instead of waiting on a ghost.
  if ! verify_x; then
    DN=$((DN + 1)); XP=$((6000 + DN))
    echo "emux-x11: no verifiable X server on :$((DN - 1)) - rotating to :$DN and launching" >&2
    kill_stale_x
    rc=0
    start_xvfb || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    if [ "$rc" = 1 ]; then
      start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
      echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
    fi
  fi
  # v0.2.6: publish the display this session ACTUALLY runs on; emux-capture
  # and the Android control plane read it instead of assuming :0/$2.
  echo "$DN" > /tmp/emux_display_num 2>/dev/null
  # v0.2.13: a tcp-only server (no unix socket) is NOT reachable as ":N"
  # on this libX11 stack - it does not fall back to tcp. Export the tcp
  # form so openbox/xwd connect first try.
  if [ -e /tmp/.X11-unix/X$DN ]; then
    export DISPLAY=:$DN
  else
    export DISPLAY="127.0.0.1:$DN"
    echo "emux-x11: no unix socket on :$DN - DISPLAY=$DISPLAY (tcp form)" >&2
  fi
  echo "emux-x11: session display $DISPLAY (tcp $XP)" >&2
fi
# v0.1.79: REST (WM + capture toolchain) installs NOW that X is up - never
# under a starting server (see APT_BRANCH note above). When it lands, start
# the WM if none runs yet.
if x_up && [ "$APT_BRANCH" = 1 ]; then
  (
    TRIES=0
    while [ "$TRIES" -lt 30 ]; do
      if apt_busy; then TRIES=$((TRIES + 1)); sleep 10; continue; fi
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        $REST >&2 && break
      TRIES=$((TRIES + 1)); heal_dpkg; sleep 2
    done
    i=0
    while [ "$i" -lt 2 ]; do dpkg --configure -a >&2 && break; i=$((i + 1)); done
    sleep 1
    if [ ! -e /tmp/emux_wm_launched ]; then
      for c in "/usr/bin/$WM" /usr/bin/openbox; do
        if [ -x "$c" ]; then
          "$c" >/tmp/wm.log 2>&1 &
          touch /tmp/emux_wm_launched
          break
        fi
      done
      # v0.2.14: a working desktop with no windows is a pure-black void
      # (field: "for a moment there was a black desktop with nothing") -
      # indistinguishable from a broken pipeline. Open one xterm so the
      # session is visibly alive and input-testable.
      if [ -x /usr/bin/xterm ] && [ ! -e /tmp/emux_xterm_launched ]; then
        /usr/bin/xterm -geometry 96x28+60+40 >/tmp/xterm.log 2>&1 &
        touch /tmp/emux_xterm_launched
      fi
    fi
  ) >/dev/null 2>&1 &
fi
[ -n "$XPID" ] || XPID=$!

# v0.2.18 FIELD FIX: self-heal a vanished adoption. Field v0.2.17: the
# session verified+adopted a ghost (dying zombie / first-second listener),
# launched zero Xvfbs, and ended here server-less. Instead of giving up:
# rotate the display (nothing holds the next one) and launch for real.
if ! verify_x; then
  DN=$((DN + 1)); XP=$((6000 + DN))
  echo "emux-x11: adopted server vanished - rotating to :$DN and launching now" >&2
  kill_stale_x
  rc=0
  start_xvfb || rc=$?
  echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  if [ "$rc" = 1 ]; then
    start_xvfb -nolisten unix -nolisten local -nolisten inet6 || rc=$?
    echo "$(date +%s) attempt $XTRY rc=$rc flags=$ATTEMPT_FLAGS" >> /tmp/emux_attempts 2>/dev/null
  fi
  echo "$DN" > /tmp/emux_display_num 2>/dev/null
  if [ -e /tmp/.X11-unix/X$DN ]; then export DISPLAY=:$DN; else export DISPLAY="127.0.0.1:$DN"; fi
  echo "emux-x11: session display now $DISPLAY (tcp $XP)" >&2
fi
# fail loudly with the captured log
if ! x_up; then
  echo "emux-x11: X server never came up (no X$DN, tcp $XP closed) - log follows (previous attempt: /tmp/xvfb.log.1):" >&2
  tail -20 /tmp/xvfb.log >&2
  exit 1
fi

# window manager; fall back through installed WMs to xterm so SOMETHING draws
run_wm() {
  for c in "/usr/bin/$1" "/usr/local/bin/$1" "/bin/$1"; do
    [ -x "$c" ] && { "$c" >/tmp/wm.log 2>&1 & touch /tmp/emux_wm_launched; return 0; }
  done
  return 1
}
run_wm "$WM" || run_wm openbox || run_wm twm || run_wm icewm || {
  if [ -x /usr/bin/xterm ]; then
    /usr/bin/xterm -e /bin/sh -l >/tmp/wm.log 2>&1 &
    touch /tmp/emux_wm_launched /tmp/emux_xterm_launched
  else
    echo "emux-x11: no window manager found ($WM/openbox/twm/icewm) and no xterm - root window will be blank. Install one with the distro package manager (apk add openbox / apt-get install openbox / pacman -S openbox / dnf install openbox)" >&2
  fi
}
# v0.1.100 FIX (blank desktop even when frames flow): Openbox alone
# draws a bare root window — no icons, no taskbar, no open window —
# so a perfectly working frame stream still reads as "no visual
# interface". Launch one xterm once the WM is up, so SOMETHING visible
# is on screen. The fallback branch above already launched xterm and
# touched emux_xterm_launched, so this never launches a second one.
if [ -e /tmp/emux_wm_launched ] && [ ! -e /tmp/emux_xterm_launched ] && [ -x /usr/bin/xterm ]; then
  /usr/bin/xterm >/tmp/xterm.log 2>&1 &
  touch /tmp/emux_xterm_launched
fi
# v0.1.43: never exit silently — the Android side paints this on the desktop
# pane, so a dying X server now names its own reason in the field.
wait $XPID
RC=$?
# v0.1.62: if Xvfb dies mid-session (shm SIGBUS class), restart ONCE with
# -noshmem instead of ending the session and orphaning the pane.
if [ "$RC" != 0 ] && [ ! -e /tmp/emux_xvfb_restarted ]; then
  touch /tmp/emux_xvfb_restarted
  echo "emux-x11: Xvfb died rc=$RC - restarting once${NOSHEM:+ with $NOSHEM}" >&2
  [ -f /tmp/xvfb.log ] && mv -f /tmp/xvfb.log /tmp/xvfb.log.1 2>/dev/null
  kill_stale_x
  "$XVFB" :"$DN" -screen 0 "$RES" -listen tcp -ac -extension MIT-SHM -nolisten unix $NOSHEM >/tmp/xvfb.log 2>&1 &
  XPID=$!
  i=0
  while ! x_up && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
  wait $XPID
  RC=$?
fi
echo "emux-x11: X server (pid $XPID) exited rc=$RC - log tail:" >&2
tail -15 /tmp/xvfb.log >&2
exit $RC
