#!/bin/sh
# emux-apt-repair - make dpkg/apt usable again inside the distro (v0.1.53).
#
# Runs INSIDE proot/chroot as fake root. Fixes the two field failures that
# brick every Debian/Ubuntu install on affected devices:
#
#  1) "dpkg: error: error creating new backup file
#      '/var/lib/dpkg/status-old': Permission denied" (or "File exists").
#     dpkg backs up its db with unlink(status-old)+link(status,status-old);
#     under the bundled proot the legacy link(2) translation returns bogus
#     errnos on several Android kernels (termux/proot#377: EEXIST on 3.4,
#     EACCES on the v0.1.52 field device) while linkat(2) is fine. The
#     libemux-linkfix.so LD_PRELOAD shim (assets/linkfix/<abi>) redefines
#     link() as linkat(); this script registers it in /etc/ld.so.preload
#     (honoured by glibc AND musl) and removes a stale status-old so the
#     next backup starts clean.
#
#  2) "E: dpkg was interrupted, you must manually run 'dpkg --configure -a'"
#     left behind by an apt run the user/app killed mid-transaction (or by
#     an interrupted first bootstrap install). If configure -a still fails
#     (half-applied journal on a partial tree), the pending journal is
#     quarantined into updates.emux-broken/ and configure re-run - the
#     standard rescue for an unrecoverable dpkg journal.
#
# Finally it reinstalls the base packages an interrupted transaction or a
# killed extraction tends to lose (coreutils = tty/groups/..., util-linux =
# script(1) = the PTY engine, bash), which is what produced the field
# symptoms "bash: groups: command not found" and the missing PTY wrapper.
#
# Idempotent; safe to run on a healthy system (no-ops). Exit 0 always -
# callers treat this as best-effort hygiene.

SHIM=/usr/local/lib/emux/libemux-linkfix.so
if [ -f "$SHIM" ]; then
    mkdir -p /etc 2>/dev/null
    if [ -r /etc/ld.so.preload ]; then
        grep -qsx "$SHIM" /etc/ld.so.preload || echo "$SHIM" >>/etc/ld.so.preload
    else
        echo "$SHIM" >/etc/ld.so.preload
    fi
fi

[ -d /var/lib/dpkg ] || exit 0
export DEBIAN_FRONTEND=noninteractive
# v0.1.94 PERF (twin of the inline payload): linker cache first - ~1 s here
# saves every later exec from crawling lib paths without /etc/ld.so.cache.
ldconfig >/dev/null 2>&1 || true

rm -f /var/lib/dpkg/status-old
if ! dpkg --configure -a >&2; then
    echo "emux-apt-repair: configure -a failed - quarantining dpkg journal" >&2
    mkdir -p /var/lib/dpkg/updates.emux-broken 2>/dev/null
    for f in /var/lib/dpkg/updates/*; do
        [ -e "$f" ] && mv "$f" /var/lib/dpkg/updates.emux-broken/ 2>/dev/null
    done
    rm -f /var/lib/dpkg/status-old
    dpkg --configure -a >&2 || true
fi

# half-installed packages (interrupted transactions / partial extraction)
apt-get install -y -f --no-install-recommends >&2 || true

# v0.1.78: GHOST-PACKAGE PURGE (keep in sync with emux-x11 ghost_purge() and
# BootstrapManager.GHOST_PURGE_PAYLOAD). An interrupted transaction can leave
# a package "install ok installed" in the dpkg db while its files are GONE;
# apt-get install then no-ops on it ("already the newest version") and the
# desktop cascade waits forever for a binary that can never appear (the
# v0.1.76/77 field pane: xvfb transaction aborted, /usr/bin/Xvfb absent).
# Purging the db entry makes the next install really unpack the files.
# NOTE: v0.1.77 shipped this purge ONLY in the app-start inline payload; the
# desktop cascade calls THIS helper, so ghosts survived exactly where the
# desktop needed them gone.
for pair in \
    "coreutils:/usr/bin/id" \
    "util-linux:/usr/bin/script" \
    "bash:/bin/bash" \
    "xvfb:/usr/bin/Xvfb" \
    "xserver-common:/etc/X11/Xsession" \
    "x11-xkb-utils:/usr/bin/xkbcomp" \
    "xfonts-base:/usr/share/fonts/X11/misc" \
    "x11-apps:/usr/bin/xwd" \
    "netpbm:/usr/bin/pnmtoplainpnm" \
    "netcat-openbsd:/bin/nc.openbsd" \
    "openbox:/usr/bin/openbox" \
    "xterm:/usr/bin/xterm" ; do
    gp=${pair%%:*}; gm=${pair#*:}
    if [ ! -e "$gm" ] && dpkg -s "$gp" 2>/dev/null | grep -q "install ok installed"; then
        echo "emux-apt-repair: ghost package $gp (db says installed, $gm missing) - purging db entry" >&2
        dpkg --remove --force-all "$gp" >&2 || true
    fi
done

apt-get install -y --no-install-recommends coreutils util-linux bash >&2 || true

# v0.1.61: settle pass - a first-pass postinst can fail under proot's statx
# translation (libpaper1/ucf case); a retry of configure -a always completes.
i=0
while [ "$i" -lt 2 ]; do
    dpkg --configure -a >&2 && break
    i=$((i + 1))
done

# v0.1.78: twin of the inline payload's selfcheck (kept identical to
# BootstrapManager.APT_SELFCHECK_PAYLOAD) so a repair run launched from the
# desktop cascade refreshes /tmp/emux_selfcheck too - the pane paints it.
EMUX_LINKFIX_SELFTEST=1 LD_PRELOAD=/usr/local/lib/emux/libemux-linkfix.so /bin/true 2>/dev/null
cat /tmp/emux_shimtest 2>/dev/null
{ echo "== emux dpkg selfcheck ==";
  cat /tmp/emux_shimtest 2>/dev/null;
  ls -l /usr/local/lib/emux/ 2>&1;
  cat /etc/ld.so.preload 2>&1;
  if grep -q libemux-linkfix /proc/self/maps; then echo SHIM_LOADED; else echo SHIM_NOT_LOADED; fi;
  grep -a -o 'emux-linkfix-v[0-9]*' /usr/local/lib/emux/libemux-linkfix.so 2>/dev/null | head -1;
  rm -f /var/lib/dpkg/status-old;
  if ! command -v ln >/dev/null 2>&1; then echo LINK_UNTESTED_NO_LN;
  elif ln /var/lib/dpkg/status /var/lib/dpkg/status-old 2>/tmp/link_err; then echo LINK_OK;
  else echo LINK_FAIL:; echo LINKERR:; cat /tmp/link_err; fi;
  rm -f /var/lib/dpkg/status-old;
  stat -c 'dpkgdir u=%u m=%a' /var/lib/dpkg 2>&1;
  stat -c 'status u=%u m=%a' /var/lib/dpkg/status 2>&1;
  cat /tmp/emux_dbswap 2>/dev/null;
  id -u; } > /tmp/emux_selfcheck 2>&1
cat /tmp/emux_selfcheck >&2

mkdir -p /var/lib 2>/dev/null
date +%s >/var/lib/emux-repair.stamp 2>/dev/null
echo "emux-apt-repair: done" >&2
exit 0
