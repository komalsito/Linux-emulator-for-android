<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v0.2.106: desktop session. "auto" = whatever full desktop is
         installed in the active distro (MATE > Xfce > LXQt > LXDE > GNOME),
         else the seeded Openbox desktop. Stored under the NEW key
         "desktop_session": the old "wm" key holds a persisted "openbox" on
         every install that ever opened Settings, which silently overrode the
         auto-detection (field: MATE installed, desktop still Openbox). -->
    <string-array name="wm_entries">
        <item>Automatic (installed desktop)</item>
        <item>MATE</item>
        <item>Xfce</item>
        <item>LXQt</item>
        <item>Openbox (lightweight)</item>
    </string-array>
    <string-array name="wm_values">
        <item>auto</item>
        <item>mate-session</item>
        <item>startxfce4</item>
        <item>startlxqt</item>
        <item>openbox</item>
    </string-array>

    <!-- v0.1.47: installable distributions (values MUST match DistroCatalog ids) -->
    <string-array name="distro_entries">
        <item>Alpine 3.20 — tiny &amp; fast (~4 MB, apk)</item>
        <item>Debian 12 bookworm — full-fledged (~40 MB, apt)</item>
        <item>Ubuntu 24.04 LTS — most software (~61 MB, apt)</item>
        <item>Arch Linux ARM — rolling release, AUR-style breadth (~138 MB, pacman)</item>
        <item>Fedora 40 — bleeding-edge developer distro (~30 MB, dnf)</item>
    </string-array>
    <!-- v0.2.79: capture quality = the LONG SIDE of the X screen in pixels.
         The X screen size IS the capture size (GetImage returns the server's own
         pixels), and one refresh costs W*H*2 bytes over a pipe the app measures
         at connect time - so the frame rate scales inversely with the SQUARE of
         this number. The multipliers below are that ratio, and the pane badge
         ("LIVE n.n fps  WxH  nKB/s  nms/refresh") shows what the device actually
         achieves, which is the only number worth trusting. -->
    <!-- v0.2.108: resolution is no longer capped at 1280. Damage bands come
         from the memory-mapped -fbdir framebuffer, so the screen can match the
         device. "native2x" renders at the device's own pixels with the guest
         UI scaled 2x (GDK_SCALE / Xft.dpi / MATE window scaling): the same
         layout as 1280, twice as sharp. -->
    <string-array name="capture_quality_entries">
        <item>Retina — device resolution, UI 2× (sharpest; same size as 1280)</item>
        <item>Native — device resolution, UI 1× (most workspace, small text)</item>
        <item>Full HD — 1920 px</item>
        <item>Sharp — 1280 px (previous default)</item>
        <item>Balanced — 960 px</item>
        <item>Fast — 720 px</item>
        <item>Smooth — 540 px (the desktop gets small)</item>
    </string-array>
    <string-array name="capture_quality_values">
        <item>native2x</item>
        <item>native</item>
        <item>1920</item>
        <item>1280</item>
        <item>960</item>
        <item>720</item>
        <item>540</item>
    </string-array>

    <!-- v0.2.85: mouse/trackpad wheel scale. One wheel notch or trackpad
         flick emits this many X scroll clicks. Trackpads report fractional
         AXIS_VSCROLL, so the view accumulates a per-axis remainder and emits
         one click per whole notch times this factor. -->
    <string-array name="mouse_scroll_scale_entries">
        <item>Precise — 1 line per notch</item>
        <item>Normal — 3 lines (default)</item>
        <item>Fast — 5 lines</item>
        <item>Very fast — 9 lines</item>
    </string-array>
    <string-array name="mouse_scroll_scale_values">
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>9</item>
    </string-array>

    <string-array name="distro_values">
        <item>alpine</item>
        <item>debian</item>
        <item>ubuntu</item>
        <item>arch</item>
        <item>fedora</item>
    </string-array>
</resources>
