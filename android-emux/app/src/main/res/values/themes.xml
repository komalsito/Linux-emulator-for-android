<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="emux_bg">#101216</color>
    <color name="emux_surface">#16191D</color>
    <color name="emux_accent">#5AA7FF</color>
    <color name="emux_text">#E8E8E8</color>
    <color name="emux_muted">#8A93A0</color>

    <style name="EmuX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/emux_accent</item>
        <item name="android:windowBackground">@color/emux_bg</item>
        <item name="android:statusBarColor">@color/emux_bg</item>
        <item name="android:navigationBarColor">@color/emux_bg</item>
    </style>

    <style name="EmuX.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="EmuX.Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">?android:selectableItemBackground</item>
    </style>
</resources>
