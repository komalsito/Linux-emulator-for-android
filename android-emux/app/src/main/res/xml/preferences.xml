<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- v0.1.47: the ACTIVE distro. Installs are explicit: picking a distro
         that is not on disk shows an Install prompt on the main screen. -->
    <ListPreference
        app:key="distro"
        app:title="@string/pref_distro_select_title"
        app:summary="@string/pref_distro_select_summary"
        app:entries="@array/distro_entries"
        app:entryValues="@array/distro_values"
        app:defaultValue="alpine" />

    <ListPreference
        app:key="wm"
        app:title="@string/pref_wm_title"
        app:summary="Openbox is installed with the desktop components; Xfce4/LXDE/i3 need their packages installed inside the Linux environment first (apt install xfce4 / lxde / i3). Any choice falls back to Openbox, then xterm."
        app:entries="@array/wm_entries"
        app:entryValues="@array/wm_values"
        app:defaultValue="openbox"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:key="root_accel"
        app:title="@string/pref_root_mode_title"
        app:summary="@string/pref_root_mode_summary"
        app:defaultValue="true" />

    <SwitchPreferenceCompat
        app:key="keepawake_burst"
        app:title="@string/pref_keepawake_title"
        app:summary="@string/pref_keepawake_summary"
        app:defaultValue="true" />

    <!-- v0.1.28: when enabled (default), bootstrap also installs the X11
         desktop stack via apk (xvfb, xkbcomp, xkeyboard-config, openbox,
         xterm, xwd, xhost, netpbm — ~25 MB one-time). Disable on slow
         connections; the terminal works either way. -->
    <SwitchPreferenceCompat
        app:key="desktop_components"
        app:title="@string/pref_desktop_components_title"
        app:summary="@string/pref_desktop_components_summary"
        app:defaultValue="true" />

    <!-- v0.1.53: manual escape hatch for the field dpkg failures
         (interrupted journal / status-old backup EACCES). Runs the same
         repair as the app-start pass, unconditionally. -->
    <Preference
        app:key="repair_apt"
        app:title="@string/pref_repair_title"
        app:summary="@string/pref_repair_summary" />

    <!-- v0.2.79: the frame rate the user actually gets is bytes-per-frame
         divided by a pipe we can only measure, not widen. This is the one knob
         that changes bytes-per-frame. Applied when the desktop next starts (the
         X screen cannot be resized mid-session); "Restart desktop now" does it
         immediately. -->
    <ListPreference
        app:key="capture_quality"
        app:title="Desktop capture quality (frame rate)"
        app:summary="Lower resolution = fewer bytes per frame = a higher frame rate, at the cost of softer text. The desktop pane shows the live rate (LIVE n.n fps, size, KB/s, ms per refresh) so you can tune it against your own device. Applies when the desktop next starts."
        app:entries="@array/capture_quality_entries"
        app:entryValues="@array/capture_quality_values"
        app:defaultValue="1280"
        app:useSimpleSummaryProvider="true" />

    <Preference
        app:key="restart_desktop"
        app:title="Restart desktop now"
        app:summary="Applies the capture quality immediately. Restarting ends the X session, so open windows are lost - the Linux terminal is not affected." />

    <EditTextPreference
        app:key="mirror"
        app:title="@string/pref_distro_title"
        app:summary="Alpine: mirror base URL. Any distro: paste a full .tar.gz/.tar.xz rootfs URL to use a self-hosted image."
        app:defaultValue="https://dlcdn.alpinelinux.org/alpine/v" />
</PreferenceScreen>
