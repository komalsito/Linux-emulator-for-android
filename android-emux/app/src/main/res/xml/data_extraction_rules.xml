<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup rules; mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="linuxroot" />
        <exclude domain="file" path="usr" />
        <exclude domain="file" path="native-bridge" />
        <exclude domain="file" path="bin" />
        <exclude domain="file" path="log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="linuxroot" />
        <exclude domain="file" path="usr" />
    </device-transfer>
</data-extraction-rules>
