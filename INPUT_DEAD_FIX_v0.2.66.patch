@@ -237,6 +237,17 @@ start_furniture() {
 seed_desktop_config() {
   mkdir -p "$HOME/.local/share/applications" "$HOME/Desktop" \
     "$HOME/.config/tint2" "$HOME/.config/openbox" "$HOME/.config/pcmanfm/default" 2>/dev/null
+  # v0.2.66 FIX (input-dead audit): on a phone, opening things must not depend
+  # on click timing. pcmanfm/libfm activate desktop items on a DOUBLE click by
+  # default; double-tap now reaches X as a real double-click, but libfm also
+  # offers single-click-to-open, which is the friendlier contract for touch.
+  # Only seed it when the user has no opinion yet - never overwrite a choice.
+  mkdir -p "$HOME/.config/libfm" 2>/dev/null
+  if [ ! -e "$HOME/.config/libfm/libfm.conf" ]; then
+    printf '[config]\nsingle_click=1\n' > "$HOME/.config/libfm/libfm.conf" 2>/dev/null
+  elif ! grep -q '^single_click=' "$HOME/.config/libfm/libfm.conf" 2>/dev/null; then
+    printf 'single_click=1\n' >> "$HOME/.config/libfm/libfm.conf" 2>/dev/null
+  fi
   # --- .desktop launchers (only for installed apps) ---
   APPS=""
   if [ -x /usr/bin/xterm ]; then
@@ -1223,15 +1234,29 @@ else
       # v0.2.45: previously this branch installed NO desktop furniture at
